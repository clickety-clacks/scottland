#!/usr/bin/env python3
"""Choose the configured Omarchy day/night theme for Scottland's solar preference.

A current theme whose light/dark mode already matches is never replaced.
"""
import configparser
import json
import os
from pathlib import Path
import subprocess
import sys
import time

state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home()/".local/state")))
mode_file = Path(os.environ.get("SCOTTLAND_SOLAR_MODE_FILE", str(state/"scottland"/(os.environ.get("WAYLAND_DISPLAY", "wayland")+".solar-mode"))))
current = Path(os.environ.get("SCOTTLAND_OMARCHY_CURRENT", str(state/"omarchy/current")))
config_file = Path(os.environ.get("SCOTTLAND_OMARCHY_SOLAR_FILE",
                                  str(Path(os.environ.get("XDG_CONFIG_HOME", Path.home()/".config"))/"scottland/omarchy-solar.ini")))
solar_file = Path(os.environ.get("SCOTTLAND_SOLAR_FILE",
                                str(Path(os.environ.get("XDG_CONFIG_HOME", Path.home()/".config"))/"scottland/solar.ini")))
# Producer polls every ten seconds. Old modes must not replay after it stops.
MAX_MODE_AGE = 30


def live_producer(desired):
    record = mode_file.with_name(mode_file.name + ".producer")
    age = time.time() - record.stat().st_mtime
    if age < 0 or age > MAX_MODE_AGE:
        return False
    identity = json.loads(record.read_text())
    pid = identity.get("pid")
    if type(pid) is not int or pid <= 0:
        return False
    process = Path("/proc")/str(pid)
    fields = (process/"stat").read_text().rsplit(")", 1)[1].split()
    return (process.stat().st_uid == os.getuid() and fields[0] not in ("Z", "X", "x")
            and fields[19] == identity.get("start")
            and Path("/proc/sys/kernel/random/boot_id").read_text().strip() == identity.get("boot")
            and identity.get("mode") == desired
            and identity.get("config_mtime_ns") == solar_file.stat().st_mtime_ns)


def themes():
    cfg = configparser.ConfigParser()
    cfg.read(config_file)
    section = cfg["themes"] if cfg.has_section("themes") else {}
    return {"light": section.get("day", "watercolor-dream-light"),
            "dark": section.get("night", "watercolor-dream-dark")}


def run_once():
    cfg = configparser.ConfigParser()
    try:
        cfg.read(solar_file)
        if not cfg.getboolean("solar", "enabled", fallback=False):
            return "off"
        age = time.time() - mode_file.stat().st_mtime
        if age < 0 or age > MAX_MODE_AGE or mode_file.stat().st_mtime_ns < solar_file.stat().st_mtime_ns:
            return "off"
        desired = mode_file.read_text().strip()
        if not live_producer(desired):
            return "off"
    except (OSError, ValueError, IndexError, AttributeError, configparser.Error):
        return "off"
    if desired not in ("light", "dark"):
        return "off"
    colors = current/"theme/colors.toml"
    result = subprocess.run(["omarchy-theme-color", "--file", str(colors), "mode"],
                            capture_output=True, text=True)
    if result.returncode == 0 and result.stdout.strip().lower() == desired:
        return "kept"
    target = themes()[desired]
    subprocess.run(["omarchy", "theme", "set", target], check=True)
    return target


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "once":
        print(run_once())
    else:
        while True:
            try:
                run_once()
            except (OSError, subprocess.CalledProcessError) as error:
                print(f"scottland-omarchy-solar-theme: {error}", file=sys.stderr)
            time.sleep(10)
