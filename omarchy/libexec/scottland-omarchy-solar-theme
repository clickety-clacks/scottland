#!/usr/bin/env python3
"""Consume each core Sunlight transition once; never poll for theme mismatch."""
import configparser
import ctypes
import fcntl
import hashlib
import json
import os
from pathlib import Path
import select
import stat
import struct
import subprocess
import sys
import time

state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home()/".local/state")))/"scottland"
transition_file = Path(os.environ.get("SCOTTLAND_SOLAR_TRANSITION_FILE", str(state/"solar-transition.json")))
consumer_lock_file = state/"solar-transition-consumer.lock"
memory_file = state/"omarchy-theme-memory.json"
# Omarchy publishes here even when Scottland uses a custom XDG_STATE_HOME.
current_theme_file = Path.home()/".local/state/omarchy/current/theme.name"
current_wallpaper_file = current_theme_file.parent/"background"
config_file = Path(os.environ.get("SCOTTLAND_OMARCHY_SOLAR_FILE",
                                  str(Path(os.environ.get("XDG_CONFIG_HOME", Path.home()/".config"))/"scottland/omarchy-solar.ini")))
solar_file = Path(os.environ.get("SCOTTLAND_SOLAR_FILE",
                                str(Path(os.environ.get("XDG_CONFIG_HOME", Path.home()/".config"))/"scottland/solar.ini")))


def solar_enabled():
    cfg = configparser.ConfigParser()
    try:
        cfg.read(solar_file)
        default = os.environ.get("SCOTTLAND_SOLAR_OPT_IN") != "1"
        return cfg.getboolean("solar", "enabled", fallback=default)
    except (OSError, ValueError, configparser.Error):
        return False


def themes():
    cfg = configparser.ConfigParser()
    cfg.read(config_file)
    section = cfg["themes"] if cfg.has_section("themes") else {}
    return {"light": section.get("day", "watercolor-dream-light"),
            "dark": section.get("night", "watercolor-dream-dark")}


def remembered_theme_available(name):
    """Use the same user/built-in theme directories as omarchy-theme-set."""
    if not name or name.startswith(".") or "/" in name or "\n" in name:
        return False
    roots = (Path.home()/".config/omarchy/themes",
             Path(os.environ.get("OMARCHY_PATH", Path.home()/".local/share/omarchy"))/"themes")
    for root in roots:
        try:
            if stat.S_ISDIR((root/name).stat().st_mode):
                return True
        except FileNotFoundError:
            pass
    return False


def transition_lock():
    transition_file.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor = os.open(transition_file.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    fcntl.flock(descriptor, fcntl.LOCK_EX)
    return descriptor


def consumer_lock():
    """Serialize Omarchy consumers across concurrent Scottland sessions."""
    consumer_lock_file.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor = os.open(consumer_lock_file, os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(descriptor, fcntl.LOCK_EX)
    return descriptor


def read_transition():
    try:
        record = json.loads(transition_file.read_text())
    except FileNotFoundError:
        return None
    if not isinstance(record, dict) or record.get("schema") != 1:
        raise ValueError(f"unsupported Sunlight transition record at {transition_file}")
    return record


def _atomic_write(record, path=None):
    if path is None:
        path = transition_file
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_name(path.name+"."+str(os.getpid())+".tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as target:
            target.write(json.dumps(record, sort_keys=True)+"\n")
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        temporary.unlink(missing_ok=True)


def current_theme():
    """Read Omarchy's published selection, not a partially staged theme tree."""
    try:
        with current_theme_file.open() as source:
            before = os.fstat(source.fileno())
            name = source.read().strip()
            after = os.fstat(source.fileno())
        published = current_theme_file.stat()
    except FileNotFoundError:
        return None
    def identity(info):
        return [info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns, info.st_size]
    if identity(before) != identity(after) or identity(after) != identity(published):
        return None
    if not name or "\n" in name or "/" in name or name.startswith("."):
        return None
    return {"name": name, "identity": identity(after)}


def read_memory():
    try:
        memory = json.loads(memory_file.read_text())
    except FileNotFoundError:
        return {"schema": 1, "choices": {}, "mode": None, "observed": None,
                "automatic": None, "wallpapers": {}}
    if (not isinstance(memory, dict) or memory.get("schema") != 1
            or not isinstance(memory.get("choices"), dict)
            or memory.get("mode") not in (None, "light", "dark")
            or any(mode not in ("light", "dark") or not isinstance(name, str) or not name
                   for mode, name in memory["choices"].items())):
        raise ValueError(f"unsupported theme memory at {memory_file}")
    # Theme-only schema-1 records remain valid; no migration or reset is needed.
    memory.setdefault("wallpapers", {})
    if (not isinstance(memory["wallpapers"], dict)
            or any(mode not in ("light", "dark") or not valid_wallpaper_ref(ref)
                   for mode, ref in memory["wallpapers"].items())):
        raise ValueError(f"unsupported wallpaper memory at {memory_file}")
    return memory


def valid_wallpaper_ref(ref):
    if not isinstance(ref, dict):
        return False
    if set(ref) == {"path"}:
        return isinstance(ref["path"], str) and Path(ref["path"]).is_absolute()
    if set(ref) != {"theme", "relative"}:
        return False
    name, relative = ref["theme"], ref["relative"]
    return (isinstance(name, str) and bool(name) and not name.startswith(".")
            and "/" not in name and "\n" not in name
            and isinstance(relative, str) and bool(relative)
            and not Path(relative).is_absolute() and ".." not in Path(relative).parts)


def readable_image(path):
    """Availability only; the existing wallpaper setter owns media decoding."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        try:
            return stat.S_ISREG(os.fstat(fd).st_mode) and bool(os.read(fd, 1))
        finally:
            os.close(fd)
    except (OSError, ValueError):
        return False


def current_wallpaper(theme):
    """Resolve the selection link, retaining a qualified staged-theme identity.

    Omarchy rebuilds current/theme on each set. A copied image there needs its
    theme and relative path, not that mutable absolute path. A symlink out of
    that tree resolves to the actual image instead.
    """
    if theme is None:
        return None
    def identity(info):
        return [info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns]
    try:
        before = current_wallpaper_file.lstat()
        path = current_wallpaper_file.resolve(strict=True)
        if not readable_image(path):
            return None
        info = path.stat()
        staged = current_theme_file.parent/"theme"
        try:
            relative = path.relative_to(staged.absolute())
            ref = {"theme": theme["name"], "relative": str(relative)}
        except ValueError:
            ref = {"path": str(path)}
        after = current_wallpaper_file.lstat()
        if (identity(before) != identity(after)
                or current_wallpaper_file.resolve(strict=True) != path
                or current_theme() != theme):
            return None
        return {"reference": ref, "link": identity(after), "image": identity(info)}
    except (OSError, ValueError, RuntimeError):
        return None


def wallpaper_path(ref):
    if ref is None:
        return None
    if "path" in ref:
        path = Path(ref["path"])
    else:
        theme = current_theme()
        if theme is None or theme["name"] != ref["theme"]:
            return None
        path = current_theme_file.parent/"theme"/ref["relative"]
    return path if readable_image(path) else None


def observe_wallpaper(memory, automatic=False):
    current = current_wallpaper(current_theme())
    if current is None or current == memory.get("wallpaper_observed"):
        return
    intent = memory.get("wallpaper_intent")
    if intent:
        theme = current_theme()
        automatic = automatic or (
            intent["phase"] == "theme" and theme and theme["name"] == intent["theme"]
            or intent["phase"] == "wallpaper" and current["reference"] == intent["reference"])
    if not automatic and memory.get("mode") in ("light", "dark"):
        memory["wallpapers"][memory["mode"]] = current["reference"]
    memory["wallpaper_observed"] = current


def observe_theme(memory):
    """Remember only a new publication, in the outgoing solar period."""
    current = current_theme()
    if current is None or current == memory.get("observed"):
        return False
    automatic = memory.get("automatic")
    if automatic and current["name"] == automatic:
        # An interrupted automatic apply can publish before its acknowledgement.
        # Consume its publication without teaching it as a manual selection.
        memory["automatic"] = None
    elif memory.get("mode") in ("light", "dark"):
        memory["choices"][memory["mode"]] = current["name"]
        memory["automatic"] = None
    memory["observed"] = current
    return bool(automatic and current["name"] == automatic)


def settle_publications(memory):
    """Consume this command's effects without learning defaults as user choices."""
    observe_theme(memory)
    observe_wallpaper(memory, automatic=True)
    memory["wallpaper_intent"] = None
    _atomic_write(memory, memory_file)


def acknowledge(transition_id, acknowledgement_id):
    descriptor = transition_lock()
    try:
        record = read_transition()
        current_acknowledgement_id = (record.get("consumer_delivery_id", record.get("transition_id"))
                                      if record else None)
        if (record is None or not record.get("enabled")
                or record.get("transition_id") != transition_id
                or current_acknowledgement_id != acknowledgement_id
                or record.get("consumer_ack") == acknowledgement_id):
            return False
        record["consumer_ack"] = acknowledgement_id
        _atomic_write(record)
        return True
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def run_once():
    descriptor = consumer_lock()
    try:
        if not solar_enabled():
            return "off"
        record = read_transition()
        if record is None or not record.get("enabled"):
            return "off"
        desired = record.get("mode")
        transition_id = record.get("transition_id")
        acknowledgement_id = record.get("consumer_delivery_id", transition_id)
        if desired not in ("light", "dark") or not isinstance(transition_id, str) or not transition_id:
            return "off"
        if not isinstance(acknowledgement_id, str) or not acknowledgement_id:
            return "off"
        memory = read_memory()
        original = json.dumps(memory, sort_keys=True)
        automatic = observe_theme(memory)
        # Final outgoing observation precedes the change of period. On first
        # use only an already acknowledged period identifies the shown image.
        if memory["mode"] is None and record.get("consumer_ack") == acknowledgement_id:
            memory["mode"] = desired
        observe_wallpaper(memory, automatic=automatic)
        if memory["mode"] is None:
            # Establish a baseline on first use, without guessing whether the
            # already active theme was selected by a user or the old adapter.
            memory["mode"] = desired
        if record.get("consumer_ack") == acknowledgement_id:
            if json.dumps(memory, sort_keys=True) != original:
                _atomic_write(memory, memory_file)
            return "unchanged"

        # At a real transition the selected day/night theme is the new choice,
        # even when the current theme reports the same light/dark mode. Keep a
        # separate consumer lock across command and ack so parallel sessions
        # cannot apply the same event twice.
        configured = themes()
        # Save the destination period before a possibly failing command. Future
        # manual publications belong here even while this delivery is pending.
        memory["mode"] = desired
        remembered = memory["choices"].get(desired)
        if remembered is not None and not remembered_theme_available(remembered):
            del memory["choices"][desired]
            remembered = None
        target = remembered if remembered is not None else configured[desired]
        # Record intent before the command so a restart cannot learn our write.
        # Theme names are published by Omarchy as lowercase, hyphenated slugs.
        memory["automatic"] = target.lower().replace(" ", "-")
        memory["wallpaper_intent"] = {"phase": "theme", "theme": memory["automatic"]}
        _atomic_write(memory, memory_file)
        # A failure retains intent: the command may have partially published.
        try:
            subprocess.run(["omarchy", "theme", "set", target], check=True)
        except subprocess.CalledProcessError:
            # Removal can race the availability check. Only a now-missing
            # remembered theme warrants fallback; other command errors retain
            # their pending delivery and original failure.
            if remembered is None or remembered_theme_available(remembered):
                settle_publications(memory)
                raise
            settle_publications(memory)
            if memory["choices"].get(desired) == remembered:
                del memory["choices"][desired]
            target = configured[desired]
            memory["automatic"] = target.lower().replace(" ", "-")
            memory["wallpaper_intent"] = {"phase": "theme", "theme": memory["automatic"]}
            _atomic_write(memory, memory_file)
            try:
                subprocess.run(["omarchy", "theme", "set", target], check=True)
            except subprocess.CalledProcessError:
                settle_publications(memory)
                raise
        settle_publications(memory)
        # The theme setter may replace the wallpaper even for the same theme.
        # Restore the period's image afterwards, through Omarchy's public path.
        normal_wallpaper = current_wallpaper(current_theme())
        wallpaper = memory["wallpapers"].get(desired)
        path = wallpaper_path(wallpaper)
        if path is not None:
            memory["wallpaper_intent"] = {"phase": "wallpaper", "reference": wallpaper}
            _atomic_write(memory, memory_file)
            try:
                subprocess.run(["omarchy", "theme", "bg", "set", str(path)], check=True)
            except subprocess.CalledProcessError:
                settle_publications(memory)
                # Disappearance after the check is unavailable input, not an
                # endless delivery failure. Other setter errors remain errors.
                if wallpaper_path(wallpaper) is not None:
                    raise
                # A setter may have repointed the link before noticing removal.
                # Recover the valid theme default without remembering it.
                fallback = wallpaper_path(normal_wallpaper["reference"]) if normal_wallpaper else None
                if fallback is not None:
                    memory["wallpaper_intent"] = {
                        "phase": "wallpaper", "reference": normal_wallpaper["reference"]}
                    _atomic_write(memory, memory_file)
                    try:
                        subprocess.run(["omarchy", "theme", "bg", "set", str(fallback)], check=True)
                    except subprocess.CalledProcessError:
                        settle_publications(memory)
                        raise
            settle_publications(memory)
        if memory.get("observed") is not None:
            memory["automatic"] = None
        _atomic_write(memory, memory_file)
        if not acknowledge(transition_id, acknowledgement_id):
            return "superseded"
        return target
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


_libc = ctypes.CDLL(None, use_errno=True)
_libc.inotify_init1.argtypes = [ctypes.c_int]
_libc.inotify_init1.restype = ctypes.c_int
_libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
_libc.inotify_add_watch.restype = ctypes.c_int
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_ATTRIB = 0x00000004
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_Q_OVERFLOW = 0x00004000
IN_IGNORED = 0x00008000
IN_WATCH_MASK = IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE | IN_DELETE | IN_ATTRIB | IN_DELETE_SELF | IN_MOVE_SELF


def wait_for_transition_change(observed_digest=None):
    """Observe selection changes without inventing a Sunlight transition."""
    watched_paths = (transition_file, config_file, solar_file, current_theme_file,
                     current_wallpaper_file)
    fd = _libc.inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK)
    if fd < 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), "inotify_init1")
    watch_names = {}
    for path in watched_paths:
        directory = path.parent
        filename = path.name
        while not directory.exists() and directory != directory.parent:
            filename = directory.name
            directory = directory.parent
        if not directory.is_dir():
            os.close(fd)
            raise FileNotFoundError(f"no directory to watch for {path}")
        wd = _libc.inotify_add_watch(fd, os.fsencode(directory), IN_WATCH_MASK)
        if wd < 0:
            error = ctypes.get_errno()
            os.close(fd)
            raise OSError(error, os.strerror(error), str(directory))
        watch_names.setdefault(wd, set()).add(filename)
    if observed_digest is not None and _watch_digest() != observed_digest:
        os.close(fd)
        return
    poller = select.poll()
    poller.register(fd, select.POLLIN | select.POLLERR)
    try:
        while True:
            poller.poll()
            data = os.read(fd, 65536)
            offset = 0
            while offset+16 <= len(data):
                wd, mask, _cookie, name_len = struct.unpack_from("iIII", data, offset)
                start = offset+16
                name = data[start:start+name_len].split(b"\0", 1)[0].decode(errors="replace")
                offset = start+name_len
                if (mask & (IN_Q_OVERFLOW | IN_IGNORED | IN_DELETE_SELF | IN_MOVE_SELF)
                        or name in watch_names.get(wd, set())):
                    return
    finally:
        os.close(fd)


def _transition_digest():
    try:
        raw = transition_file.read_bytes()
    except FileNotFoundError:
        raw = b""
    return hashlib.sha256(raw).hexdigest()


def _watch_digest():
    digest = hashlib.sha256()
    for path in (transition_file, config_file, solar_file, current_theme_file):
        digest.update(os.fsencode(path))
        try:
            digest.update(path.read_bytes())
        except FileNotFoundError:
            digest.update(b"<missing>")
    # Reselecting the same name is still a manual publication. Include its
    # identity to close the watch-registration race even when bytes match.
    digest.update(json.dumps(current_theme(), sort_keys=True).encode())
    digest.update(json.dumps(current_wallpaper(current_theme()), sort_keys=True).encode())
    return digest.hexdigest()


def watch():
    # Theme publications wake observation only. Applying still requires an
    # unacknowledged core event, including after a consumer restart.
    while True:
        observed_digest = _watch_digest()
        try:
            run_once()
        except configparser.Error as error:
            print(f"scottland-omarchy-solar-theme: invalid theme mapping: {error}; waiting for a save", file=sys.stderr)
            try:
                wait_for_transition_change(observed_digest)
            except (OSError, ValueError) as wait_error:
                print(f"scottland-omarchy-solar-theme: watcher failed: {wait_error}; retrying in five minutes", file=sys.stderr)
                time.sleep(300)
            continue
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            print(f"scottland-omarchy-solar-theme: {error}; retrying in five minutes", file=sys.stderr)
            time.sleep(300)
            continue
        try:
            wait_for_transition_change(observed_digest)
        except (OSError, ValueError) as error:
            print(f"scottland-omarchy-solar-theme: watcher failed: {error}; retrying in five minutes", file=sys.stderr)
            time.sleep(300)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "once":
        print(run_once())
    else:
        watch()
