HYPR_CONFIG = os.path.expanduser("~/.config/hypr/hyprland.lua")

LUA_SCAN = r'''
local order, binds, window_rules = {}, {}, {}
local scroll_factor, scroll_rules, scroll_skipped = nil, {}, {}
local baseline = os.getenv("SCOTTLAND_OMARCHY_BASELINE_SCAN") == "1"

local function normalize(keys)
  local mods, key = {}, ""
  for part in string.gmatch(tostring(keys or ""), "[^+]+") do
    local value = part:gsub("^%s+", ""):gsub("%s+$", "")
    local upper = string.upper(value)
    if upper == "SUPER" or upper == "SHIFT" or upper == "CTRL" or upper == "CONTROL" or upper == "ALT" then
      mods[#mods + 1] = (upper == "CONTROL") and "CTRL" or upper
    else
      key = value
    end
  end
  table.sort(mods)
  return table.concat(mods, " "), key
end

local function literal(value)
  local kind = type(value)
  if kind == "string" then return string.format("%q", value) end
  if kind == "number" or kind == "boolean" then return tostring(value) end
  if kind == "table" then
    local parts = {}
    for k, v in pairs(value) do parts[#parts + 1] = tostring(k) .. "=" .. literal(v) end
    table.sort(parts)
    return "{" .. table.concat(parts, ",") .. "}"
  end
  return "nil"
end

local function option_signature(opts)
  local parts = {}
  for key, value in pairs(opts) do
    if key ~= "description" then parts[#parts + 1] = tostring(key) .. "=" .. literal(value) end
  end
  table.sort(parts)
  return table.concat(parts, ",")
end

local function from_user_omarchy_plugin()
  if baseline then return false end
  local plugin_root = (os.getenv("HOME") or "") .. "/.config/omarchy/plugins/"
  for level = 2, 16 do
    local info = debug.getinfo(level, "S")
    if not info then break end
    local source = info.source or ""
    if source:sub(1, 1) == "@" then source = source:sub(2) end
    if source:sub(1, #plugin_root) == plugin_root then return true end
  end
  return false
end

local function dispatcher(kind, arg) return { __scottland = true, kind = kind, arg = arg } end

-- "default" when the config call came from Omarchy's shipped files, else "custom".
local function rule_origin()
  local defaults = (os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/"
  for level = 3, 18 do
    local info = debug.getinfo(level, "S")
    if not info then break end
    local source = (info.source or ""):gsub("^@", "")
    if not source:match("/default/hypr/helpers%.lua$") and source:sub(1, 1) == "/" then
      if source:sub(1, #defaults) == defaults and not from_user_omarchy_plugin() then
        return "default"
      end
      return "custom"
    end
  end
  return "custom"
end

local function dsp_proxy(path)
  return setmetatable({ path = path }, {
    __index = function(self, key) return dsp_proxy(self.path .. "." .. tostring(key)) end,
    __call = function(self, ...)
      local first = ...
      if self.path == "hl.dsp.exec_cmd" and type(first) == "string" then return dispatcher("exec", first) end
      local args = {}
      for i = 1, select("#", ...) do args[i] = literal(select(i, ...)) end
      return dispatcher("lua", self.path .. "(" .. table.concat(args, ",") .. ")")
    end,
  })
end

local noop
noop = setmetatable({}, { __index = function() return noop end, __call = function() return noop end })

hl = setmetatable({
  dsp = dsp_proxy("hl.dsp"),
  bind = function(keys, action, opts)
    opts = opts or {}
    local mods, key = normalize(keys)
    -- A press and a release binding on the same keys are two shortcuts (e.g. push-to-talk:
    -- start on press, stop on release), as in Hyprland; neither may replace the other.
    local id = mods .. "+" .. key .. (opts.release and ":release" or "")
    local kind, arg, signature = "", "", ""
    if type(action) == "table" and action.__scottland then kind, arg = action.kind, action.arg
    elseif type(action) == "string" then kind, arg = "exec", action
    elseif type(action) == "function" then
      kind = "function"
      local info = debug.getinfo(action, "S")
      signature = info.source .. ":" .. tostring(info.linedefined) .. ":" .. tostring(info.lastlinedefined)
    end
    local row = { mods, key, opts.description or "", kind, arg,
                  (opts["repeat"] or opts.repeating) and "1" or "0",
                  opts.release and "1" or "0", opts.locked and "1" or "0",
                  opts.mouse and "1" or "0", signature, option_signature(opts),
                  from_user_omarchy_plugin() and "1" or "0" }
    if not binds[id] then order[#order + 1] = id end
    binds[id] = row
    return noop
  end,
  unbind = function(keys)
    local mods, key = normalize(keys)
    binds[mods .. "+" .. key] = nil
    binds[mods .. "+" .. key .. ":release"] = nil
    return noop
  end,
  get_config = function() return nil end,
  -- Touchpad scroll speed (input.touchpad.scroll_factor), last assignment winning as in Hyprland.
  -- Flattened so nested tables and "input:touchpad:scroll_factor" style keys both count.
  config = function(settings)
    local function walk(value, path)
      if type(value) ~= "table" then
        if path == "input:touchpad:scroll_factor" and tonumber(value) then
          scroll_factor = tonumber(value)
        end
        return
      end
      for key, inner in pairs(value) do
        local name = tostring(key):gsub("%.", ":")
        walk(inner, path == "" and name or (path .. ":" .. name))
      end
    end
    walk(settings, "")
    return noop
  end,
  -- Per-device scroll factors (hl.device): Scottland has no per-device speed, so report them.
  device = function(settings)
    if type(settings) == "table" and settings.scroll_factor ~= nil then
      scroll_skipped[#scroll_skipped + 1] = { "device " .. tostring(settings.name or "?") ..
        " scroll_factor " .. tostring(settings.scroll_factor), rule_origin() }
    end
    return noop
  end,
  -- Window rules that hide windows from screen sharing (no_screen_share): Scottland cannot honor
  -- them, so the report must say so. Printed as "@rule" rows after the bindings.
  window_rule = function(rules)
    if type(rules) ~= "table" then return noop end
    local match = type(rules.match) == "table" and rules.match or {}
    local parts = {}
    for k, v in pairs(match) do parts[#parts + 1] = tostring(k) .. " " .. tostring(v) end
    table.sort(parts)
    if rules.no_screen_share then
      window_rules[#window_rules + 1] = { table.concat(parts, ", "), rule_origin() }
    end
    if tonumber(rules.scroll_touchpad) then
      -- Scottland matches app-ids: a rule on class / initial_class carries over exactly.
      local translatable, patterns = true, {}
      for k, v in pairs(match) do
        if k == "class" or k == "initial_class" then patterns[#patterns + 1] = tostring(v)
        else translatable = false end
      end
      if translatable and #patterns > 0 then
        table.sort(patterns)
        scroll_rules[#scroll_rules + 1] = { table.concat(patterns, "\31"), tonumber(rules.scroll_touchpad) }
      else
        scroll_skipped[#scroll_skipped + 1] = { "window rule " .. table.concat(parts, ", ") ..
          " scroll_touchpad " .. tostring(rules.scroll_touchpad), rule_origin() }
      end
    end
    return noop
  end,
}, { __index = function() return noop end })

local real_require = require
if baseline then
  local root = os.getenv("OMARCHY_PATH") or "/usr/share/omarchy"
  package.path = root .. "/?.lua;" .. root .. "/?/init.lua;" .. package.path
  _G.omarchy_preinstalled_bindings = true
  _G.omarchy_default_bindings = true
  local ok, err = pcall(function()
    real_require("default.hypr.helpers")
    local loaded = 0
    for _, module in ipairs({ "media", "clipboard", "tiling", "utilities", "voxtype", "applications" }) do
      local path = root .. "/default/hypr/bindings/" .. module .. ".lua"
      local file = io.open(path, "r")
      if file then
        file:close()
        real_require("default.hypr.bindings." .. module)
        loaded = loaded + 1
      end
    end
    if loaded == 0 then error("no shipped binding modules found under " .. root) end
  end)
  if not ok then
    io.stderr:write("baseline scan failed: " .. tostring(err) .. "\n")
    os.exit(2)
  end
else
  -- A user module that fails against the stand-in must not stop the rest of the live scan.
  require = function(name)
    local ok, result = pcall(real_require, name)
    if ok then return result end
    io.stderr:write("skipped module " .. tostring(name) .. ": " .. tostring(result) .. "\n")
    package.loaded[name] = noop
    return noop
  end
  local ok, err = pcall(dofile, os.getenv("HOME") .. "/.config/hypr/hyprland.lua")
  if not ok then io.stderr:write("scan failed: " .. tostring(err) .. "\n") end
end
local printed = {}
for _, id in ipairs(order) do
  local b = binds[id]
  if b and not printed[id] then
    printed[id] = true
    for i = 1, #b do b[i] = tostring(b[i]):gsub("[\t\n]", " ") end
    print(table.concat(b, "\t"))
  end
end
for _, rule in ipairs(window_rules) do
  print("@rule\t" .. rule[1]:gsub("[\t\n]", " ") .. "\t" .. rule[2])
end
if scroll_factor then print("@scroll\t" .. string.format("%.15g", scroll_factor)) end
for _, rule in ipairs(scroll_rules) do
  print("@scrollrule\t" .. rule[1]:gsub("[\t\n]", " ") .. "\t" .. string.format("%.15g", rule[2]))
end
for _, skipped in ipairs(scroll_skipped) do
  print("@scrollskip\t" .. skipped[1]:gsub("[\t\n]", " ") .. "\t" .. skipped[2])
end
'''

MODIFIERS = {"SUPER": "<super>", "SHIFT": "<shift>", "CTRL": "<ctrl>", "ALT": "<alt>"}

# xkb keysym names (as Hyprland/Omarchy write them) -> evdev names (as Wayfire wants them)
