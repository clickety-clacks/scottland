def evdev_names():
    names = {}
    try:
        with open("/usr/include/linux/input-event-codes.h") as header:
            for line in header:
                match = re.match(r"#define (KEY_\w+)\s+(\d+)\b", line)
                if match:
                    names.setdefault(int(match.group(2)), match.group(1))
    except OSError:
        pass
    return names


EVDEV = evdev_names()
BINDING_ORIGINS = {}
ORIGIN_SCAN_COMPLETE = False


def wayfire_key(key):
    if key.lower().startswith("code:"):
        code = int(key[5:]) - 8  # xkb keycodes are evdev codes + 8
        return EVDEV.get(code)
    if len(key) == 1 and key.isalnum():
        return f"KEY_{key.upper()}"
    if re.fullmatch(r"[Ff]\d{1,2}", key):
        return f"KEY_{key.upper()}"
    name = KEYSYMS.get(key.lower())
    return f"KEY_{name}" if name else None


def scan_identity(mods, key):
    aliases = {"CONTROL": "CTRL"}
    modifiers = tuple(sorted({aliases.get(part.upper(), part.upper()).lower()
                              for part in mods.split()}))
    normalized_key = wayfire_key(key) or key.strip().upper()
    return modifiers, normalized_key.upper()


def report_identity(label):
    aliases = {"CONTROL": "CTRL"}
    modifiers, keys = [], []
    for part in label.split("+"):
        upper = part.strip().upper()
        if upper in ("SUPER", "SHIFT", "CTRL", "CONTROL", "ALT"):
            modifiers.append(aliases.get(upper, upper))
        elif part.strip():
            keys.append(part.strip())
    return scan_identity(" ".join(modifiers), "+".join(keys))


def parse_scan_rows(output):
    rows = []
    for line in output.splitlines():
        if line.startswith("@"):
            continue
        fields = (line.split("\t") + [""] * 12)[:12]
        mods, key, description, kind, arg, repeat, release, locked, mouse, function, options, _plugin = fields
        rows.append({"identity": scan_identity(mods, key),
                     "signature": (kind, arg, repeat, release, locked, mouse, function, options),
                     "user_plugin": fields[11] == "1"})
    return rows


def update_binding_origins(live_output, defaults_output, defaults_complete, live_complete):
    """Classify captured rows from valid defaults; keep absent rows unverified on partial scans."""
    global BINDING_ORIGINS, ORIGIN_SCAN_COMPLETE
    ORIGIN_SCAN_COMPLETE = defaults_complete and live_complete
    BINDING_ORIGINS = {}
    default_signatures = {}
    if defaults_complete:
        for row in parse_scan_rows(defaults_output):
            default_signatures.setdefault(row["identity"], set()).add(row["signature"])
    for row in parse_scan_rows(live_output):
        identity = row["identity"]
        if row["user_plugin"]:
            # A user plugin remains user-added even when its binding matches Omarchy's default.
            origin = "Your custom/changed shortcut"
        elif not defaults_complete:
            continue
        else:
            origin = "Omarchy default" if row["signature"] in default_signatures.get(identity, set()) \
                else "Your custom/changed shortcut"
        BINDING_ORIGINS[identity] = origin


def source_for_label(label):
    identity = report_identity(label)
    if identity is not None and identity in BINDING_ORIGINS:
        return BINDING_ORIGINS[identity]
    return "Source not verified" if not ORIGIN_SCAN_COMPLETE else "No Omarchy shortcut on this key"


def combo(mods, key):
    wayfire = wayfire_key(key)
    if not wayfire:
        return None
    return " ".join([MODIFIERS[m] for m in mods.split() if m in MODIFIERS] + [wayfire])


def normalized_combo(value):
    """Modifier order, spacing and case do not distinguish physical shortcuts."""
    aliases = {"control": "ctrl"}
    mods = {aliases.get(m.lower(), m.lower()) for m in re.findall(r"<([^>]+)>", value)}
    key = re.sub(r"<[^>]+>", "", value).strip().upper()
    return tuple(sorted(mods)), key


def normalized_remap_combo(value):
    """Normalize a key_remaps xkb combo to the key names used by Wayfire bindings."""
    aliases = {"CTRL": "ctrl", "CONTROL": "ctrl", "SHIFT": "shift",
               "ALT": "alt", "SUPER": "super"}
    mods, key = set(), ""
    for part in re.split(r"[+\s]+", value.strip()):
        if not part:
            continue
        upper = part.upper()
        if upper in aliases:
            mods.add(aliases[upper])
        else:
            key = part
    wayfire = wayfire_key(key)
    return (tuple(sorted(mods)), wayfire) if wayfire else None


def scottland_metadata():
    """Use the session's metadata (dev/test hooks or packaged), as Wayfire does."""
    search = os.environ.get("WAYFIRE_PLUGIN_XML_PATH")
    directories = search.split(":") if search else [
        os.path.join(os.environ.get("SCOTTLAND_HOOKS", "/usr/lib/scottland"), "metadata"),
        "/usr/share/wayfire/metadata",
    ]
    return next((Path(d) / "scottland.xml" for d in directories
                 if (Path(d) / "scottland.xml").is_file()), None)


def metadata_reasons():
    """Plain Scottland feature descriptions; this file never names Omarchy."""
    metadata = scottland_metadata()
    if not metadata:
        return {}, "", ""
    descriptions, remap_reason, alt_hold_reason = {}, "", ""
    for option in ET.parse(metadata).findall(".//plugin[@name='scottland']//option"):
        name = option.get("name", "")
        if option.get("type") in ("key", "button", "activator"):
            long = option.findtext("_long", "").strip()
            # The final sentence is the short, generic reason this feature needs its binding.
            reason = re.split(r"(?<=[.!?])\s+", long)[-1] if long else ""
            descriptions[name] = (option.findtext("_short", "").strip(), reason)
        elif name == "alt_hold_delay":
            long = option.findtext("_long", "").strip()
            alt_hold_reason = re.split(r"(?<=[.!?])\s+", long)[-1] if long else ""
        elif name == "key_remaps":
            long = option.findtext("_long", "").strip()
            remap_reason = re.split(r"(?<=[.!?])\s+", long)[-1] if long else ""
    return descriptions, remap_reason, alt_hold_reason


def parse_base(path):
    """Index effective bindings: metadata defaults, replaced by explicit INI values.

    Keep every owner of a combination: disabling just one still runs two handlers.
    An explicit `none` (or a different key) must also replace the metadata default.
    """
    values, section, reasons = {}, "", {}
    metadata = scottland_metadata()
    if metadata:
        for option in ET.parse(metadata).findall(".//plugin[@name='scottland']//option"):
            if option.get("type") in ("key", "button", "activator"):
                values[("scottland", option.get("name"))] = option.findtext("default", "")
    config_paths = [Path(path)]
    xdg_config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    overrides = xdg_config / "scottland" / "overrides.ini"
    if overrides.is_file():
        # The user override fragment is appended after this generated fragment at
        # session start, so collision detection must use its effective remap values.
        config_paths.append(overrides)
    reason_line = re.compile(r"#\s*scottland-override-reason:\s*([^/]+)/([^=]+?)\s*=\s*(.+)$")
    for config_path in config_paths:
        section = ""
        with open(config_path) as config:
            for line in config:
                stripped = line.strip()
                if stripped.startswith("[") and stripped.endswith("]"):
                    section = stripped[1:-1]
                    continue
                if stripped.startswith("#"):
                    match = reason_line.match(stripped)
                    if match:
                        reasons[(match.group(1).strip(), match.group(2).strip())] = match.group(3).strip()
                    continue
                if "=" not in stripped:
                    continue
                option, value = (part.strip() for part in stripped.split("=", 1))
                values[(section, option)] = value
    used = {}
    for (section, option), value in values.items():
        for alternative in value.split("|"):
            normalized = normalized_combo(alternative)
            owner = (section, option, value)
            if re.fullmatch(r"(?:KEY|BTN)_\w+", normalized[1]):
                owners = used.setdefault(normalized, [])
                if owner not in owners:
                    owners.append(owner)
        if section == "scottland" and option.startswith("remap_from_"):
            normalized = normalized_remap_combo(value)
            if normalized:
                owners = used.setdefault(normalized, [])
                owner = ("scottland-key-remap", option[len("remap_from_"):], value)
                if owner not in owners:
                    owners.append(owner)
    remaps = {}
    for (section, option), value in values.items():
        if section != "scottland" or not option.startswith("remap_from_") or not value:
            continue
        name = option[len("remap_from_"):]
        remaps[name] = {
            "from": value,
            "to": values.get(("scottland", f"remap_to_{name}"), ""),
            "apps": values.get(("scottland", f"remap_apps_{name}"), ""),
        }
    return used, remaps, reasons


def pretty_keys(value):
    """Turn generated binding names into labels that read naturally in the report."""
    names = {"SUPER": "Super", "SHIFT": "Shift", "CTRL": "Ctrl", "ALT": "Alt",
             "TAB": "Tab", "SPACE": "Space", "ENTER": "Enter", "ESC": "Escape",
             "BACKSPACE": "Backspace", "DELETE": "Delete", "COMMA": ",",
             "DOT": ".", "LEFT": "Left", "RIGHT": "Right", "UP": "Up", "DOWN": "Down"}
    modifier_order = {"SUPER": 0, "CTRL": 1, "ALT": 2, "SHIFT": 3}
    parts = re.split(r"[+\s]+", value.strip())
    modifiers, pretty = [], []
    for part in parts:
        if not part:
            continue
        if part.upper() in modifier_order:
            modifiers.append(part.upper())
            continue
        code = re.fullmatch(r"code:(\d+)", part, re.IGNORECASE)
        if code:
            evdev = EVDEV.get(int(code.group(1)) - 8)
            if evdev and evdev.startswith("KEY_"):
                part = evdev[4:]
        pretty.append(names.get(part.upper(), part.upper() if len(part) == 1 else part.title()))
    return "+".join([names[mod] for mod in sorted(set(modifiers), key=modifier_order.get)] + pretty)


SWITCH_KEY = re.compile(r"switch:(?:(on|off):)?(.+)", re.IGNORECASE)


def report_entry(group, label, description, now, origin=None, keys=None):
    heading, explanation = REPORT_GROUPS[group]
    switch = SWITCH_KEY.fullmatch(label)
    keys = keys or (f"{switch.group(2).strip()} ({(switch.group(1) or 'either way').lower()})"
                    if switch else pretty_keys(label))
    was = (description or f"Shortcut on {keys}").strip().rstrip(".")
    return {"heading": heading, "why": explanation, "keys": keys,
            "was": was, "now": now, "origin": origin or source_for_label(label),
            "order": REPORT_GROUP_ORDER[group]}


def feature_report_group(section, option):
    if section == "scottland-key-remap":
        return "app_remaps"
    if section == "scottland":
        if option in ("center_switcher_next", "center_switcher_previous"):
            return "window_mode"
        if option == "minimize_widget":
            return "widget_controls"
        if option in ("move", "move_shift", "resize", "resize_alt"):
            return "window_controls"
        return "other_feature"
    option = option.split("binding_", 1)[-1]
    if option == "scottland_settings":
        return "settings"
    if option == "scottland_reload":
        return "reload"
    return "other_feature"


def app_id_regex(patterns):
    """One app-id regex for Hyprland class / initial_class patterns, all of which must match
    (RE2 FullMatch; "negative:" inverts), for core's touchpad_scroll_apps (a whole-app-id match)."""
    parts = []
    for pattern in patterns:
        if pattern.startswith("negative:"):
            parts.append(f"(?!(?:{pattern[9:]})$)")
        else:
            parts.append(f"(?=(?:{pattern})$)")
    if len(parts) == 1 and not patterns[0].startswith("negative:"):
        return patterns[0]
    return "".join(parts) + ".*"


def omission_report_group(kind, action, description, note):
    text = f"{description} {action} {note}".casefold()
    path = action.casefold().split("(", 1)[0].rstrip(".")
    if "group" in text:
        return "groups"
    if ("workspace layout" in text or path.startswith("hl.dsp.layout") or
            re.search(r"\b(layout|tiling|tiler|tile|dwindle|master|splitratio|floating)\b", text)):
        return "layout"
    if "workspace" in text:
        return "workspaces"
    if path.startswith("hl.dsp.window."):
        operation = path.rsplit(".", 1)[-1]
        if operation in {"move", "resize", "swap", "toggle_floating", "togglefloating"}:
            return "layout"
        if operation in {"focus", "switch", "next", "previous", "prev", "cycle", "movefocus"}:
            return "window_navigation"
    if re.search(r"\b(movefocus|focuswindow|cyclenext|cycleprev|focuscurrentorlast)\b", text):
        return "window_navigation"
    if re.search(r"\b(layoutmsg|togglesplit|swapwindow|movewindow|resizeactive|moveactive)\b", text):
        return "layout"
    if re.search(r"\b(window|windows)\b", text) and re.search(
            r"\b(focus|switch|next|previous|prev|cycle|navigate)\b", text):
        return "window_navigation"
    return "unsupported"


def omarchy_action_description(description, kind, action, group):
    if description and description.strip():
        return description.strip().rstrip(".")
    if group == "workspaces":
        target = re.search(r"\bworkspace\s*=\s*[\"']?([^,}\"']+)|\bworkspace\s+([+-]?\w+)",
                           action, re.IGNORECASE)
        if target:
            return f"Switch to workspace {(target.group(1) or target.group(2)).strip()}"
    if group == "layout" and "togglesplit" in action.casefold():
        return "Toggle the window split layout"
    if group == "window_navigation":
        direction = re.search(r"\bmovefocus\s+(l|r|u|d|left|right|up|down)\b", action,
                              re.IGNORECASE)
        if direction:
            direction_name = {"l": "left", "r": "right", "u": "up", "d": "down"}.get(
                direction.group(1).casefold(), direction.group(1).casefold())
            return f"Focus the window to the {direction_name}"
    generic_action = {
        "workspaces": "Switch or move windows between workspaces",
        "layout": "Change the window layout",
        "window_navigation": "Navigate between windows",
        "groups": "Change the window group",
        "unsupported": f"Run unsupported action {action}" if action else "Run an unsupported action",
    }
    if kind == "exec":
        if group in generic_action and group != "unsupported":
            return generic_action[group]
        return f"Run command {action}" if action else "Run command"
    if kind == "function":
        return "Run a shortcut function"
    if kind == "lua":
        return generic_action.get(group, f"Run action {action}" if action else "Run shortcut action")
    return f"Run {kind or 'shortcut'} action"


def parse_grouped_fragment(fragment):
    """Read grouped flavoring entries while keeping their reason headings mergeable."""
    entries = []
    heading = explanation = None
    current = None

    def finish():
        nonlocal current
        if current is None:
            return
        if not heading or not explanation or not all(current.get(k) for k in ("keys", "was", "now")):
            raise ValueError(f"incomplete grouped entry in {fragment}")
        entries.append({"heading": heading, "why": explanation,
                        "keys": current["keys"], "was": current["was"],
                        "now": current["now"], "origin": current.get("origin"),
                        "order": len(REPORT_GROUP_ORDER) + 1})
        current = None

    for line in fragment.read_text().splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("## "):
            finish()
            heading = stripped[3:].strip()
            explanation = None
        elif stripped.startswith("Reason:"):
            explanation = stripped[len("Reason:"):].strip()
        elif stripped.startswith("- Keys:") or stripped.startswith("Keys:"):
            finish()
            current = {"keys": stripped.split(":", 1)[1].strip()}
        elif current is not None and stripped.startswith("Was:"):
            current["was"] = stripped[len("Was:"):].strip()
        elif current is not None and stripped.startswith("Now:"):
            current["now"] = stripped[len("Now:"):].strip()
        elif current is not None and stripped.startswith("Origin:"):
            current["origin"] = stripped[len("Origin:"):].strip()
        else:
            raise ValueError(f"unrecognized grouped entry line in {fragment}: {stripped}")
    finish()
    return entries


def parse_legacy_fragment(fragment):
    """Keep the earlier four-field flavoring format readable, grouped by its Why text."""
    entries = []
    current = None

    def finish():
        nonlocal current
        if current is None:
            return
        if not all(current.get(k) for k in ("keys", "was", "now", "why")):
            raise ValueError(f"incomplete legacy entry in {fragment}")
        reason = current["why"].strip()
        entries.append({"heading": f"Flavoring: {reason.rstrip('.')}.", "why": reason,
                        "keys": current["keys"], "was": current["was"],
                        "now": current["now"], "origin": current.get("origin"),
                        "order": len(REPORT_GROUP_ORDER) + 1})
        current = None

    for line in fragment.read_text().splitlines():
        stripped = line.strip()
        if stripped.startswith("- Keys:"):
            finish()
            current = {"keys": stripped[len("- Keys:"):].strip()}
        elif current is not None and stripped.startswith(("Was:", "Now:", "Why:", "Origin:")):
            key, value = (part.strip() for part in stripped.split(":", 1))
            current[key.casefold()] = value
        elif stripped:
            raise ValueError(f"unrecognized legacy entry line in {fragment}: {stripped}")
    finish()
    return entries


def read_report_fragment(fragment):
    try:
        return parse_grouped_fragment(fragment)
    except ValueError as grouped_error:
        try:
            return parse_legacy_fragment(fragment)
        except ValueError:
            content = fragment.read_text().strip().replace("\n", " / ")
            print(f"50-omarchy-shortcuts: malformed override fragment {fragment}: {grouped_error}",
                  file=sys.stderr)
            if not content:
                return []
            return [{"heading": f"Flavoring note: {fragment.stem}",
                     "why": "This flavoring supplied a note that could not be grouped as shortcut entries.",
                     "keys": "See flavoring note", "was": "Flavoring report fragment",
                     "now": content, "origin": "Gooarchy flavoring",
                     "order": len(REPORT_GROUP_ORDER) + 1}]


OWN_SHORTCUTS_HEADING = "Your own shortcuts that don't work in Scottland"


def report_item_line(item, include_reason=False):
    was = item["was"].rstrip(".!? ") + "."
    now = item["now"].rstrip(".!? ") + "."
    origin = item.get("origin") or source_for_label(item["keys"])
    line = f"- {item['keys']} — Was: {was} Now: {now} [{origin}]"
    if include_reason:
        line += f" Why: {item['why'].rstrip('.!? ')}."
    return line


def own_shortcuts_for_prompt(report_content):
    """Copy the custom-only callout into the agent prompt from the stable report."""
    lines = report_content.splitlines()
    try:
        start = lines.index(f"## {OWN_SHORTCUTS_HEADING}") + 1
    except ValueError:
        return "None found."
    bullets = []
    for line in lines[start:]:
        if line.startswith("## "):
            break
        if line.startswith("- ") and "[Your custom/changed shortcut]" in line:
            bullets.append(line)
    return "\n".join(bullets) if bullets else "None found."


def render_override_prompt(report, report_content=None):
    template_path = Path(__file__).resolve().parents[1] / "prompts/omarchy-overrides-agent.txt"
    content = report_content if report_content is not None else report.read_text()
    return (template_path.read_text()
            .replace("@REPORT_PATH@", str(report))
            .replace("@OWN_CUSTOM_SHORTCUTS@", own_shortcuts_for_prompt(content)))


def make_report(overrides):
    """Render a stable, diffable report with no timestamps or session-specific data."""
    hooks = Path(os.environ.get("SCOTTLAND_HOOKS", "/usr/lib/scottland"))
    directories = (hooks / "override-report.d",
                   Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) /
                   "scottland" / "override-report.d")
    fragments = sorted(fragment for directory in directories if directory.is_dir()
                       for fragment in directory.glob("*.txt"))
    entries = [dict(item) for item in overrides]
    for fragment in fragments:
        for item in read_report_fragment(fragment):
            if not item.get("origin"):
                item["origin"] = source_for_label(item["keys"])
                if item["origin"] == "No Omarchy shortcut on this key":
                    item["origin"] = "Gooarchy flavoring"
            entries.append(item)
    unique = {(o["heading"], o["why"], o["keys"], o["was"], o["now"], o.get("origin")): o
              for o in entries}
    grouped = {}
    for item in unique.values():
        key = (item["heading"], item["why"])
        if key not in grouped:
            grouped[key] = {"order": item.get("order", len(REPORT_GROUP_ORDER) + 1), "items": []}
        grouped[key]["order"] = min(grouped[key]["order"], item.get("order", len(REPORT_GROUP_ORDER) + 1))
        grouped[key]["items"].append(item)
    ordered_groups = sorted(grouped.items(), key=lambda row: (
        row[1]["order"], row[0][0].casefold(), row[0][1].casefold()))
    own_shortcuts = sorted(
        (item for item in unique.values()
         if (item.get("origin") or source_for_label(item["keys"])) == "Your custom/changed shortcut"),
        key=lambda item: (item.get("order", len(REPORT_GROUP_ORDER) + 1),
                          item["heading"].casefold(), item["keys"].casefold(), item["was"].casefold()))
    lines = [
        "Scottland shortcut changes",
        "===========================",
        "",
        f"## {OWN_SHORTCUTS_HEADING}",
        "These were added or changed in your settings or a user-installed Omarchy plugin.",
    ]
    if own_shortcuts:
        lines.extend(report_item_line(item, include_reason=True) for item in own_shortcuts)
    else:
        lines.append("None found.")
    lines.extend([
        "",
        "This report lists shortcuts and mappings from the live Omarchy configuration that Scottland changes or cannot use.",
        "It remains on disk so you can reread it later.",
        "[Omarchy default] matches a shipped shortcut; [Your custom/changed shortcut] came from your settings or a user-installed plugin.",
        "[Source not verified] means the comparison could not be completed; other labels identify the shortcut or mapping source.",
        "",
    ])
    if not ordered_groups:
        lines.append("No Omarchy shortcuts or mappings were changed.")
    else:
        for (heading, explanation), group in ordered_groups:
            lines.extend((f"## {heading}", explanation, ""))
            for item in sorted(group["items"], key=lambda value: (
                    value["keys"].casefold(), value["was"].casefold(), value["now"].casefold())):
                lines.append(report_item_line(item))
            lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def report_paths():
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "scottland"
    return (state / "omarchy-overrides.txt", state / "omarchy-overrides.seen",
            state / "omarchy-overrides.lock")


def write_report(content):
    report, _, lock_path = report_paths()
    report.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        old = report.read_text() if report.exists() else None
        if old != content:
            fd, temporary = tempfile.mkstemp(prefix=f".{report.name}.", dir=report.parent)
            try:
                with os.fdopen(fd, "w") as output:
                    os.fchmod(output.fileno(), 0o600)
                    output.write(content)
                    output.flush()
                    os.fsync(output.fileno())
                os.replace(temporary, report)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
        digest = hashlib.sha256(content.encode()).hexdigest()
        return digest


def run_lua_scan(baseline=False):
    env = {**os.environ, "HOME": os.path.expanduser("~")}
    if baseline:
        env["SCOTTLAND_OMARCHY_BASELINE_SCAN"] = "1"
    else:
        env.pop("SCOTTLAND_OMARCHY_BASELINE_SCAN", None)
    try:
        return subprocess.run(["lua", "-"], input=LUA_SCAN, capture_output=True, text=True,
                              env=env, timeout=15)
    except (OSError, subprocess.SubprocessError) as error:
        return subprocess.CompletedProcess(["lua", "-"], 127, "", str(error))


def show_pending_report():
    """Open unseen content in Omarchy's default coding agent or editor without blocking."""
    if os.environ.get("SCOTTLAND_TEST_MODEL") == "1":
        return False
    report, seen_path, lock_path = report_paths()
    if not report.is_file():
        return False
    report.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        content = report.read_text()
        digest = hashlib.sha256(content.encode()).hexdigest()
        if seen_path.is_file() and seen_path.read_text().strip() == digest:
            return False
        if not launch_override_report(report):
            return False
        fd, temporary = tempfile.mkstemp(prefix=f".{seen_path.name}.", dir=report.parent)
        try:
            with os.fdopen(fd, "w") as output:
                os.fchmod(output.fileno(), 0o600)
                output.write(digest + "\n")
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, seen_path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        return True


def launch_override_report(report):
    """Prefer Omarchy's selected coding agent; use its editor launcher as fallback."""
    selector = shutil.which("omarchy-default-agent")
    agent_launcher = shutil.which("omarchy-agent-prompt")
    if selector and agent_launcher:
        try:
            selected = subprocess.run([selector], stdin=subprocess.DEVNULL,
                                      capture_output=True, text=True, timeout=3, check=False)
            if selected.returncode == 0 and selected.stdout.strip():
                prompt = render_override_prompt(report)
                subprocess.Popen([agent_launcher, prompt], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True, close_fds=True)
                return True
        except (OSError, subprocess.SubprocessError, UnicodeError) as error:
            print(f"50-omarchy-shortcuts: default agent unavailable ({error}); trying editor", file=sys.stderr)

    editor = shutil.which("omarchy-launch-editor")
    if not editor:
        print("50-omarchy-shortcuts: no default agent or editor launcher is available; report remains on disk",
              file=sys.stderr)
        return False
    try:
        subprocess.Popen([editor, str(report)], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, close_fds=True)
    except OSError as error:
        print(f"50-omarchy-shortcuts: could not open override report: {error}", file=sys.stderr)
        return False
    return True


def main():
    arguments = sys.argv[1:]
    if arguments == ["--watch-paths"]:
        print(os.path.dirname(HYPR_CONFIG))
        if metadata := scottland_metadata():
            print(metadata)
        hooks = Path(os.environ.get("SCOTTLAND_HOOKS", "/usr/lib/scottland"))
        report_drops = [hooks / "override-report.d",
                        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) /
                        "scottland" / "override-report.d"]
        for directory in report_drops:
            if directory.is_dir():
                print(directory)
        return
    if arguments == ["--show-pending"]:
        show_pending_report()
        return

    report_only = "--report-only" in arguments
    show_after = "--show-pending" in arguments
    base = next((argument for argument in arguments if not argument.startswith("--")), None)
    if base is None:
        user_base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "scottland/scottland.ini"
        base = str(user_base if user_base.is_file() else "/usr/share/scottland/scottland.ini")
    if not os.path.exists(base):
        base = str(Path(__file__).resolve().parents[2] / "core/config/scottland.ini")

    scan = None
    defaults_scan = None
    if os.path.exists(HYPR_CONFIG):
        scan = run_lua_scan()
        if scan.returncode == 0:
            defaults_scan = run_lua_scan(baseline=True)
    defaults_complete = bool(defaults_scan and defaults_scan.returncode == 0 and
                             not defaults_scan.stderr.strip())
    live_complete = bool(scan and scan.returncode == 0 and not scan.stderr.strip())
    update_binding_origins(scan.stdout if scan else "",
                           defaults_scan.stdout if defaults_scan else "",
                           defaults_complete, live_complete)
    scan_stdout = scan.stdout if scan else ""
    scan_stderr = scan.stderr if scan else ""
    if defaults_scan and defaults_scan.returncode != 0:
        scan_stderr += "\nOmarchy default shortcut scan unavailable: " + defaults_scan.stderr
    used, remaps, _command_reasons = parse_base(base)
    descriptions, _remap_reason, _alt_hold_reason = metadata_reasons()

    command_overrides, disabled, sections, skipped, kept = [], {}, {}, [], 0
    report_overrides = []
    reported_remaps = set()
    activators = {}  # (section, option) -> [(description, combo)]; one option can take several keys
    releases = []  # (description, keysym, command) for key-release shortcuts
    switches = []  # (description, device, on|off|toggle, command) for hardware switches (lid)

    def omitted(label, description, note, group="unsupported", now="No shortcut in Scottland",
                kind="", action=""):
        skipped.append(f"{label}  {description}  ({note})")
        was = omarchy_action_description(description, kind, action, group)
        report_overrides.append(report_entry(group, label, was, now))

    scroll_speed, scroll_rules = None, []
    for line in scan_stdout.splitlines():
        if line.startswith("@scroll\t"):
            scroll_speed = line.split("\t")[1]
            continue
        if line.startswith("@scrollrule\t"):
            _, patterns, factor = (line.split("\t") + ["", ""])[:3]
            scroll_rules.append((app_id_regex(patterns.split("\x1f")), factor))
            continue
        if line.startswith("@scrollskip\t"):
            _, what, origin = (line.split("\t") + ["", ""])[:3]
            report_overrides.append(report_entry(
                "input", "", f"Touchpad scroll speed: {what}",
                "Not carried over; the global or per-app speed applies",
                origin="Omarchy default" if origin == "default" else "Your custom/changed shortcut",
                keys=f"Touchpad scroll: {what.split(' scroll_')[0]}"))
            continue
        if line.startswith("@rule\t"):
            # P10: a protection the user had is gone, so say so (adapter-gaps AG01).
            _, match, origin = (line.split("\t") + ["", ""])[:3]
            report_overrides.append(report_entry(
                "capture", "", "Hidden from screen sharing and screenshots (no_screen_share)",
                "Shown in screen sharing, screenshots and recordings like any other window",
                origin="Omarchy default" if origin == "default" else "Your custom/changed shortcut",
                keys=f"Window rule: {match or 'any window'}"))
            continue
        mods, key, description, kind, arg, repeat, release, locked = (line.split("\t") + [""] * 8)[:8]
        label = f"{mods.replace(' ', '+')}+{key}".lstrip("+")
        if mods == "ALT" and not key:
            omitted(label, description, "Scottland Window mode Alt hold", "window_mode",
                    now="Holding Alt now enters Scottland's Window mode and shows window hints.")
            continue
        if release == "1" and kind in ("exec", "function"):
            # The Scottland plugin runs these when the key is let go (Hyprland release binds).
            if kind == "exec" and HYPRLAND_ONLY.search(arg):
                omitted(label, description, f"Hyprland-only: {arg[:60]}",
                        omission_report_group(kind, arg, description, "Hyprland-only command"),
                        kind=kind, action=arg)
                continue
            command = arg if kind == "exec" else (
                '"${SCOTTLAND_HOOKS:-/usr/lib/scottland}"/libexec/scottland-lua-call '
                + shlex.quote(f"{mods}+{key}:release"))
            if locked == "1":
                # Neither release mechanism runs while the session is locked.
                report_overrides.append(report_entry(
                    "partial", label, omarchy_action_description(description, kind, arg, "partial"),
                    "Runs on release while the session is unlocked, not on the lock screen."))
            if not mods:
                releases.append((description or label, key, command))
                kept += 1
                continue
            # With modifiers: Wayfire's release binding, run when the key of the pressed chord is
            # let go (Hyprland's bindr on a modified chord).
            wanted = combo(mods, key)
            if not wanted:
                omitted(label, description, "key has no Wayfire name", kind=kind, action=arg)
                continue
            owners = used.get(normalized_combo(wanted), [])
            if any(section in ("scottland", "scottland-key-remap") or
                   (section == "command" and option.split("binding_", 1)[-1].startswith("scottland_"))
                   for section, option, _value in owners):
                omitted(label, description, "Scottland feature keys", "other_feature",
                        now="Scottland uses these keys for one of its own features.",
                        kind=kind, action=arg)
                continue
            name = f"omarchy_{kept}"
            sections.setdefault("command", []).append(
                (f"# {description or label} (on release)", f"release_binding_{name} = {wanted}",
                 f"command_{name} = {command}"))
            kept += 1
            continue
        switch = SWITCH_KEY.fullmatch(key) if not mods else None
        if switch:
            # Hyprland's switch:on:<device> / switch:off:<device> / switch:<device> (either way),
            # e.g. the laptop lid; core's switch bindings run them (also on the lock screen).
            if kind == "exec" and HYPRLAND_ONLY.search(arg):
                omitted(label, description, f"Hyprland-only: {arg[:60]}", kind=kind, action=arg)
                continue
            if kind not in ("exec", "function"):
                omitted(label, description, "untranslated switch action", kind=kind, action=arg)
                continue
            command = arg if kind == "exec" else (
                '"${SCOTTLAND_HOOKS:-/usr/lib/scottland}"/libexec/scottland-lua-call '
                + shlex.quote(f"{mods}+{key}"))
            switches.append((description or label, switch.group(2).strip(),
                             (switch.group(1) or "toggle").lower(), command))
            kept += 1
            continue

        wanted = combo(mods, key)
        if not wanted:
            omitted(label, description, "key has no Wayfire name", kind=kind, action=arg)
            continue

        target = None
        if kind == "exec":
            if HYPRLAND_ONLY.search(arg):
                omitted(label, description, f"Hyprland-only: {arg[:60]}",
                        omission_report_group(kind, arg, description, "Hyprland-only command"),
                        kind=kind, action=arg)
                continue
            target = ("command", arg)
        elif kind == "lua":
            for prefix, (section, option) in DISPATCHERS.items():
                if arg.startswith(prefix):
                    target = (section, option)
                    break
            if not target:
                omitted(label, description, f"window/workspace action: {arg[:60]}",
                        omission_report_group(kind, arg, description, "untranslated dispatcher"),
                        kind=kind, action=arg)
                continue
        elif kind == "function":
            # scottland-luahost keeps the function (and its state) and runs it on demand.
            target = ("command", '"${SCOTTLAND_HOOKS:-/usr/lib/scottland}"/libexec/scottland-lua-call '
                      + shlex.quote(f"{mods}+{key}"))
        else:
            omitted(label, description, "unrecognized action", kind=kind, action=arg)
            continue

        if target == ("core", "close_top_view") and normalized_combo(wanted) == (("super",), "KEY_W"):
            omitted(label, description, "O9: close remains unbound", "super_w",
                    now="Super+W is left unbound; closing remains an explicit action.",
                    kind=kind, action=arg)
            continue

        # Scottland keeps the Omarchy setup as far as it can, and overrides it only where Scottland's
        # own features need the keys (O5): a Scottland feature binding (the [scottland] section, or a
        # scottland_* command) and every key_remaps from-combo keep their keys; the Omarchy shortcut
        # steps aside. Any other default on the same keys (Wayfire's, or Scottland's generic ones
        # like the terminal) yields to it.
        owners = used.get(normalized_combo(wanted), [])
        feature_owners = [(section, option, value) for section, option, value in owners
                          if section == "scottland-key-remap" or section == "scottland" or
                          (section == "command" and
                           option.split("binding_", 1)[-1].startswith("scottland_"))]
        if feature_owners:
            feature_labels = []
            for section, option, value in feature_owners:
                if section == "scottland-key-remap":
                    remap = remaps.get(option, {"from": value, "to": "", "apps": ""})
                    reported_remaps.add(option)
                    remap_from = pretty_keys(remap["from"])
                    remap_to = pretty_keys(remap["to"]) or "an unspecified key"
                    app_scope = f" in apps matching {remap['apps']}" if remap.get("apps") else " in matching apps"
                    feature = f"key_remaps/{option} ({value})"
                    feature_labels.append(feature)
                    report_overrides.append(report_entry(
                        "app_remaps", label,
                        omarchy_action_description(description, kind, arg, "app_remaps"),
                        (f"Scottland omits this imported shortcut globally; {remap_from} sends "
                         f"{remap_to}{app_scope}.")))
                    continue
                if section == "scottland":
                    short, _why = descriptions.get(option, (option.replace("_", " "), ""))
                    title = short or option.replace("_", " ").title()
                    feature = f"scottland/{option}"
                    feature_labels.append(feature)
                    if option == "center_switcher_next":
                        now = f"Scottland's Window mode previews the next center window on {pretty_keys(label)}."
                    elif option == "center_switcher_previous":
                        now = f"Scottland's Window mode previews the previous center window on {pretty_keys(label)}."
                    elif option == "minimize_widget":
                        now = (f"{pretty_keys(label)} now cycles Scottland's widgets: expanded, icons only, hidden; "
                               "holding it hides them (or expands them) until released.")
                    else:
                        now = f"Scottland's {title.lower()} action uses this key."
                    group = feature_report_group(section, option)
                    report_overrides.append(report_entry(
                        group, label, omarchy_action_description(description, kind, arg, group), now))
                    continue
                base_option = option.split("binding_", 1)[-1]
                title = {"scottland_settings": "Scottland Settings",
                         "scottland_reload": "Scottland reload"}.get(
                             base_option, base_option.replace("_", " ").title())
                feature = f"command/{option}"
                feature_labels.append(feature)
                now = f"Opens {title}." if base_option == "scottland_settings" \
                    else f"Runs {title}."
                group = feature_report_group(section, option)
                report_overrides.append(report_entry(
                    group, label, omarchy_action_description(description, kind, arg, group), now))
            skipped.append(f"{label}  {description}  (displaced: Scottland uses these keys for {', '.join(feature_labels)})")
            continue

        # The Omarchy shortcut wins over any other default on the same keys.
        replaced_command = False
        for section, option, value in owners:
            if target == (section, option):
                continue  # this option is replaced by the imported activator below
            # Taking over the command of Scottland's binding keeps that binding's own flags, so
            # only when they match: otherwise it steps aside and the shortcut comes in whole.
            same_flags = locked != "1" and option.startswith(
                "repeatable_binding_" if repeat == "1" else "binding_")
            if (section == "command" and same_flags
                    and target[0] == "command" and not replaced_command):
                name = option.split("binding_", 1)[1]
                command_overrides.append((f"command_{name}", target[1], description))
                replaced_command = True
                continue
            value = disabled.get((section, option), value)
            remaining = [a.strip() for a in value.split("|")
                         if normalized_combo(a) != normalized_combo(wanted)]
            disabled[(section, option)] = " | ".join(remaining) or "none"
        if replaced_command:
            kept += 1
            continue

        if target[0] == "command":
            # Hyprland's flags: repeating repeats while held; locked also works on the lock
            # screen (Wayfire's always binding). Both: the repeatable binding runs while unlocked
            # and holds the key, so the always binding only runs (once) while locked.
            prefixes = []
            if repeat == "1" or locked != "1":
                prefixes.append("repeatable_binding" if repeat == "1" else "binding")
            if locked == "1":
                prefixes.append("always_binding")
            name = f"omarchy_{kept}"
            entry = [f"# {description or label}"]
            for index, prefix in enumerate(prefixes):
                option = name if index == 0 else f"{name}_locked"
                entry += [f"{prefix}_{option} = {wanted}", f"command_{option} = {target[1]}"]
            sections.setdefault("command", []).append(tuple(entry))
        else:
            activators.setdefault(target, []).append((description or label, wanted))
        kept += 1

    # A remap changes what matching apps receive even when no imported shortcut collides with it.
    # Report those too, so the app-level mapping itself is never silent.
    for name, remap in sorted(remaps.items()):
        if name in reported_remaps or not remap["from"] or not remap["to"]:
            continue
        remap_from = pretty_keys(remap["from"])
        remap_to = pretty_keys(remap["to"])
        app_scope = f" in apps matching {remap['apps']}" if remap["apps"] else " in matching apps"
        report_overrides.append(report_entry(
            "app_remaps", remap_from, f"{remap_from} reached its matching apps unchanged",
            f"{remap_from} sends {remap_to}{app_scope}.", origin="Scottland app remap"))

    if not os.path.exists(HYPR_CONFIG):
        skipped.append("no ~/.config/hypr/hyprland.lua  (nothing to import)")
    report = make_report(report_overrides)
    write_report(report)
    if report_only:
        if show_after or os.environ.get("WAYFIRE_SOCKET"):
            show_pending_report()
        return

    print(f"# Generated from ~/.config/hypr/hyprland.lua by 50-omarchy-shortcuts: {kept} imported, "
          f"{len(skipped)} skipped.")
    for section, entries in sections.items():
        print(f"\n[{section}]")
        for entry in entries:
            print("\n".join(entry))
    for (section, option), entries in activators.items():
        print(f"\n[{section}]\n# {', '.join(d for d, _ in entries)}")
        print(f"{option} = {' | '.join(c for _, c in entries)}")
    if scroll_speed is not None:
        print("\n[input]\n# Omarchy's touchpad scroll speed (input.touchpad.scroll_factor)")
        print(f"touchpad_scroll_speed = {scroll_speed}")
    if scroll_rules:
        # Hyprland: the last matching scroll_touchpad rule sets the speed. Core: the first entry by
        # name. So the last rule gets the first name.
        print("\n[scottland]\n# Omarchy's per-app touchpad scroll speeds (scroll_touchpad window rules)")
        for index, (regex, factor) in enumerate(reversed(scroll_rules)):
            print(f"touchpad_scroll_apps_omarchy_{index:03d} = {regex}")
            print(f"touchpad_scroll_factor_omarchy_{index:03d} = {factor}")
    if releases or switches:
        print("\n[scottland]")
        for index, (description, key, command) in enumerate(releases):
            print(f"# {description} (on release)")
            print(f"release_key_omarchy_{index} = {key}")
            print(f"release_command_omarchy_{index} = {command}")
        for index, (description, device, state, command) in enumerate(switches):
            print(f"# {description} ({device} {state})")
            print(f"switch_device_omarchy_{index} = {device}")
            print(f"switch_state_omarchy_{index} = {state}")
            print(f"switch_command_omarchy_{index} = {command}")
    if command_overrides:
        print("\n[command]")
        for option, command, description in command_overrides:
            print(f"# {description} (Omarchy shortcut replaces the Scottland default on the same keys)")
            print(f"{option} = {command}")
    for (section, option), value in disabled.items():
        if (section, option) in activators:
            continue  # already replaced in full; do not disable the new imported binding
        print(f"\n[{section}]\n# Omarchy uses this key; Scottland's default steps aside.\n{option} = {value}")
    if skipped:
        print("\n# Skipped:")
        for entry in skipped:
            print(f"#   {entry}")
    for warning in scan_stderr.strip().splitlines():
        print(f"# Lua scan: {warning[:200]}")
    if show_after or os.environ.get("WAYFIRE_SOCKET"):
        show_pending_report()


def reload_lua_host():
    """Tell a running scottland-luahost to re-read the config this output was generated from."""
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    display = os.environ.get("WAYLAND_DISPLAY")
    fifo = os.path.join(runtime, "scottland", f"{display}.lua.fifo")
    if display and os.path.exists(fifo):
        subprocess.run(["timeout", "1", "sh", "-c", f"echo reload > {shlex.quote(fifo)}"], check=False)


if __name__ == "__main__":
    main()
    if "--watch-paths" not in sys.argv[1:] and "--report-only" not in sys.argv[1:] \
            and "--show-pending" not in sys.argv[1:]:
        reload_lua_host()
