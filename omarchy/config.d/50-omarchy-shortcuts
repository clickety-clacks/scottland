# The report groups shortcuts by why Scottland changes or omits them. Keep explanations concise
# and generic so the same report works with any Omarchy configuration.
REPORT_GROUPS = {
    "workspaces": ("Scottland has no workspaces",
                   "Scottland keeps every window on one spatial desktop; it does not switch or move windows between workspaces."),
    "layout": ("Scottland does its own window layout (no tiling)",
