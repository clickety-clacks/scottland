# Omarchy tags terminals with a window rule (default/hypr/apps/terminals.lua); bindings such as
# universal copy/paste read the tag, so mirror that rule.
TERMINAL_CLASS = re.compile(r"(Alacritty|kitty|com\.mitchellh\.ghostty|foot|org\.codeberg\.dnkl\.foot|"
                            r"wezterm|org\.omarchy\..*|TUI\..*)")

ADDRESS_BASE = 0x5C0700000000  # makes view ids look like Hyprland window addresses


def address(view_id, prefix="0x"):
    return f"{prefix}{ADDRESS_BASE + view_id:x}"


def view_id_from_address(text):
    return int(text.removeprefix("0x"), 16) - ADDRESS_BASE


class Log:
    def __init__(self):
        # The headless harness supplies an explicit state path so its shim can never append
        # unsupported requests or reconnect diagnostics to the user's live shim log.
        state = (os.environ.get("SCOTTLAND_TEST_STATE") or os.environ.get("XDG_STATE_HOME")
                 or os.path.expanduser("~/.local/state"))
        os.makedirs(os.path.join(state, "scottland"), exist_ok=True)
        self.file = open(os.path.join(state, "scottland", "hyprshim.log"), "a", buffering=1,
                         errors="backslashreplace")
        self.seen = set()

    def __call__(self, message):
        self.file.write(f"{time.strftime('%H:%M:%S')} {message}\n")

    def unsupported(self, request):
        key = request.split(" ", 1)[0]
        if key not in self.seen:
            self.seen.add(key)
            self(f"unsupported: {request[:200]}")


log = Log()


def unsupported(request):
    """The reply for a request with no Scottland translation; hyprctl exits 7 on "error:"."""
    return f"error: unsupported in Scottland: {request[:200]}"


class Wayfire:
    """Minimal Wayfire IPC client: 4-byte little-endian length, then JSON."""

    def __init__(self, path):
        self.path = path
        self.lock = threading.Lock()
        self.sock = None
        self.event_sock = None
        self.event_lock = threading.Lock()

    def _connect(self):
        sock = socket.socket(socket.AF_UNIX)
        sock.connect(self.path)
        return sock

    @staticmethod
    def send(sock, method, data=None):
        body = json.dumps({"method": method, "data": data or {}}).encode()
        sock.sendall(struct.pack("<I", len(body)) + body)

    @staticmethod
    def receive(sock):
        header = b""
        while len(header) < 4:
            chunk = sock.recv(4 - len(header))
            if not chunk:
                raise ConnectionError("wayfire closed the IPC socket")
            header += chunk
        size = struct.unpack("<I", header)[0]
        body = b""
        while len(body) < size:
            chunk = sock.recv(size - len(body))
            if not chunk:
                raise ConnectionError("wayfire closed the IPC socket")
            body += chunk
        return json.loads(body)

    def call(self, method, data=None):
        with self.lock:
            # A config/plugin reload may close existing Wayfire IPC clients without changing
            # the socket path. Reopen the connection and retry this request while the Hyprland
            # listener stays up. A later request can retry if Wayfire itself is still down.
            for attempt in range(2):
                try:
                    if self.sock is None:
                        self.sock = self._connect()
                    self.send(self.sock, method, data)
                    return self.receive(self.sock)
                except (ConnectionError, OSError) as error:
                    log(f"wayfire query IPC closed: {error!r}; reconnecting")
                    if self.sock is not None:
                        self.sock.close()
                    self.sock = None
                    if attempt:
                        raise

    def events(self):
        while True:
            sock = None
            try:
                sock = self._connect()
                with self.event_lock:
                    self.event_sock = sock
                self.send(sock, "window-rules/events/watch")
                self.receive(sock)
                while True:
                    yield self.receive(sock)
            except (ConnectionError, OSError) as error:
                log(f"wayfire event IPC closed: {error!r}; reconnecting")
            finally:
                with self.event_lock:
                    if self.event_sock is sock:
                        self.event_sock = None
                if sock is not None:
                    sock.close()
            time.sleep(0.25)

    def drop_connections_for_test(self):
        """Simulate Wayfire closing both IPC clients, only in isolated test sessions."""
        with self.lock:
            if self.sock is not None:
                try:
                    self.sock.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
                self.sock.close()
                self.sock = None
        with self.event_lock:
            if self.event_sock is not None:
                try:
                    self.event_sock.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass


LUA_ESCAPES = {"a": b"\a", "b": b"\b", "f": b"\f", "n": b"\n", "r": b"\r", "t": b"\t", "v": b"\v",
               "\\": b"\\", '"': b'"', "'": b"'"}
LUA_NEWLINE = re.compile(r"\r\n|\n\r|\r|\n")


def lua_utf8(code):
    """Lua's UTF-8 encoding of a \\u{XXX} escape (code points up to 2^31, as Lua allows)."""
    if code < 0x80:
        return bytes([code])
    out, first_max = [], 0x3F
    while True:
        out.append(0x80 | (code & 0x3F))
        code >>= 6
        first_max >>= 1
        if code <= first_max:
            break
    out.append(((~first_max << 1) & 0xFF) | code)
    return bytes(reversed(out))


def lua_string(text, pos=0):
    """Read the Lua string literal at text[pos:] (after spaces): "...", '...', [[...]] or [==[...]==].

    Returns (value, end) or None, the value as the bytes Lua would make of it: escapes such as
    \\195\\169 or \\xC3 are bytes, \\u{E9} is UTF-8, and every line break in a long string is
    one \\n. text is the request as received (decoded with surrogateescape, so any byte survives).
    Omarchy writes commands in any of these forms, e.g. the screensaver's hl.dsp.exec_cmd([[...]]).
    """
    def raw(chars):
        return chars.encode("utf-8", "surrogateescape")

    while pos < len(text) and text[pos].isspace():
        pos += 1
    long = re.compile(r"\[(=*)\[").match(text, pos)
    if long:
        close = "]" + long.group(1) + "]"
        end = text.find(close, long.end())
        if end < 0:
            return None
        value = text[long.end():end]
        first = LUA_NEWLINE.match(value)  # Lua skips a line break right after the opening bracket
        if first:
            value = value[first.end():]
        return raw(LUA_NEWLINE.sub("\n", value)), end + len(close)
    if pos >= len(text) or text[pos] not in "\"'":
        return None
    quote, out, index = text[pos], bytearray(), pos + 1
    while index < len(text):
        char = text[index]
        if char == quote:
            return bytes(out), index + 1
        if char in "\r\n":
            return None  # unfinished string
        if char != "\\":
            out += raw(char)
            index += 1
            continue
        index += 1
        if index >= len(text):
            return None
        char = text[index]
        if char in LUA_ESCAPES:
            out += LUA_ESCAPES[char]
            index += 1
        elif char in "\r\n":  # a backslash before a line break: one \n
            index += LUA_NEWLINE.match(text, index).end() - index
            out += b"\n"
        elif char == "z":  # skip the following whitespace
            index += 1
            while index < len(text) and text[index].isspace():
                index += 1
        elif char == "x":
            digits = text[index + 1:index + 3]
            if not re.fullmatch(r"[0-9A-Fa-f]{2}", digits):
                return None
            out.append(int(digits, 16))
            index += 3
        elif char in "0123456789":
            digits = re.match(r"[0-9]{1,3}", text[index:]).group(0)
            if int(digits) > 255:
                return None  # Lua: decimal escape too large
            out.append(int(digits))
            index += len(digits)
        elif char == "u":
            code = re.match(r"u\{([0-9A-Fa-f]+)\}", text[index:])
            if not code or int(code.group(1), 16) > 0x7FFFFFFF:
                return None
            out += lua_utf8(int(code.group(1), 16))
            index += len(code.group(0))
        else:
            return None  # Lua rejects unknown escapes
    return None


def libexec(name):
    return os.path.join(os.environ.get("SCOTTLAND_HOOKS", "/usr/lib/scottland"), "libexec", name)


def lua_table(text, pos):
    """Read the flat Lua table constructor at text[pos:] ("{ key = value, ... }") whose values are
    string literals, numbers or booleans, as hyprctl eval sends a monitor rule. Returns
    (fields, end) or None for anything else (a variable, an expression, a nested table)."""
    if not text.startswith("{", pos):
        return None
    fields, index = {}, pos + 1
    while True:
        match = re.compile(r"\s*(?:\}|([A-Za-z_]\w*)\s*=\s*)").match(text, index)
        if not match:
            return None
        if match.group(1) is None:
            return fields, match.end()
        key, index = match.group(1), match.end()
        literal = lua_string(text, index)
        if literal:
            fields[key], index = literal[0].decode("utf-8", "surrogateescape"), literal[1]
        else:
            value = re.compile(r"(-?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?|true|false)(?![\w.])").match(text, index)
            if not value:
                return None
            word = value.group(1)
            fields[key] = word == "true" if word in ("true", "false") else float(word)
            index = value.end()
        separator = re.compile(r"\s*([,;]|(?=\}))").match(text, index)
        if not separator:
            return None
        index = separator.end()


class Translator:
    def __init__(self, wayfire):
        self.wf = wayfire
        self.rebuild_timer = None
        self.rebuild_lock = threading.Lock()

    # --- Wayfire state -------------------------------------------------------------------

    def outputs(self):
        return sorted(self.wf.call("window-rules/list-outputs"), key=lambda o: o["id"])

    def focused_output_id(self):
        reply = self.wf.call("window-rules/get-focused-output")
        return (reply.get("info") or {}).get("id")

    def views(self):
        return [v for v in self.wf.call("window-rules/list-views")
                if v.get("role") == "toplevel" and v.get("mapped")]

    def focused_view(self):
        view = (self.wf.call("window-rules/get-focused-view") or {}).get("info")
        return view if view and view.get("role") == "toplevel" else None

    # --- Hyprland objects ----------------------------------------------------------------

    def monitor_index(self, outputs, output_id):
        for index, output in enumerate(outputs):
            if output["id"] == output_id:
                return index
        return -1

    def workspace_ref(self, outputs, output_id):
        index = self.monitor_index(outputs, output_id)
        return {"id": index + 1, "name": str(index + 1)}

    def session_locked(self):
        reply = self.wf.call("scottland/session-state") or {}
        return bool(reply.get("locked"))

    @staticmethod
    def output_power(*args):
        """Run scottland-output-power (DPMS through wlr-output-power-management): (ok, {name: on?}, error)."""
        hooks = os.environ.get("SCOTTLAND_HOOKS", "/usr/lib/scottland")
        try:
            result = subprocess.run([os.path.join(hooks, "libexec/scottland-output-power"), *args],
                                    stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError) as error:
            return False, {}, str(error)
        power = {}
        for line in result.stdout.splitlines():
            try:
                entry = json.loads(line)
                power[entry["name"]] = entry["power"] == "on"
            except (ValueError, KeyError):
                pass
        return result.returncode == 0, power, result.stderr.strip()

    @staticmethod
    def heads():
        """Every output the compositor knows, enabled or not, with its real metadata (core's
        scottland-output-heads, wlr-output-management): {name: head}, or {} if unavailable."""
        try:
            result = subprocess.run([libexec("scottland-output-heads")], stdin=subprocess.DEVNULL,
                                    capture_output=True, text=True, timeout=5)
            if result.returncode == 0:
                return {head["name"]: head for head in json.loads(result.stdout)}
            log(f"output metadata unavailable: {result.stderr.strip()}")
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            log(f"output metadata unavailable: {error!r}")
        return {}

    @staticmethod
    def head_fields(head, fallback_size=(0, 0)):
        """The Hyprland monitor fields that come from an output's own metadata."""
        head = head or {}
        mode = head.get("mode") or {}
        name = head.get("name", "")
        return {
            "description": hyprmonitor.describe(head) or head.get("description") or name,
            "make": head.get("make", ""), "model": head.get("model", ""), "serial": head.get("serial", ""),
            # Hyprland reports the mode's pixels (not the scaled layout size) and its refresh rate.
            "width": int(mode.get("width") or fallback_size[0]),
            "height": int(mode.get("height") or fallback_size[1]),
            "physicalWidth": head.get("physical_width", 0), "physicalHeight": head.get("physical_height", 0),
            "refreshRate": float(mode.get("refresh") or 0.0),
            "scale": head.get("scale", 1), "transform": head.get("transform", 0),
            "vrr": bool(head.get("adaptive_sync")),
            "availableModes": [f"{m['width']}x{m['height']}@{m['refresh']:.2f}Hz"
                               for m in head.get("modes", [])],
        }

    def monitor(self, outputs, output, focused_id, locked=False, power=None, head=None):
        geometry, workarea = output["geometry"], output["workarea"]
        reserved = [
            int(workarea["x"] - geometry["x"]),
            int(workarea["y"] - geometry["y"]),
            int(geometry["x"] + geometry["width"] - workarea["x"] - workarea["width"]),
            int(geometry["y"] + geometry["height"] - workarea["y"] - workarea["height"]),
        ]
        scale = (head or {}).get("scale", 1)
        return {
            "id": self.monitor_index(outputs, output["id"]),
            "name": output["name"],
            **self.head_fields(head, (round(geometry["width"] * scale), round(geometry["height"] * scale))),
            "x": int(geometry["x"]), "y": int(geometry["y"]),
            "activeWorkspace": self.workspace_ref(outputs, output["id"]),
            "specialWorkspace": {"id": 0, "name": ""},
            "reserved": reserved,
            "focused": output["id"] == focused_id,
            "dpmsStatus": (power or {}).get(output["name"], True),
            # omarchy-hyprland-session-locked reads the session lock from here: Hyprland lists
            # "LOCK" among the reasons a monitor can't go solitary while a lock holds the session,
            # including one whose lock client died.
            "solitary": "0", "solitaryBlockedBy": ["LOCK", "CANDIDATE"] if locked else ["CANDIDATE"],
            "activelyTearing": False, "tearingBlockedBy": ["CANDIDATE"],
            "directScanoutTo": "0", "directScanoutBlockedBy": ["CANDIDATE"],
            "disabled": False, "currentFormat": "XRGB8888", "mirrorOf": "none",
            "colorManagementPreset": "srgb",
            "sdrBrightness": 1, "sdrSaturation": 1, "sdrMinLuminance": 0.2, "sdrMaxLuminance": 80,
            "hardwareCursorsInUse": True,
        }

    def client(self, outputs, view, focus_order):
        geometry = view["geometry"]
        return {
            "address": address(view["id"]),
            "mapped": True, "hidden": bool(view.get("minimized")), "visible": not view.get("minimized"),
            "acceptsInput": bool(view.get("focusable", True)),
            "at": [int(geometry["x"]), int(geometry["y"])],
            "size": [int(geometry["width"]), int(geometry["height"])],
            "workspace": self.workspace_ref(outputs, view.get("output-id")),
            "floating": view.get("tiled-edges", 0) == 0,
            "monitor": self.monitor_index(outputs, view.get("output-id")),
            "class": view.get("app-id", ""), "title": view.get("title", ""),
            "initialClass": view.get("app-id", ""), "initialTitle": view.get("title", ""),
            "pid": view.get("pid", -1), "xwayland": bool(view.get("xwayland", False)),
            "pinned": bool(view.get("sticky")), "pinFullscreened": False,
            "fullscreen": 2 if view.get("fullscreen") else 0, "fullscreenClient": 0,
            "fullscreenHandler": "default", "allowedOverFullscreen": False,
            "grouped": [],
            "tags": ["terminal*"] if TERMINAL_CLASS.fullmatch(view.get("app-id", "")) else [],
            "swallowing": "0x0",
            "focusHistoryID": focus_order.get(view["id"], 0),
            "inhibitingIdle": False, "xdgTag": "", "xdgDescription": "",
            "contentType": "none", "tearingHint": False,
            # Contract: the Scottland window id in hex, so Hyprland-speaking clients can reach
            # Scottland's own requests (e.g. scottland/present) for a window they listed here.
            "stableId": f"{view['id']:08x}",
        }

    def clients(self):
        outputs, views = self.outputs(), self.views()
        ranked = sorted(views, key=lambda v: v.get("last-focus-timestamp", 0), reverse=True)
        focus_order = {v["id"]: i for i, v in enumerate(ranked)}
        return [self.client(outputs, v, focus_order) for v in views]

    def disabled_monitor(self, head, monitor_id):
        """A connected output that is turned off, as `monitors all` lists it."""
        preferred = next((m for m in head.get("modes", []) if m.get("preferred")), None)
        fields = self.head_fields(head)
        if preferred:
            fields.update(width=preferred["width"], height=preferred["height"],
                          refreshRate=float(preferred["refresh"]))
        return {
            "id": monitor_id, "name": head["name"], **fields,
            "x": head.get("x", 0), "y": head.get("y", 0),
            "activeWorkspace": {"id": -1, "name": ""}, "specialWorkspace": {"id": 0, "name": ""},
            "reserved": [0, 0, 0, 0], "focused": False, "dpmsStatus": False,
            "solitary": "0", "solitaryBlockedBy": ["CANDIDATE"],
            "activelyTearing": False, "tearingBlockedBy": ["CANDIDATE"],
            "directScanoutTo": "0", "directScanoutBlockedBy": ["CANDIDATE"],
            "disabled": True, "currentFormat": "XRGB8888", "mirrorOf": "none",
            "colorManagementPreset": "srgb",
            "sdrBrightness": 1, "sdrSaturation": 1, "sdrMinLuminance": 0.2, "sdrMaxLuminance": 80,
            "hardwareCursorsInUse": False,
        }

    def monitors(self, include_disabled=False):
        """`monitors`: the enabled outputs; `monitors all` adds the connected ones turned off."""
        outputs, focused = self.outputs(), self.focused_output_id()
        locked = self.session_locked()
        ok, power, error = self.output_power("status")
        if not ok:
            log(f"output power state unavailable: {error}")
        heads = self.heads()
        result = [self.monitor(outputs, o, focused, locked, power, heads.get(o["name"])) for o in outputs]
        if include_disabled:
            enabled = {o["name"] for o in outputs}
            for head in heads.values():
                if head["name"] not in enabled:
                    result.append(self.disabled_monitor(head, len(result)))
        return result

    def workspaces(self):
        outputs, views = self.outputs(), self.views()
        result = []
        for index, output in enumerate(outputs):
            here = sorted((v for v in views if v.get("output-id") == output["id"]),
                          key=lambda v: v.get("last-focus-timestamp", 0), reverse=True)
            result.append({
                "id": index + 1, "name": str(index + 1),
                "monitor": output["name"], "monitorID": index,
                "windows": len(here), "hasfullscreen": any(v.get("fullscreen") for v in here),
                "lastwindow": address(here[0]["id"]) if here else "0x0",
                "lastwindowtitle": here[0].get("title", "") if here else "",
                "ispersistent": False, "tiledLayout": "scottland",
            })
        return result

    def active_workspace(self):
        focused = self.focused_output_id()
        for workspace, output in zip(self.workspaces(), self.outputs()):
            if output["id"] == focused:
                return workspace
        return {}

    def active_window(self):
        view = self.focused_view()
        if not view:
            return {}
        return self.client(self.outputs(), view, {view["id"]: 0})

    def devices(self):
        devices = {"mice": [], "keyboards": [], "tablets": [], "touch": [], "switches": []}
        keyboard_state = self.wf.call("wayfire/get-keyboard-state") or {}
        layouts = keyboard_state.get("possible-layouts") or []
        layout = keyboard_state.get("layout", "")
        for index, device in enumerate(self.wf.call("input/list-devices") or []):
            kind = device.get("type", "")
            entry = {"address": address(10_000 + index), "name": device.get("name", "")}
            if kind == "keyboard":
                entry.update({
                    "rules": "", "model": "", "layout": OPTIONS["input:kb_layout"]["str"],
                    "variant": "", "options": "",
                    "active_layout_index": layouts.index(layout) if layout in layouts else 0,
                    "active_keymap": layout, "capsLock": False, "numLock": False,
                    "main": not devices["keyboards"],
                })
                devices["keyboards"].append(entry)
            elif kind in ("pointer", "mouse"):
                entry.update({"defaultSpeed": 0.0, "scrollFactor": -1.0})
                devices["mice"].append(entry)
            elif kind in ("touch", "touchscreen"):
                devices["touch"].append(entry)
            elif kind in ("tablet", "tablet-tool", "tablet-pad"):
                devices["tablets"].append(entry)
            elif kind == "switch":
                devices["switches"].append(entry)
        return devices

    # --- Actions -------------------------------------------------------------------------

    WINDOW_ADDRESS = re.compile(r'address:(0x[0-9a-fA-F]+)')
    LUA_FIELD = re.compile(r'(\w+)\s*=\s*"([^"]*)"')

    EXEC_LUA = re.compile(r'^hl\.dsp\.exec_cmd\s*\(')

    DPMS_LUA = re.compile(r'^hl\.dsp\.dpms\s*\(')
    DPMS_CLASSIC = re.compile(r'^dpms(?:\s+(on|off|toggle))?(?:\s+(\S+))?\s*$')
    DPMS_ACTIONS = {"enable": "on", "on": "on", "disable": "off", "off": "off", "toggle": "toggle",
                    None: "toggle"}

    def dpms(self, text, match):
        """Turn displays off/on: hl.dsp.dpms({ action = "disable", monitor = "eDP-1" }) or the
        classic `dpms off [name]`. Applied by the compositor's power management; the reply says
        whether it took effect."""
        if match.re is self.DPMS_LUA:
            fields = dict(self.LUA_FIELD.findall(text))
            action, monitor = fields.get("action"), fields.get("monitor")
        else:
            action, monitor = match.group(1), match.group(2)
        if action not in self.DPMS_ACTIONS:
            return f"error: unknown dpms action {action!r}"
        args = (["--output", monitor] if monitor else []) + [self.DPMS_ACTIONS[action]]
        ok, _power, error = self.output_power(*args)
        return "ok" if ok else f"error: dpms {self.DPMS_ACTIONS[action]} failed: {error or 'refused'}"

    @classmethod
    def exec_command(cls, text):
        """The command (bytes) of an exec dispatch: hl.dsp.exec_cmd(<Lua string>, ...) or classic
        `exec`."""
        text = text.strip()
        match = cls.EXEC_LUA.match(text)
        if match:
            literal = lua_string(text, match.end())
            if literal and re.match(r"\s*[,)]", text[literal[1]:]):
                return literal[0]
            return None
        return text[5:].encode("utf-8", "surrogateescape") if text.startswith("exec ") else None

    def dispatch(self, text):
        """Translate the window dispatches the shell uses; everything else is a logged no-op."""
        # Run a command in this session, like Hyprland's exec dispatcher (Lua or classic form).
        command = self.exec_command(text)
        if command:
            subprocess.Popen(["sh", "-c", command], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return "ok"
        dpms = self.DPMS_LUA.match(text.strip()) or self.DPMS_CLASSIC.match(text.strip())
        if dpms:
            return self.dpms(text.strip(), dpms)
        if "send_key_state" in text or "send_shortcut" in text:
            # hl.dsp.send_key_state({ key = "Insert", mods = "CTRL", state = "down" })
            fields = dict(self.LUA_FIELD.findall(text))
            reply = self.wf.call("scottland/send-key", {
                "key": fields.get("key", ""), "mods": fields.get("mods", ""),
                "state": fields.get("state", "press"),
            })
            if reply.get("error"):
                log(f"send-key failed: {reply['error']} ({text[:120]})")
                return f"error: {reply['error']}"
            return "ok"
        match = self.WINDOW_ADDRESS.search(text)
        if match and ("window.close" in text or "closewindow" in text):
            reply = self.wf.call("window-rules/close-view", {"id": view_id_from_address(match.group(1))})
            return f"error: {reply['error']}" if reply.get("error") else "ok"
        if match and ("focus" in text):
            reply = self.wf.call("window-rules/focus-view", {"id": view_id_from_address(match.group(1))})
            return f"error: {reply['error']}" if reply.get("error") else "ok"
        log.unsupported(f"dispatch {text}")
        return unsupported(f"dispatch {text}")

    @staticmethod
    def reload():
        """Re-read the Hyprland config now, as far as Scottland translates it: rebuild the session's
        config (imported shortcuts, monitor rules, Lua host), the same rebuild its config watcher
        runs when the files change, and answer once Wayfire has applied it (its outputs too), as
        Hyprland answers after its reload. Monitor rules set with `hyprctl eval` end here, as in
        Hyprland: this session's output settings are dropped (core scottland-output reset). Omarchy
        runs `hyprctl reload` after changes the watcher can't see, such as installing Voxtype,
        whose F9 shortcuts depend on the command being present, or writing a monitor toggle."""
        try:
            result = subprocess.run([libexec("scottland-output"), "reset"], stdin=subprocess.DEVNULL,
                                    capture_output=True, text=True, timeout=90)
        except (OSError, subprocess.SubprocessError) as error:
            return f"error: config rebuild failed: {error}"
        if result.returncode != 0:
            lines = [line.removeprefix("scottland-output: ")
                     for line in result.stderr.strip().splitlines() if line.strip()]
            return "error: " + " | ".join(lines[-2:])[:400]
        return "ok"

    def schedule_rebuild(self):
        """Rebuild the config shortly after an output appears: Hyprland's catch-all and desc:
        monitor rules name no output, so they are written for the outputs present at each build."""
        def rebuild():
            subprocess.run([libexec("scottland-build-config")], stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60, check=False)
        with self.rebuild_lock:
            if self.rebuild_timer:
                self.rebuild_timer.cancel()
            self.rebuild_timer = threading.Timer(0.5, rebuild)
            self.rebuild_timer.daemon = True
            self.rebuild_timer.start()

    MONITOR_EVAL = re.compile(r"^\s*hl\.monitor\s*\(\s*")

    def eval(self, code):
        """`hyprctl eval "hl.monitor({ output = …, mode = …, position = …, scale = … })"`: apply the
        rule to that output now, through core's output control, until the next `hyprctl reload`
        (as in Hyprland). Other Lua is not run."""
        match = self.MONITOR_EVAL.match(code)
        table = lua_table(code, match.end()) if match else None
        if not table or not re.fullmatch(r"\s*\)\s*;?\s*", code[table[1]:]):
            log.unsupported(f"eval {code}")
            return unsupported(f"eval {code}")
        output, settings, notes = hyprmonitor.translate(table[0])
        if not hyprmonitor.NAME.fullmatch(output):
            return f"error: unsupported in Scottland: eval hl.monitor for output {output!r} (only a named output)"
        try:
            result = subprocess.run([libexec("scottland-output"), "set", output,
                                     *hyprmonitor.set_arguments(settings)],
                                    stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90)
        except (OSError, subprocess.SubprocessError) as error:
            return f"error: {error}"
        if result.returncode != 0:
            lines = [line.removeprefix("scottland-output: ")
                     for line in result.stderr.strip().splitlines() if line.strip()]
            return "error: " + " | ".join(lines[-2:])[:400]
        if notes:
            return "error: not applied in Scottland: " + "; ".join(notes)
        return "ok"

    # --- Requests ------------------------------------------------------------------------

    def handle(self, raw):
        request = raw.strip()
        if request.startswith("[[BATCH]]"):
            return "\n\n".join(self.handle(part) for part in request[9:].split(";") if part.strip())

        flags = ""
        head, _, rest = request.partition(" ")
        if "/" in head and re.fullmatch(r"[a-z]{0,4}", head.split("/", 1)[0]):
            flags, head = head.split("/", 1)
        command, args = head, rest.strip()
        as_json = "j" in flags

        try:
            reply = self.query(command, args, as_json)
        except Exception as error:  # noqa: BLE001 - one bad request must not kill the shim
            log(f"error handling {request!r}: {error!r}")
            return f"error: {error}"

        if isinstance(reply, str):
            return reply
        return json.dumps(reply, indent=4) if as_json else self.plain(command, reply)

    def query(self, command, args, as_json=False):
        if command == "scottland-test-drop-ipc" and os.environ.get("SCOTTLAND_TEST_MODEL") == "1":
            self.wf.drop_connections_for_test()
            return "ok"
        if command == "monitors":
            return self.monitors(include_disabled=args.split(" ", 1)[0] == "all")
        if command == "workspaces":
            return self.workspaces()
        if command == "activeworkspace":
            return self.active_workspace()
        if command == "clients":
            return self.clients()
        if command == "activewindow":
            return self.active_window()
        if command == "devices":
            return self.devices()
        if command == "plugin" and args.split(" ", 1)[0] == "list":
            return [] if as_json else "no plugins loaded"
        if command == "configerrors":
            return [] if as_json else ""
        if command == "status":
            return {"configProvider": "scottland", "backend": "wayfire"}
        if command == "version":
            return VERSION
        if command == "getoption":
            if args in OPTIONS:
                return {"option": args, **OPTIONS[args], "set": True}
            log.unsupported(f"getoption {args}")
            return unsupported(f"getoption {args}")
        if command == "dispatch":
            return self.dispatch(args)
        if command == "reload":
            return self.reload()
        if command == "eval":
            return self.eval(args)
        # Everything else (keyword, other eval, switchxkblayout, layers, binds, cursorpos, ...) has no
        # translation yet. Report that to the caller instead of answering a false "ok".
        log.unsupported(f"{command} {args}")
        return unsupported(f"{command} {args}")

    @staticmethod
    def plain(command, reply):
        """Rough text form for callers that don't ask for JSON."""
        if isinstance(reply, list):
            return "\n\n".join(Translator.plain(command, item) for item in reply) or ""
        return "\n".join(f"\t{k}: {v}" for k, v in reply.items())

    # --- Events --------------------------------------------------------------------------

    def event_lines(self, event, state):
        kind, view = event.get("event"), event.get("view")
        lines = []
        is_window = bool(view) and view.get("role") == "toplevel"

        def focused_monitor(output_id):
            if output_id is None or output_id == state.get("output"):
                return
            state["output"] = output_id
            outputs = self.outputs()
            for index, output in enumerate(outputs):
                if output["id"] == output_id:
                    lines.append(f"focusedmon>>{output['name']},{index + 1}")
                    lines.append(f"focusedmonv2>>{output['name']},{index + 1}")
                    lines.append(f"workspace>>{index + 1}")
                    lines.append(f"workspacev2>>{index + 1},{index + 1}")

        if kind == "view-mapped" and is_window:
            ws = self.workspace_ref(self.outputs(), view.get("output-id"))["name"]
            lines.append(f"openwindow>>{address(view['id'], '')},{ws},{view.get('app-id', '')},{view.get('title', '')}")
        elif kind == "view-unmapped" and is_window:
            lines.append(f"closewindow>>{address(view['id'], '')}")
        elif kind == "view-focused":
            if is_window:
                lines.append(f"activewindow>>{view.get('app-id', '')},{view.get('title', '')}")
                lines.append(f"activewindowv2>>{address(view['id'], '')}")
                focused_monitor(view.get("output-id"))
            elif view is None:
                lines += ["activewindow>>,", "activewindowv2>>"]
        elif kind == "view-title-changed" and is_window and view.get("mapped"):
            lines.append(f"windowtitle>>{address(view['id'], '')}")
            lines.append(f"windowtitlev2>>{address(view['id'], '')},{view.get('title', '')}")
            if view.get("activated"):
                lines.append(f"activewindow>>{view.get('app-id', '')},{view.get('title', '')}")
        elif kind == "view-set-output" and is_window and view.get("mapped") and event.get("output"):
            ws = self.workspace_ref(self.outputs(), event["output"]["id"])
            lines.append(f"movewindow>>{address(view['id'], '')},{ws['name']}")
            lines.append(f"movewindowv2>>{address(view['id'], '')},{ws['id']},{ws['name']}")
        elif kind == "view-fullscreen" and is_window:
            lines.append(f"fullscreen>>{1 if view.get('fullscreen') else 0}")
        elif kind == "output-gain-focus" and event.get("output"):
            focused_monitor(event["output"]["id"])
        return lines


class Server:
    def __init__(self, translator, directory):
        self.translator = translator
        self.directory = directory
        self.listeners = []
        self.listeners_lock = threading.Lock()

    def listen(self, name):
        path = os.path.join(self.directory, name)
        if os.path.exists(path):
            os.unlink(path)
        sock = socket.socket(socket.AF_UNIX)
        sock.bind(path)
        sock.listen(64)
        return sock

    def serve_requests(self, sock):
        while True:
            conn, _ = sock.accept()
            threading.Thread(target=self.answer, args=(conn,), daemon=True).start()

    def answer(self, conn):
        try:
            conn.settimeout(2)
            # surrogateescape: bytes that aren't UTF-8 (e.g. in a command) reach handlers intact.
            request = conn.recv(65536).decode(errors="surrogateescape")
            conn.sendall(self.translator.handle(request).encode(errors="surrogateescape"))
        except OSError:
            pass
        finally:
            conn.close()

    def serve_events(self, sock):
        while True:
            conn, _ = sock.accept()
            with self.listeners_lock:
                self.listeners.append(conn)

    def broadcast(self, lines):
        if not lines:
            return
        data = ("\n".join(lines) + "\n").encode()
        with self.listeners_lock:
            alive = []
            for conn in self.listeners:
                try:
                    conn.sendall(data)
                    alive.append(conn)
                except OSError:
                    conn.close()
            self.listeners = alive

    def pump_events(self):
        state = {"output": None}
        for event in self.translator.wf.events():
            try:
                if event.get("event") == "output-added":
                    self.translator.schedule_rebuild()
                self.broadcast(self.translator.event_lines(event, state))
            except Exception as error:  # noqa: BLE001
                log(f"error translating event {event.get('event')}: {error!r}")


def main():
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    wayfire_socket = os.environ.get("WAYFIRE_SOCKET")
    if not signature or not wayfire_socket:
        sys.exit("scottland-hyprshim: needs HYPRLAND_INSTANCE_SIGNATURE and WAYFIRE_SOCKET "
                 "(run it from a Scottland session with the ipc plugins enabled)")

    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    directory = os.path.join(runtime, "hypr", signature)
    os.makedirs(directory, mode=0o700, exist_ok=True)

    wayfire = Wayfire(wayfire_socket)
    server = Server(Translator(wayfire), directory)
    requests, events = server.listen(".socket.sock"), server.listen(".socket2.sock")
    with open(os.path.join(directory, "hyprland.lock"), "w") as lock:
        lock.write(f"{os.getpid()}\n{os.environ.get('WAYLAND_DISPLAY', '')}\n")
    log(f"serving {directory} for {wayfire_socket}")

    threading.Thread(target=server.serve_requests, args=(requests,), daemon=True).start()
    threading.Thread(target=server.serve_events, args=(events,), daemon=True).start()
    server.pump_events()  # reconnects without dropping the two Hyprland listeners


if __name__ == "__main__":
    main()
