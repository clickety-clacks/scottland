#!/bin/sh
# Restart this session's Lua host so it picks up an updated host and the current Hyprland config.
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/scottland"
pid_file="$runtime/${WAYLAND_DISPLAY:-wayland}.lua.pid"
if [ -f "$pid_file" ]; then
  pid=$(cat "$pid_file")
  # Only stop it if that pid is still our Lua host.
  if [ -n "$pid" ] && grep -q scottland-luahost "/proc/$pid/cmdline" 2>/dev/null; then
    kill "$pid"
    sleep 0.3
  fi
fi
state="${XDG_STATE_HOME:-$HOME/.local/state}/scottland"
mkdir -p "$state"
setsid -f "${SCOTTLAND_HOOKS:-/usr/lib/scottland}/libexec/scottland-luahost" 2>>"$state/luahost.log" </dev/null >/dev/null
