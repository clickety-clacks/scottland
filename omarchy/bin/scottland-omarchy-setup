#!/bin/bash
# Per-user setup for Omarchy: add "Switch to Scottland" to the Omarchy menu (System submenu).
# Omarchy only reads menu additions from the user's extension file, so a package can't ship this.
set -euo pipefail

script_dir=$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")
theme_source=${SCOTTLAND_OMARCHY_THEMES_DIR:-}
if [[ -z $theme_source ]]; then
  if [[ $script_dir == */omarchy/bin &&
        -d $script_dir/../themes/watercolor-dream-light &&
        -d $script_dir/../themes/watercolor-dream-dark ]]; then
    theme_source=$script_dir/../themes
  else
    theme_source=/usr/share/scottland-omarchy/themes
  fi
fi
themes=(watercolor-dream-light watercolor-dream-dark)
for theme in "${themes[@]}"; do
  [[ -d $theme_source/$theme ]] || {
    echo "scottland-omarchy-setup: missing shipped theme $theme in $theme_source" >&2
    exit 1
  }
done

menu=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc
theme_dir=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes
entries=(
  'system.scottland|  "system.scottland": {"icon":"󰍹","label":"Switch Desktop","description":"Scottland or Hyprland","action":"scottland-switch"},'
  'system.scottland-reload|  "system.scottland-reload": {"icon":"󰑓","label":"Reload Scottland","description":"Load updates in place","when":"printenv WAYFIRE_SOCKET >/dev/null","action":"scottland-reload"},'
  'system.scottland-layout|  "system.scottland-layout": {"icon":"󰕰","label":"Scottland Settings","description":"Zone widths and scaling","action":"scottland-settings"},'
)

mkdir -p "$(dirname "$menu")"
[[ -f $menu ]] || printf '{\n}\n' >"$menu"
backed_up=false
for item in "${entries[@]}"; do
  id=${item%%|*} entry=${item#*|}
  grep -q "\"$id\"" "$menu" && continue
  $backed_up || { cp "$menu" "$menu.bak.scottland"; backed_up=true; }
  # Insert right after the opening brace so it stays valid whatever follows. The entry goes in
  # through the environment: awk -v would process backslash escapes and break JSON quoting.
  ENTRY=$entry awk '!done && /^[[:space:]]*\{[[:space:]]*$/ {print; print ENVIRON["ENTRY"]; done=1; next} {print}' \
    "$menu" >"$menu.tmp" && mv "$menu.tmp" "$menu"
  echo "Added ${id#system.} to Omarchy menu > System."
done

# Check the file still parses the way Omarchy reads it (line comments and trailing commas
# allowed); if not, put the backup back rather than leave the user without their menu.
if ! python3 - "$menu" <<'PY'
import json, re, sys
raw = open(sys.argv[1]).read()
raw = re.sub(r"(?m)^\s*//[^\n]*(\n|$)", "", raw)
raw = re.sub(r",(\s*[}\]])", r"\1", raw)
json.loads(raw)
PY
then
  $backed_up && cp "$menu.bak.scottland" "$menu"
  echo "scottland-omarchy-setup: the menu file would not parse; restored the backup." >&2
  exit 1
fi
$backed_up && echo "Backup: $menu.bak.scottland" || echo "Omarchy menu already has the Scottland entries."

mkdir -p "$theme_dir"
for theme in "${themes[@]}"; do
  destination=$theme_dir/$theme
  if [[ -e $destination || -L $destination ]]; then
    echo "Kept existing theme $theme at $destination."
  else
    cp -a -- "$theme_source/$theme" "$destination"
    echo "Installed $theme at $destination."
  fi
done

# Generate and show the current report at setup. The adapter records the report digest so session
# startup will not open the same content again. Prefer the active dev snapshot when present.
hooks=${SCOTTLAND_HOOKS:-}
if [[ -z $hooks || ! -x $hooks/config.d/50-omarchy-shortcuts ]]; then
  dev_hooks=${XDG_DATA_HOME:-$HOME/.local/share}/scottland/dev
  if [[ -x $dev_hooks/config.d/50-omarchy-shortcuts ]]; then
    hooks=$dev_hooks
  elif [[ -x $script_dir/../config.d/50-omarchy-shortcuts ]]; then
    hooks=$(dirname "$script_dir")
    export WAYFIRE_PLUGIN_XML_PATH="$hooks/../core/plugin/metadata${WAYFIRE_PLUGIN_XML_PATH:+:$WAYFIRE_PLUGIN_XML_PATH}"
  else
    hooks=/usr/lib/scottland
  fi
fi
export SCOTTLAND_HOOKS=$hooks
if [[ -x $hooks/config.d/50-omarchy-shortcuts ]]; then
  "$hooks/config.d/50-omarchy-shortcuts" --report-only --show-pending
else
  echo "scottland-omarchy-setup: shortcut report generator not found under $hooks" >&2
fi
