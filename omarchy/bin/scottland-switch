#!/bin/bash
# Switch between Scottland and Hyprland.
#
#   scottland-switch                       show the switch dialog
#   scottland-switch --to <scottland|hyprland> [--close|--keep]
#
# --close ends the current session (apps close); --keep leaves it running on its own VT.
# Without either, the remembered choice from the dialog is used (default: close).
set -euo pipefail

helper=/usr/lib/scottland/scottland-session-helper
settings=${XDG_CONFIG_HOME:-$HOME/.config}/scottland/switch.json
dialog=/usr/share/scottland/switch-dialog

current() {
  [[ ${XDG_CURRENT_DESKTOP:-} == *Scottland* ]] && echo scottland || echo hyprland
}

other() {
  [[ $(current) == scottland ]] && echo hyprland || echo scottland
}

remembered_mode() {
  local close=true
  [[ -r $settings ]] && close=$(jq -r 'if .closeCurrent == false then "false" else "true" end' "$settings" 2>/dev/null || echo true)
  [[ $close == false ]] && echo keep || echo close
}

target="" mode=""
while (($#)); do
  case $1 in
    --to) target=${2:-}; shift ;;
    --close) mode=close ;;
    --keep) mode=keep ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

if [[ -z $target ]]; then
  OTHER=$(other) CURRENT=$(current) SETTINGS=$settings exec qs -p "$dialog"
fi

[[ $target == scottland || $target == hyprland ]] || { echo "--to must be scottland or hyprland" >&2; exit 2; }
[[ $target == "$(current)" ]] && { echo "already in $target" >&2; exit 0; }
mode=${mode:-$(remembered_mode)}

if [[ $mode == close && $(current) == hyprland ]]; then
  # Let apps shut down cleanly (browsers save their tabs) before the session ends.
  command -v omarchy-osd >/dev/null && omarchy-osd -i logout -m "Switching to Scottland" -d 5000 || true
  command -v omarchy-hyprland-window-close-all >/dev/null && omarchy-hyprland-window-close-all || true
  sleep 1
fi

exec pkexec "$helper" switch "$target" "$mode" "${XDG_SESSION_ID:-}"
