#!/bin/bash
# Switch between Scottland and Hyprland. Switching closes the current desktop and its windows.
#
#   scottland-switch                       show the switch dialog
#   scottland-switch --to <scottland|hyprland>
set -euo pipefail

helper=/usr/lib/scottland/scottland-session-helper
dialog=/usr/share/scottland/switch-dialog

# The switch dialog used to remember whether to keep the current desktop running; that option is
# gone (switching always closes it), so its saved choice is removed rather than left behind.
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/scottland/switch.json"

current() {
  [[ ${XDG_CURRENT_DESKTOP:-} == *Scottland* ]] && echo scottland || echo hyprland
}

other() {
  [[ $(current) == scottland ]] && echo hyprland || echo scottland
}

target=""
while (($#)); do
  case $1 in
    --to) target=${2:-}; shift ;;
    -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

if [[ -z $target ]]; then
  OTHER=$(other) CURRENT=$(current) exec qs -p "$dialog"
fi

[[ $target == scottland || $target == hyprland ]] || { echo "--to must be scottland or hyprland" >&2; exit 2; }
[[ $target == "$(current)" ]] && { echo "already in $target" >&2; exit 0; }

if [[ $(current) == hyprland ]]; then
  # Let apps shut down cleanly (browsers save their tabs) before the session ends.
  command -v omarchy-osd >/dev/null && omarchy-osd -i logout -m "Switching to Scottland" -d 5000 || true
  command -v omarchy-hyprland-window-close-all >/dev/null && omarchy-hyprland-window-close-all || true
  sleep 1
fi

exec pkexec "$helper" switch "$target" close "${XDG_SESSION_ID:-}"
