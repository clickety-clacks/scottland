# Local build: cd packaging/arch && makepkg -si
pkgbase=scottland
pkgname=(scottland scottland-omarchy)
pkgver=0.1.0
pkgrel=1
pkgdesc="Spatial desktop on Wayfire, after Scott Jenson's working-memory concept"
arch=('x86_64')
license=('MIT')
makedepends=('meson' 'ninja' 'wayfire' 'glm' 'libinput' 'cairo')
options=('!debug')

_root="$startdir/../.."

build() {
  arch-meson "$_root/core/plugin" build
  meson compile -C build
}

package_scottland() {
  # quickshell: the default widget (card) and the layout settings app
  depends=('wayfire' 'cairo' 'inotify-tools' 'python' 'python-dbus' 'python-gobject' 'glib2' 'quickshell')
  optdepends=('geoclue: automatic location for Sunlight')

  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$_root/core/config/scottland.ini" "$pkgdir/usr/share/scottland/scottland.ini"
  install -Dm755 "$_root/core/session/start-scottland" "$pkgdir/usr/bin/start-scottland"
  install -Dm644 "$_root/core/systemd/scottland-session.target" "$pkgdir/usr/lib/systemd/user/scottland-session.target"
  install -Dm644 "$_root/core/systemd/scottland-session-watch@.service" "$pkgdir/usr/lib/systemd/user/scottland-session-watch@.service"
  install -Dm644 "$_root/core/session/scottland.desktop" "$pkgdir/usr/share/wayland-sessions/scottland.desktop"
  install -Dm755 "$_root/core/session/scottland-autostart" "$pkgdir/usr/lib/scottland/libexec/scottland-autostart"
  install -Dm755 "$_root/core/session/scottland-build-config" "$pkgdir/usr/lib/scottland/libexec/scottland-build-config"
  install -Dm755 "$_root/core/autostart.d/06-watch-config" "$pkgdir/usr/lib/scottland/autostart.d/06-watch-config"
  install -Dm755 "$_root/core/libexec/scottland-ctl" "$pkgdir/usr/lib/scottland/libexec/scottland-ctl"
  install -Dm755 "$_root/core/libexec/scottland-exec" "$pkgdir/usr/lib/scottland/libexec/scottland-exec"
  ln -s /usr/lib/scottland/libexec/scottland-exec "$pkgdir/usr/bin/scottland-exec"
  ln -s /usr/lib/scottland/libexec/scottland-ctl "$pkgdir/usr/bin/scottland-ctl"
  install -Dm644 "$_root/core/agents/skills/scottland/SKILL.md" "$pkgdir/usr/share/scottland/agents/skills/scottland/SKILL.md"
  install -Dm755 "$_root/core/autostart.d/02-link-agent-skills" "$pkgdir/usr/lib/scottland/autostart.d/02-link-agent-skills"
  install -Dm755 "$_root/core/libexec/scottland-widget-spawn" "$pkgdir/usr/lib/scottland/libexec/scottland-widget-spawn"
  install -Dm755 "$_root/core/libexec/scottland-widget-launch" "$pkgdir/usr/lib/scottland/libexec/scottland-widget-launch"
  install -Dm755 "$_root/core/libexec/scottland-widget-bus" "$pkgdir/usr/lib/scottland/libexec/scottland-widget-bus"
  install -Dm755 "$_root/core/autostart.d/08-widget-bus" "$pkgdir/usr/lib/scottland/autostart.d/08-widget-bus"
  install -Dm755 "$_root/core/libexec/scottland-attention-sources" "$pkgdir/usr/lib/scottland/libexec/scottland-attention-sources"
  install -Dm755 "$_root/core/libexec/scottland-focus-mode" "$pkgdir/usr/lib/scottland/libexec/scottland-focus-mode"
  install -Dm755 "$_root/core/autostart.d/09-attention-sources" "$pkgdir/usr/lib/scottland/autostart.d/09-attention-sources"
  install -Dm755 "$_root/core/reload.d/09-attention-sources" "$pkgdir/usr/lib/scottland/reload.d/09-attention-sources"
  install -Dm755 "$_root/core/reload.d/08-widget-bus" "$pkgdir/usr/lib/scottland/reload.d/08-widget-bus"
  install -Dm644 "$_root/core/widgets/card/widget.toml" "$pkgdir/usr/lib/scottland/widgets/card/widget.toml"
  install -Dm644 "$_root/core/widgets/card/shell.qml" "$pkgdir/usr/lib/scottland/widgets/card/shell.qml"
  install -Dm755 "$_root/core/autostart.d/01-record-environment" "$pkgdir/usr/lib/scottland/autostart.d/01-record-environment"
  install -Dm755 "$_root/core/libexec/scottland-color-scheme" "$pkgdir/usr/lib/scottland/libexec/scottland-color-scheme"
  install -Dm755 "$_root/core/autostart.d/07-follow-color-scheme" "$pkgdir/usr/lib/scottland/autostart.d/07-follow-color-scheme"
  install -Dm755 "$_root/core/autostart.d/07-solar-theme" "$pkgdir/usr/lib/scottland/autostart.d/07-solar-theme"
  install -Dm755 "$_root/core/libexec/scottland-solar-theme" "$pkgdir/usr/lib/scottland/libexec/scottland-solar-theme"
  install -Dm755 "$_root/core/reload.d/07-color-scheme" "$pkgdir/usr/lib/scottland/reload.d/07-color-scheme"
  install -Dm755 "$_root/core/config.d/20-layout-settings" "$pkgdir/usr/lib/scottland/config.d/20-layout-settings"
  install -Dm755 "$_root/core/config.d/90-user-overrides" "$pkgdir/usr/lib/scottland/config.d/90-user-overrides"
  install -Dm755 "$_root/core/session/scottland-settings" "$pkgdir/usr/bin/scottland-settings"
  ln -s /usr/bin/scottland-settings "$pkgdir/usr/lib/scottland/libexec/scottland-settings"
  install -Dm755 "$_root/core/session/scottland-reload" "$pkgdir/usr/lib/scottland/libexec/scottland-reload"
  ln -s /usr/lib/scottland/libexec/scottland-reload "$pkgdir/usr/bin/scottland-reload"
  install -dm755 "$pkgdir/usr/share/scottland/settings"
  install -m644 "$_root"/core/settings/*.qml "$pkgdir/usr/share/scottland/settings/"
  install -Dm644 "$_root/core/settings/scottland-settings.desktop" "$pkgdir/usr/share/applications/scottland-settings.desktop"
  install -Dm755 "$_root/core/autostart.d/05-import-environment" "$pkgdir/usr/lib/scottland/autostart.d/05-import-environment"
  install -dm755 "$pkgdir/usr/lib/scottland/early-exit.d" "$pkgdir/usr/lib/scottland/session-env.d"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_scottland-omarchy() {
  pkgdesc="Omarchy integration for Scottland: switch between Scottland and Hyprland"
  arch=('any')
  depends=('scottland' 'omarchy' 'quickshell' 'jq' 'polkit' 'sddm' 'python' 'lua')
  install=scottland-omarchy.install

  local o="$_root/omarchy"
  install -Dm755 "$o/bin/scottland-switch" "$pkgdir/usr/bin/scottland-switch"
  install -Dm755 "$o/bin/scottland-omarchy-setup" "$pkgdir/usr/bin/scottland-omarchy-setup"
  install -Dm755 "$o/helper/scottland-session-helper" "$pkgdir/usr/lib/scottland/scottland-session-helper"
  install -Dm644 "$o/helper/org.scottland.session.policy" "$pkgdir/usr/share/polkit-1/actions/org.scottland.session.policy"
  install -Dm755 "$o/hooks/10-fall-back-to-hyprland" "$pkgdir/usr/lib/scottland/early-exit.d/10-fall-back-to-hyprland"
  install -Dm755 "$o/shim/scottland-hyprshim" "$pkgdir/usr/lib/scottland/libexec/scottland-hyprshim"
  install -Dm644 "$o/session-env.d/05-omarchy-env.sh" "$pkgdir/usr/lib/scottland/session-env.d/05-omarchy-env.sh"
  install -Dm644 "$o/session-env.d/07-hyprland-env.sh" "$pkgdir/usr/lib/scottland/session-env.d/07-hyprland-env.sh"
  install -Dm644 "$o/session-env.d/10-hyprland-compat.sh" "$pkgdir/usr/lib/scottland/session-env.d/10-hyprland-compat.sh"
  install -Dm755 "$o/libexec/scottland-luahost" "$pkgdir/usr/lib/scottland/libexec/scottland-luahost"
  install -Dm755 "$o/accent.d/10-omarchy-theme" "$pkgdir/usr/lib/scottland/accent.d/10-omarchy-theme"
  install -Dm755 "$o/focus.d/10-omarchy-notifications" "$pkgdir/usr/lib/scottland/focus.d/10-omarchy-notifications"
  install -Dm755 "$o/libexec/scottland-lua-call" "$pkgdir/usr/lib/scottland/libexec/scottland-lua-call"
  install -Dm755 "$o/libexec/scottland-omarchy-solar-theme" "$pkgdir/usr/lib/scottland/libexec/scottland-omarchy-solar-theme"
  install -Dm755 "$o/autostart.d/30-lua-host" "$pkgdir/usr/lib/scottland/autostart.d/30-lua-host"
  install -Dm755 "$o/autostart.d/35-solar-theme" "$pkgdir/usr/lib/scottland/autostart.d/35-solar-theme"
  install -dm755 "$pkgdir/usr/share/scottland-omarchy/themes"
  cp -a "$o/themes/." "$pkgdir/usr/share/scottland-omarchy/themes/"
  install -Dm755 "$o/reload.d/30-lua-host" "$pkgdir/usr/lib/scottland/reload.d/30-lua-host"
  install -Dm755 "$o/autostart.d/40-handover" "$pkgdir/usr/lib/scottland/autostart.d/40-handover"
  install -Dm755 "$o/libexec/scottland-handover" "$pkgdir/usr/lib/scottland/libexec/scottland-handover"
  install -Dm755 "$o/config.d/50-omarchy-shortcuts" "$pkgdir/usr/lib/scottland/config.d/50-omarchy-shortcuts"
  install -Dm755 "$o/autostart.d/10-hyprshim" "$pkgdir/usr/lib/scottland/autostart.d/10-hyprshim"
  install -Dm755 "$o/reload.d/10-hyprshim" "$pkgdir/usr/lib/scottland/reload.d/10-hyprshim"
  install -Dm755 "$o/autostart.d/20-omarchy-shell" "$pkgdir/usr/lib/scottland/autostart.d/20-omarchy-shell"
  install -Dm644 "$o/switch-dialog/shell.qml" "$pkgdir/usr/share/scottland/switch-dialog/shell.qml"
  ln -s /usr/share/omarchy/shell/Commons "$pkgdir/usr/share/scottland/switch-dialog/Commons"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
