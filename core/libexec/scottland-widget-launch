#!/usr/bin/env python3
"""Launch the widget for a window that was dropped on a widget rail (docs/widgets.md).

  scottland-widget-launch '<json context>'

The Scottland plugin runs this with the window's identity (id, window, app_id, title, pid, rail).
It picks the widget (WG6), resolves the app's .desktop entry and icon, and execs the widget's
command with the launch context in its environment and placeholders (WG8). The widget process
keeps this process's id, which is how the plugin recognizes the widget's window.

Choosing a widget, first match wins:
  1. ~/.config/scottland/widgets.ini   [widgets] <app-id or .desktop id> = <widget id>
  2. the app's .desktop entry          X-Scottland-Widget=<widget id>
  3. installed widget packages         widget.toml: apps = ["<app-id regex>", ...]
  4. the default card
Widget packages (a directory with widget.toml) are found, first wins for an id, in
$SCOTTLAND_WIDGET_PATH (colon-separated, if set), ~/.local/share/scottland/widgets/,
/usr/share/scottland/widgets/ and Scottland's built-ins.
"""
import configparser
import json
import os
import re
import shlex
import shutil
import socket
import struct
import sys
import time
import tomllib

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
DATA_HOME = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")
DATA_DIRS = (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "scottland")
# Per session (display): two Scottland sessions number their windows independently.
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "scottland", "widgets",
                       os.environ.get("WAYLAND_DISPLAY") or "wayland")
PALETTE = os.path.join(os.path.dirname(os.path.dirname(RUNTIME)),
                       (os.environ.get("WAYLAND_DISPLAY") or "wayland") + ".palette.json")
HOOKS = os.environ.get("SCOTTLAND_HOOKS", "/usr/lib/scottland")
BUILTIN = [os.path.join(HOOKS, "widgets"), "/usr/lib/scottland/widgets"]
EXTRA = [d for d in os.environ.get("SCOTTLAND_WIDGET_PATH", "").split(":") if d]  # searched first
PACKAGE_DIRS = [*EXTRA, os.path.join(DATA_HOME, "scottland", "widgets"), "/usr/share/scottland/widgets", *BUILTIN]


def log(message):
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "widgets.log"), "a") as out:
        out.write(f"{time.strftime('%F %T')} launch: {message}\n")


def desktop_files():
    seen = set()
    for base in [DATA_HOME, *DATA_DIRS]:
        folder = os.path.join(base, "applications")
        for root, _, files in os.walk(folder):
            for name in files:
                if name.endswith(".desktop"):
                    rel = os.path.relpath(os.path.join(root, name), folder).replace(os.sep, "-")
                    if rel not in seen:  # earlier directories win, like the spec says
                        seen.add(rel)
                        yield rel[:-len(".desktop")], os.path.join(root, name)


def read_desktop(path):
    entry = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as source:
            section = None
            for line in source:
                line = line.strip()
                if line.startswith("["):
                    section = line
                elif section == "[Desktop Entry]" and "=" in line and not line.startswith("#"):
                    key, _, value = line.partition("=")
                    entry.setdefault(key.strip(), value.strip())
    except OSError:
        pass
    return entry


def find_desktop(app_id):
    """The app's .desktop entry: by id, by StartupWMClass, by executable, or (web apps whose
    window class names a site, e.g. chrome-app.element.io__-Default) by the site in Exec."""
    if not app_id:
        return None, {}
    wanted = app_id.lower()
    site = None
    match = re.match(r"^(?:chrome|brave|chromium|msedge)-(.+?)__", app_id)
    if match:
        site = match.group(1).lower()  # "app.element.io" (or a crx id)
    by_wmclass = by_exec = by_site = None
    for desktop_id, path in desktop_files():
        if desktop_id.lower() == wanted:
            return desktop_id, read_desktop(path)
        entry = read_desktop(path)
        if entry.get("StartupWMClass", "").lower() == wanted and not by_wmclass:
            by_wmclass = (desktop_id, entry)
        exec_line = entry.get("Exec", "")
        try:
            program = os.path.basename(shlex.split(exec_line)[0]) if exec_line.strip() else ""
        except ValueError:  # a malformed entry elsewhere mustn't stop this one's widget
            program = ""
        if program.lower() == wanted and not by_exec:
            by_exec = (desktop_id, entry)
        if site and site in exec_line.lower() and not by_site:
            by_site = (desktop_id, entry)
    return by_wmclass or by_site or by_exec or (None, {})


def packages():
    found = {}
    for folder in PACKAGE_DIRS:
        try:
            names = sorted(os.listdir(folder))
        except OSError:
            continue
        for name in names:
            manifest = os.path.join(folder, name, "widget.toml")
            try:
                with open(manifest, "rb") as source:
                    data = tomllib.load(source)
            except (OSError, tomllib.TOMLDecodeError) as error:
                if os.path.exists(manifest):
                    log(f"skipping {manifest}: {error}")
                continue
            widget_id = data.get("id") or name
            if widget_id not in found and data.get("exec"):
                found[widget_id] = {**data, "id": widget_id, "dir": os.path.abspath(os.path.join(folder, name))}
    return found


def choose(app_id, desktop_id, entry, available):
    keys = [k for k in (app_id, desktop_id) if k]
    user = configparser.ConfigParser(interpolation=None, delimiters=("=",))
    user.optionxform = str
    try:
        user.read(os.path.join(CONFIG, "scottland", "widgets.ini"))
    except configparser.Error as error:
        log(f"widgets.ini unreadable: {error}")
    if user.has_section("widgets"):
        for key in keys:
            choice = user.get("widgets", key, fallback="").strip()
            if choice in available:
                return available[choice], "your widgets.ini"
            if choice:
                log(f"widgets.ini names {choice!r} for {key}, which isn't installed")
    choice = entry.get("X-Scottland-Widget", "").strip()
    if choice in available:
        return available[choice], "the app's .desktop entry"
    for widget in available.values():
        for pattern in widget.get("apps", []):
            try:
                if any(re.search(pattern, key, re.IGNORECASE) for key in keys):
                    return widget, "a widget made for this app"
            except re.error:
                log(f"widget {widget['id']}: bad apps pattern {pattern!r}")
    return available.get("card"), "the default"


def tell_traits(context, widget, desktop, entry):
    """Tell Scottland what of the widget's manifest it acts on (WG18): touch_drag = true means a
    finger drag anywhere on the widget moves it, with no long press (taps are still the widget's).
    For widgets with nothing a finger drags, like the card; off by default, so a widget's own
    drags (sliders, drawing) stay its own."""
    socket_path = os.environ.get("WAYFIRE_SOCKET")
    if not socket_path or not context.get("unit"):
        return
    body = json.dumps({"method": "scottland/widget-traits", "data": {
        "window": int(context.get("window", 0)), "unit": str(context["unit"]),
        "touch_drag": bool(widget.get("touch_drag", False)), "desktop": desktop or "",
        "name": entry.get("Name", "") or context.get("app_id", ""),
        "icon": entry.get("Icon", "") or context.get("app_id", ""), "card": widget["id"] == "card"}}).encode()
    try:
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(5)
            sock.connect(socket_path)
            sock.sendall(struct.pack("<I", len(body)) + body)
            size = struct.unpack("<I", sock.recv(4))[0]
            reply = b""
            while len(reply) < size:
                chunk = sock.recv(size - len(reply))
                if not chunk:
                    break
                reply += chunk
    except (OSError, struct.error) as error:
        log(f"couldn't tell Scottland the widget's traits: {error}")


def prepare_state(context):
    if not os.environ.get("WAYFIRE_SOCKET"):
        return  # standalone choice/exec tests have no compositor or widget service
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    # Subscribe before checking ownership. A service starting with the session can appear late;
    # wait for its name event, never poll a state file or start with captured launch values.
    loop = GLib.MainLoop()
    watching = bus.signal_subscribe(
        "org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged", "/org/freedesktop/DBus",
        "org.scottland.Widgets", Gio.DBusSignalFlags.NONE,
        lambda _c, _s, _p, _i, _n, params: loop.quit() if params.unpack()[2] else None)
    owned = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "NameHasOwner", GLib.Variant("(s)", ("org.scottland.Widgets",)),
                          GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
    if not owned:
        timeout = GLib.timeout_add_seconds(6, lambda: (loop.quit(), False)[1])
        loop.run()
        if GLib.MainContext.default().find_source_by_id(timeout):
            GLib.source_remove(timeout)
    bus.signal_unsubscribe(watching)
    bus.call_sync("org.scottland.Widgets", "/org/scottland/Widgets", "org.scottland.WidgetLaunch",
                  "Prepare", GLib.Variant("(ss)", (str(context["id"]), str(context["unit"]))),
                  GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 5000, None)


def main():
    context = json.loads(sys.argv[1])
    app_id = context.get("app_id", "")
    desktop_id, entry = find_desktop(app_id)
    available = packages()
    widget, why = choose(app_id, desktop_id, entry, available)
    if not widget:
        log(f"no widget for {app_id!r} (not even the default card)")
        sys.exit(1)

    widget_id = str(context.get("id", ""))
    tell_traits(context, widget, desktop_id, entry)
    os.makedirs(RUNTIME, exist_ok=True)
    values = {
        "a": app_id,
        "t": context.get("title", ""),
        "i": entry.get("Icon", "") or app_id,
        "p": str(context.get("pid", "")),
        "w": str(context.get("window", "")),
        "r": context.get("rail", ""),
        "d": widget["dir"],
        "%": "%",
    }
    env = dict(os.environ)
    env.update({
        "SCOTTLAND_WIDGET_ID": widget_id,
        "SCOTTLAND_WIDGET_APP_ID": values["a"],
        "SCOTTLAND_WIDGET_ICON": values["i"],
        "SCOTTLAND_WIDGET_PID": values["p"],
        "SCOTTLAND_WIDGET_WINDOW": values["w"],
        "SCOTTLAND_WIDGET_NAME": entry.get("Name", ""),
        "SCOTTLAND_WIDGET_DESKTOP": desktop_id or "",
        # Live title and badge for widgets that want them without D-Bus (the card does). The
        # widget service is this file's only writer.
        # Named by the launch, so a file left by an earlier launch (or a crashed session) for a
        # window with the same id is never this widget's.
        "SCOTTLAND_WIDGET_STATE": os.path.join(RUNTIME, f"{context.get('unit') or widget_id}.json"),
        # The desktop's colors (light/dark, accent, and the integration's palette), kept current.
        "SCOTTLAND_PALETTE": PALETTE,
    })

    # Prepare is synchronous: only the service writes this file, and exec cannot precede it.
    prepare_state(context)

    # Placeholders are filled per word after splitting, so values with spaces stay one argument.
    argv = [re.sub(r"%(.)", lambda m: values.get(m.group(1), m.group(0)), word)
            for word in shlex.split(widget["exec"])]
    # In its own systemd scope (named by the compositor), so ending the widget ends every process
    # it started; else in its own session, at least apart from the compositor's.
    unit = str(context.get("unit", ""))
    if unit and os.environ.get("SCOTTLAND_WIDGET_SCOPE") != "0" and shutil.which("systemd-run") and os.path.exists(
            os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), "systemd", "private")):
        # --expand-environment=no: the arguments are final (a title may contain "$").
        argv = ["systemd-run", "--user", "--scope", "--quiet", "--collect", f"--unit={unit}",
                "--expand-environment=no", "--property=TimeoutStopSec=2", "--", *argv]
    else:
        try:
            os.setsid()
        except OSError:
            pass  # already leads its own group
    log(f"{app_id} ({desktop_id or 'no .desktop'}): widget {widget['id']} from {why}: {argv}")
    os.chdir(widget["dir"])
    try:
        os.execvpe(argv[0], argv, env)
    except OSError as error:
        log(f"couldn't run widget {widget['id']}: {error}")
        sys.exit(1)


if __name__ == "__main__":
    main()
