#!/usr/bin/env python3
"""Read and change Scottland's live layout settings through Wayfire IPC.

  scottland-ctl get                      print center_width, rail_width, min_scale as JSON
  scottland-ctl set min_scale 0.3        apply a value to the running session (not saved)
  scottland-ctl stdin                    apply "name value" lines from stdin (used by the settings app)
"""
import json
import os
import socket
import struct
import sys

NAMES = ("center_width", "rail_width", "min_scale")


def connect():
    sock = socket.socket(socket.AF_UNIX)
    sock.connect(os.environ["WAYFIRE_SOCKET"])
    return sock


def call(sock, method, data):
    body = json.dumps({"method": method, "data": data}).encode()
    sock.sendall(struct.pack("<I", len(body)) + body)
    header = b""
    while len(header) < 4:
        header += sock.recv(4 - len(header))
    size, reply = struct.unpack("<I", header)[0], b""
    while len(reply) < size:
        reply += sock.recv(size - len(reply))
    return json.loads(reply)


def main():
    sock = connect()
    command = sys.argv[1] if len(sys.argv) > 1 else "get"
    if command == "get":
        values = {}
        for name in NAMES:
            reply = call(sock, "wayfire/get-config-option", {"option": f"scottland/{name}"})
            values[name] = float(reply.get("value", reply.get("default", 0)))
        print(json.dumps(values))
    elif command == "set" and len(sys.argv) == 4 and sys.argv[2] in NAMES:
        print(json.dumps(call(sock, "wayfire/set-config-options", {f"scottland/{sys.argv[2]}": sys.argv[3]})))
    elif command == "stdin":
        for line in sys.stdin:
            parts = line.split()
            if len(parts) == 2 and parts[0] in NAMES:
                call(sock, "wayfire/set-config-options", {f"scottland/{parts[0]}": parts[1]})
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
