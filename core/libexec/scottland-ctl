#!/usr/bin/env python3
"""Read and change Scottland's live layout, goo, Window mode and widget settings through Wayfire IPC.

  scottland-ctl get                      print the layout settings as JSON
  scottland-ctl set scale_curve "0:1 0.4:0.6 1:0.2"
  scottland-ctl set min_scale 0.3        apply a value to the running session (not saved)
  scottland-ctl stdin                    apply "name value" lines from stdin (used by the settings app)
  scottland-ctl windows                  list open windows: id, app-id, zone, scale, title
  scottland-ctl sender-window-snapshot   print mapped window identities as JSON
  scottland-ctl present 42               bring window 42 (or its widget's window) to the middle, focused
  scottland-ctl option scottland/sounds  print an option's live value (any Wayfire option)

Outside a Scottland session it runs inside one through scottland-exec.
"""
import json
import os
import socket
import struct
import sys

NAMES = ("center_width", "rail_width", "min_scale", "max_scale", "scale_curve", "blend_width")
GOO = ("goo", "goo_breath_keys", "goo_falloff", "goo_thickness", "goo_reach", "goo_thinning", "goo_swell",
       "goo_noise", "goo_lump", "goo_drift", "goo_wave_speed", "goo_wave_damp", "goo_wave_height",
       "goo_spread", "goo_swirl", "goo_release", "goo_shine", "goo_relief", "goo_depth", "goo_profile", "goo_soak", "goo_pickup_balance",
       "goo_dye_density", "goo_overlap_film", "goo_hover_cloudiness", "goo_hover_emissivity", "goo_hover_distance",
       "attention_color_family")
WIDGETS = ("widget_bounce", "widget_peek_enter_delay", "widget_peek_leave_delay", "widget_attention_peek_duration",
           "widget_make_room_dwell", "minimize_hold_delay")
BOOL = ("goo", "goo_breath_keys", "window_avoidance_always")
OPACITY = ("center_opacity_focused", "center_opacity_unfocused", "side_opacity_focused", "side_opacity_unfocused",
           "widget_opacity_focused", "widget_opacity_unfocused", "window_mode_opacity_focused", "window_mode_opacity_unfocused")
UNFOCUSED_EDGE = ("unfocused_edge_tone_light", "unfocused_edge_tone_dark", "unfocused_edge_strength")
NAMES += GOO + UNFOCUSED_EDGE + ("cycle_overshoot", "key_impulse", "key_friction", "resize_impulse", "resize_friction",
                "key_max_velocity", "alt_hold_delay", "window_double_tap_delay", "window_mode_tint", "hint_background_opacity", "window_hold_delay") + WIDGETS + OPACITY
NAMES += ("window_avoidance_always", "solo_audition_hotspot")
TEXT = ("scale_curve", "goo_falloff", "attention_color_family")
# Renamed settings: the old name is still accepted (Mike, 2026-10-05: dye strength is dye density).
LEGACY_OPTIONS = {"hint_avoidance_always": "window_avoidance_always", "goo_dye_strength": "goo_dye_density"}
ACCEPTED_NAMES = set(NAMES) | set(LEGACY_OPTIONS)

LIVE_OPTIONS = {}

def setting_updates(name, value, sock=None):
    name = LEGACY_OPTIONS.get(name, name)
    updates = {f"scottland/{name}": value}
    if name == "window_avoidance_always":
        updates["scottland/hint_avoidance_always"] = value
    if name == "goo_dye_density" and sock is not None:
        if name not in LIVE_OPTIONS:
            live = call(sock, "wayfire/get-config-option", {"option": f"scottland/{name}"})
            LIVE_OPTIONS[name] = name if "value" in live else "goo_dye_strength"
        updates = {f"scottland/{LIVE_OPTIONS[name]}": value}
    return updates


def connect(timeout=None):
    if not os.environ.get("WAYFIRE_SOCKET") and not os.environ.get("SCOTTLAND_EXEC"):
        here = os.path.dirname(os.path.realpath(__file__))
        os.execvp(os.path.join(here, "scottland-exec"), ["scottland-exec", "--", os.path.realpath(__file__), *sys.argv[1:]])
    sock = socket.socket(socket.AF_UNIX)
    if timeout is not None:
        sock.settimeout(timeout)
    sock.connect(os.environ["WAYFIRE_SOCKET"])
    return sock


def call(sock, method, data):
    body = json.dumps({"method": method, "data": data}).encode()
    sock.sendall(struct.pack("<I", len(body)) + body)
    header = b""
    while len(header) < 4:
        chunk = sock.recv(4 - len(header))
        if not chunk:
            raise ConnectionError("Wayfire closed IPC before the reply header")
        header += chunk
    size, reply = struct.unpack("<I", header)[0], b""
    while len(reply) < size:
        chunk = sock.recv(size - len(reply))
        if not chunk:
            raise ConnectionError("Wayfire closed IPC before the reply body")
        reply += chunk
    return json.loads(reply)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "get"
    sock = connect(timeout=2 if command == "sender-window-snapshot" else None)
    if command == "get":
        # Settings the running plugin doesn't know (it predates them; the session needs a restart)
        # are listed under "unsupported" instead of being reported as 0.
        values, unsupported = {}, []
        for name in NAMES:
            reply = call(sock, "wayfire/get-config-option", {"option": f"scottland/{name}"})
            if "value" in reply:
                if name in BOOL:
                    values[name] = str(reply["value"]).lower() in ("true", "1")
                else:
                    values[name] = reply["value"] if name in TEXT else float(reply["value"])
                if name == "window_avoidance_always":
                    legacy = call(sock, "wayfire/get-config-option", {"option": "scottland/hint_avoidance_always"})
                    if "value" in legacy:
                        values[name] = values[name] or str(legacy["value"]).lower() in ("true", "1")
            else:
                if name == "window_avoidance_always":
                    legacy = call(sock, "wayfire/get-config-option", {"option": "scottland/hint_avoidance_always"})
                    if "value" in legacy:
                        values[name] = str(legacy["value"]).lower() in ("true", "1")
                    else:
                        unsupported.append(name)
                elif name == "goo_dye_density":
                    legacy = call(sock, "wayfire/get-config-option", {"option": "scottland/goo_dye_strength"})
                    if "value" in legacy:
                        values[name] = float(legacy["value"])
                    else:
                        unsupported.append(name)
                else:
                    unsupported.append(name)
        values["unsupported"] = unsupported
        print(json.dumps(values))
    elif command == "set" and len(sys.argv) == 4 and sys.argv[2] in ACCEPTED_NAMES:
        print(json.dumps(call(sock, "wayfire/set-config-options", setting_updates(sys.argv[2], sys.argv[3], sock))))
    elif command == "option" and len(sys.argv) == 3:
        reply = call(sock, "wayfire/get-config-option", {"option": sys.argv[2]})
        print(json.dumps(reply.get("value", reply)))
    elif command == "present" and len(sys.argv) == 3 and sys.argv[2].isdigit():
        reply = call(sock, "scottland/present", {"window": int(sys.argv[2])})
        print(json.dumps(reply))
        sys.exit(1 if "error" in reply else 0)
    elif command == "windows":
        for view in call(sock, "scottland/layout-state", {}).get("views", []):
            print(f"{view['id']:>5}  {view.get('app_id', ''):32} {view['zone']:11} {view['applied_scale']:.2f}  {view['title'][:60]}")
    elif command == "sender-window-snapshot":
        reply = call(sock, "window-rules/list-views", {})
        if isinstance(reply, dict) and "error" in reply:
            print(reply["error"], file=sys.stderr)
            sys.exit(1)
        print(json.dumps(reply))
    elif command == "stdin":
        for line in sys.stdin:
            if line.strip() == "flush":
                print("flushed", flush=True)
                continue
            if line.startswith("batch "):
                values = json.loads(line[6:])
                updates = {}
                for key, value in values.items():
                    if key in ACCEPTED_NAMES: updates.update(setting_updates(key, value, sock))
                reply = call(sock, "wayfire/set-config-options", updates)
                if reply.get("error"):
                    print(reply["error"], file=sys.stderr, flush=True)
                continue
            parts = line.strip().split(None, 1)
            if parts and parts[0] in ACCEPTED_NAMES:
                parts = parts + [""] if len(parts) == 1 else parts
                reply = call(sock, "wayfire/set-config-options", setting_updates(parts[0], parts[1], sock))
                if reply.get("error"):
                    print(f"{parts[0]}: {reply['error']}", file=sys.stderr, flush=True)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
