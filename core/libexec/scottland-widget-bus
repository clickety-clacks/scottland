#!/usr/bin/env python3
"""Scottland's widget service on the session bus (docs/widgets.md: WG9, WG10 live data, WG11, WG12).

Owns org.scottland.Widgets and publishes, for each widget, an org.scottland.Widget object at
/org/scottland/widget/<id> (properties with change signals; Restore, Close, Focus). On
/org/scottland/Widgets it offers the optional app<->widget data mailbox (org.scottland.WidgetData)
and lets apps learn their own state (org.scottland.Windows). It also listens for launcher badges
(com.canonical.Unity.LauncherEntry) and keeps each widget's state file current, for widgets that
prefer a file to D-Bus (the default card).

Driven by events, not polling: it subscribes to the compositor's IPC events (Scottland's
scottland-widgets# and scottland-scale#, and windows opening, closing, retitling and focusing).

  scottland-widget-bus          run (started with the session; needs WAYFIRE_SOCKET)
"""
import hashlib
import json
import os
import socket
import struct
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

BUS_NAME = "org.scottland.Widgets"
ROOT = "/org/scottland/Widgets"
DISPLAY = os.environ.get("WAYLAND_DISPLAY") or "wayland"
# Per session (display): two Scottland sessions number their windows independently.
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "scottland", "widgets", DISPLAY)
STATE_LOG = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                         "scottland", "widgets.log")

WIDGET_XML = """
<node>
  <interface name="org.scottland.Widget">
    <property name="Id" type="s" access="read"/>
    <property name="AppId" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Pid" type="u" access="read"/>
    <property name="Window" type="t" access="read"/>
    <property name="Rail" type="s" access="read"/>
    <property name="Focused" type="b" access="read"/>
    <property name="Urgent" type="b" access="read"/>
    <property name="Badge" type="x" access="read"/>
    <property name="Data" type="s" access="read"/>
    <property name="Minimized" type="b" access="read"/>
    <method name="Restore"/>
    <method name="Close"/>
    <method name="Focus"/>
  </interface>
</node>"""

ROOT_XML = """
<node>
  <interface name="org.scottland.WidgetData">
    <method name="Publish"><arg name="json" type="s" direction="in"/></method>
    <method name="Send"><arg name="json" type="s" direction="in"/></method>
    <signal name="Received">
      <arg name="app_pid" type="u"/>
      <arg name="window" type="t"/>
      <arg name="json" type="s"/>
    </signal>
  </interface>
  <interface name="org.scottland.Windows">
    <method name="GetState">
      <arg name="widgetized" type="b" direction="out"/>
      <arg name="scale" type="d" direction="out"/>
    </method>
    <signal name="StateChanged">
      <arg name="pid" type="u"/>
      <arg name="widgetized" type="b"/>
      <arg name="scale" type="d"/>
    </signal>
  </interface>
</node>"""


def log(message):
    os.makedirs(os.path.dirname(STATE_LOG), exist_ok=True)
    with open(STATE_LOG, "a") as out:
        out.write(f"{time.strftime('%F %T')} bus: {message}\n")


class Ipc:
    """A Wayfire IPC connection (4-byte little-endian length + JSON)."""

    def __init__(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.connect(os.environ["WAYFIRE_SOCKET"])

    def send(self, method, data=None):
        body = json.dumps({"method": method, "data": data or {}}).encode()
        self.sock.sendall(struct.pack("<I", len(body)) + body)

    def receive(self):
        header = self._exactly(4)
        return json.loads(self._exactly(struct.unpack("<I", header)[0]))

    def call(self, method, data=None):
        self.send(method, data)
        return self.receive()

    def _exactly(self, size):
        data = b""
        while len(data) < size:
            chunk = self.sock.recv(size - len(data))
            if not chunk:
                raise ConnectionError("compositor closed the IPC socket")
            data += chunk
        return data


def register(connection, path, info, method_call, get_property):
    """Export an object. GLib 2.84+ has register_object_with_closures2; older GLib (Ubuntu 24.04
    ships 2.80) only the closures API PyGObject calls register_object. SCOTTLAND_DBUS_LEGACY=1
    forces the older one (tests)."""
    if hasattr(connection, "register_object_with_closures2") and os.environ.get("SCOTTLAND_DBUS_LEGACY") != "1":
        return connection.register_object_with_closures2(path, info, method_call, get_property, None)
    return connection.register_object(path, info, method_call, get_property, None)


def fingerprint():
    with open(os.path.realpath(__file__), "rb") as source:
        return hashlib.sha256(source.read()).hexdigest()


def in_scope(pid, unit):
    """Is process `pid` in systemd scope `unit` (where the widget's processes all run)?"""
    if not unit:
        return False
    try:
        with open(f"/proc/{pid}/cgroup") as source:
            return any(line.rstrip("\n").endswith("/" + unit) for line in source)
    except OSError:
        return False


def scope_exists(unit):
    """Is systemd scope `unit` running? No systemd (no systemctl): no scope."""
    if not unit:
        return False
    try:
        return subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit],
                              stdin=subprocess.DEVNULL, timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def is_widget_process(pid, state):
    """Is `pid` one of this widget's processes? With a scope, membership decides. Without one,
    descent from its window's process or its launch process (reported only while it runs)."""
    if scope_exists(state["_widget_unit"]):
        return in_scope(pid, state["_widget_unit"])
    return any(root > 1 and pid_descends_from(pid, root) for root in (state["_launcher_pid"], state["_widget_pid"]))


def pid_descends_from(pid, ancestor):
    for _ in range(8):
        if pid <= 1:
            return False
        if pid == ancestor:
            return True
        try:
            with open(f"/proc/{pid}/stat") as stat:
                pid = int(stat.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return False
    return False


class Service:
    def __init__(self):
        self.ipc = Ipc()
        self.widgets = {}        # id -> state dict
        self.registrations = {}  # id -> registration id
        self.badges = {}         # .desktop id -> (count, visible), merged from partial updates
        self.scales = {}         # window id -> scale
        self.window_pids = {}    # window id -> its app's process
        self.announced = {}      # pid -> (widgetized, scale) last announced in StateChanged
        self.bus = None
        self.widget_info = Gio.DBusNodeInfo.new_for_xml(WIDGET_XML).interfaces[0]
        root = Gio.DBusNodeInfo.new_for_xml(ROOT_XML)
        self.data_info, self.windows_info = root.interfaces
        os.makedirs(RUNTIME, exist_ok=True)

    # --- compositor ---

    def refresh(self):
        try:
            reply = self.ipc.call("scottland/widgets")
            layout = self.ipc.call("scottland/layout-state")
            views = self.ipc.call("window-rules/list-views")
        except (OSError, ConnectionError, ValueError) as error:
            log(f"compositor unreachable: {error}")
            return
        if not isinstance(views, list):
            views = []
        # Open windows only: Wayfire also lists views that exist but aren't mapped.
        self.window_pids = {v.get("id"): int(v.get("pid", 0) or 0) for v in views
                            if isinstance(v, dict) and v.get("mapped", True) and v.get("role") == "toplevel"}
        # Target scales (what scottland-scale# announces), never a step of an animation.
        self.scales = {v["id"]: v.get("target_scale", v.get("applied_scale", 1.0)) for v in layout.get("views", [])}
        seen = set()
        for entry in reply.get("widgets", []):
            wid = entry["id"]
            seen.add(wid)
            state = self.widgets.get(wid) or self.new_widget(wid, entry.get("widget_unit", ""))
            if state["_widget_unit"] != entry.get("widget_unit", ""):
                # A new launch with this id: forget what came from the old one, learn its app again.
                for path in (self.state_path(wid), self.launch_path(wid)):
                    try:
                        os.remove(path)
                    except OSError:
                        pass
                state["_widget_unit"] = entry.get("widget_unit", "")
                state["_desktop"] = ""
                self.update(wid, {"Badge": 0})
            self.learn_desktop(wid)
            updates = {
                "AppId": entry.get("app_id", ""),
                "Title": entry.get("title", ""),
                "Pid": max(0, int(entry.get("pid", 0))),
                "Window": max(0, int(entry.get("window", 0))),
                "Rail": entry.get("rail", ""),
                "Focused": bool(entry.get("focused")),
                "Urgent": bool(entry.get("urgent")),
                "Minimized": bool(entry.get("minimized")),
                "_widget_pid": int(entry.get("widget_pid", 0)),
                "_launcher_pid": int(entry.get("launcher_pid", 0)),
                "_widget_unit": entry.get("widget_unit", ""),
            }
            if state.get("_desktop") in self.badges:
                updates["Badge"] = self.badge(state["_desktop"])
            self.update(wid, updates)
        for wid in [w for w in self.widgets if w not in seen]:
            self.remove_widget(wid)
        self.announce_changes()

    def new_widget(self, wid, unit=""):
        state = {"Id": wid, "AppId": "", "Title": "", "Pid": 0, "Window": 0, "Rail": "", "Focused": False,
                 "Urgent": False, "Minimized": False, "Badge": 0, "Data": "", "_widget_pid": 0, "_launcher_pid": 0,
                 "_widget_unit": unit, "_desktop": ""}
        self.widgets[wid] = state
        self.learn_desktop(wid)
        if self.bus:
            self.registrations[wid] = register(
                self.bus, f"/org/scottland/widget/{wid}", self.widget_info, self.on_widget_call, self.on_widget_get)
        return state

    def learn_desktop(self, wid):
        """The app's .desktop id, which the launcher leaves in <id>.launch.json (badges are
        announced per .desktop). The widget can show up here before the launcher has run, so
        this is retried until it's known."""
        state = self.widgets[wid]
        if state["_desktop"]:
            return
        try:
            with open(self.launch_path(wid)) as source:
                launch = json.load(source)
        except (OSError, ValueError):
            return
        if state["_widget_unit"] and launch.get("unit") != state["_widget_unit"]:
            return  # another launch's file (e.g. left by a crashed session): wait for this one's
        state["_desktop"] = launch.get("desktop", "") or ""
        if state["_desktop"] in self.badges:
            self.update(wid, {"Badge": self.badge(state["_desktop"])})

    def remove_widget(self, wid):
        if wid in self.registrations:
            self.bus.unregister_object(self.registrations.pop(wid))
        paths = (self.state_path(wid), self.launch_path(wid))  # this launch's own, not a newer one's
        self.widgets.pop(wid)
        for path in paths:
            try:
                os.remove(path)
            except OSError:
                pass

    def update(self, wid, updates):
        state = self.widgets[wid]
        changed = {k: v for k, v in updates.items() if state.get(k) != v}
        if not changed:
            return
        state.update(changed)
        public = {k: v for k, v in changed.items() if not k.startswith("_")}
        if public and self.bus:
            self.bus.emit_signal(None, f"/org/scottland/widget/{wid}", "org.freedesktop.DBus.Properties",
                                 "PropertiesChanged", GLib.Variant("(sa{sv}as)", (
                                     "org.scottland.Widget",
                                     {k: self.variant(k, v) for k, v in public.items()}, [])))
        self.write_state(wid)

    def write_state(self, wid):
        """The state file's only writer (the launcher has its own file)."""
        state = self.widgets[wid]
        path = self.state_path(wid)
        try:
            with open(path + ".tmp", "w") as out:
                json.dump({"desktop": state["_desktop"], "title": state["Title"], "badge": state["Badge"],
                           "rail": state["Rail"], "minimized": state["Minimized"],
                           "focused": state["Focused"], "urgent": state["Urgent"], "data": state["Data"]}, out)
            os.replace(path + ".tmp", path)
        except OSError as error:
            log(f"state file {path}: {error}")

    def launch_path(self, wid):
        """The launcher's file for this widget's launch (named by its unique scope)."""
        return os.path.join(RUNTIME, f"{self.widgets[wid]['_widget_unit'] or wid}.launch.json")

    def state_path(self, wid):
        """The widget's state file, named by its launch (as the launcher told the widget)."""
        return os.path.join(RUNTIME, f"{self.widgets[wid]['_widget_unit'] or wid}.json")

    @staticmethod
    def variant(key, value):
        kind = {"Pid": "u", "Window": "t", "Badge": "x", "Focused": "b", "Urgent": "b", "Minimized": "b"}.get(key, "s")
        return GLib.Variant(kind, value)

    def note_scale(self, window, scale):
        self.scales[window] = scale
        if window not in self.window_pids:
            self.refresh()  # a window we haven't seen: learn whose it is
        else:
            self.announce_changes()

    def app_state(self, pid):
        """(widgetized, scale) for the app owning process `pid` (or one of its helpers). Apps
        with several windows: widgetized if any is, with that window's scale; else the scale of
        its first window. GetState and StateChanged both answer from here, so they agree."""
        owned = sorted(w for w, owner in self.window_pids.items() if owner > 1 and pid_descends_from(pid, owner))
        widgetized = [s["Window"] for s in self.widgets.values() if s["Pid"] and pid_descends_from(pid, s["Pid"])]
        window = (widgetized or owned or [None])[0]
        return bool(widgetized), round(self.scales.get(window, 1.0), 3)

    def widgetized(self, pid):
        return self.app_state(pid)[0]

    def announce_changes(self):
        """StateChanged for every app whose (widgetized, scale) differs from what it was last told."""
        if not self.bus:
            return
        for pid in {p for p in self.window_pids.values() if p > 1} | set(self.announced):
            state = self.app_state(pid)
            if self.announced.get(pid, (False, 1.0)) != state:  # a new app at 100% has nothing to hear
                self.bus.emit_signal(None, ROOT, "org.scottland.Windows", "StateChanged",
                                     GLib.Variant("(ubd)", (pid, *state)))
            self.announced[pid] = state
        for pid in [p for p in self.announced if p not in self.window_pids.values()]:
            del self.announced[pid]  # its windows are gone

    def watch_compositor(self):
        events = Ipc()
        reply = events.call("window-rules/events/watch", {
            "events": ["scottland-widgets#", "scottland-scale#", "view-title-changed", "view-focused",
                       "view-mapped", "view-unmapped"]})
        if reply.get("result") != "ok":
            log(f"couldn't watch compositor events: {reply}")
            sys.exit(1)
        channel = GLib.IOChannel.unix_new(events.sock.fileno())
        GLib.io_add_watch(channel, GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN | GLib.IOCondition.HUP,
                          self.on_event, events)

    def on_event(self, _channel, condition, events):
        if condition & GLib.IOCondition.HUP:
            log("compositor went away; exiting")
            GLib.MainLoop().quit()
            sys.exit(0)
        try:
            event = events.receive()
        except (OSError, ConnectionError, ValueError):
            sys.exit(0)
        if event.get("event") == "scottland-scale#":
            self.note_scale(int(event.get("window", 0)), float(event.get("scale", 1.0)))
        else:
            self.refresh()
        return True

    # --- D-Bus ---

    def on_widget_get(self, _conn, _sender, path, _iface, prop):
        state = self.widgets.get(path.rsplit("/", 1)[-1])
        return self.variant(prop, state[prop]) if state and prop in state else None

    def on_widget_call(self, _conn, _sender, path, _iface, method, _params, invocation):
        wid = path.rsplit("/", 1)[-1]
        action = {"Restore": "restore", "Close": "close", "Focus": "focus"}.get(method)
        try:
            reply = self.ipc.call("scottland/widget-action", {"id": wid, "action": action})
        except (OSError, ConnectionError, ValueError) as error:
            reply = {"error": str(error)}
        if reply.get("error"):
            invocation.return_dbus_error("org.scottland.Widgets.Error", str(reply["error"]))
        else:
            invocation.return_value(None)

    def caller_pid(self, sender):
        reply = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                   "GetConnectionUnixProcessID", GLib.Variant("(s)", (sender,)),
                                   GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1, None)
        return reply.unpack()[0]

    def on_root_call(self, _conn, sender, _path, iface, method, params, invocation):
        try:
            pid = self.caller_pid(sender)
        except GLib.Error as error:
            invocation.return_dbus_error("org.scottland.Widgets.Error", f"can't identify caller: {error.message}")
            return
        if iface == "org.scottland.Windows" and method == "GetState":
            invocation.return_value(GLib.Variant("(bd)", self.app_state(pid)))
            return
        (payload,) = params.unpack()
        try:
            json.loads(payload)
        except ValueError:
            invocation.return_dbus_error("org.scottland.Widgets.Error", "payload isn't JSON")
            return
        if method == "Publish":
            # An app publishes for its own windows only: its process must own the window.
            targets = [wid for wid, s in self.widgets.items() if s["Pid"] and pid_descends_from(pid, s["Pid"])]
            if not targets:
                invocation.return_dbus_error("org.scottland.Widgets.Error", "no widget for the calling app")
                return
            for wid in targets:
                self.update(wid, {"Data": payload})
        elif method == "Send":
            # A widget sends to its own app only. Identities are taken fresh from the compositor
            # (without scopes, a launch process counts only while it still runs).
            self.refresh()
            sources = [s for s in self.widgets.values() if is_widget_process(pid, s)]
            if not sources:
                invocation.return_dbus_error("org.scottland.Widgets.Error", "the caller isn't a widget")
                return
            for state in sources:
                self.bus.emit_signal(None, ROOT, "org.scottland.WidgetData", "Received",
                                     GLib.Variant("(uts)", (state["Pid"], state["Window"], payload)))
        invocation.return_value(None)

    def badge(self, desktop):
        count, visible = self.badges.get(desktop, (0, False))
        return count if visible else 0

    def on_launcher_entry(self, _conn, _sender, _path, _iface, _signal, params):
        """Updates carry only what changed (a progress update has no count): merge them."""
        app_uri, props = params.unpack()
        desktop = app_uri.removeprefix("application://").removesuffix(".desktop")
        count, visible = self.badges.get(desktop, (0, False))
        if "count" in props:
            count = int(props["count"])
        if "count-visible" in props:
            visible = bool(props["count-visible"])
        self.badges[desktop] = (count, visible)
        for wid, state in self.widgets.items():
            if state["_desktop"] == desktop:
                self.update(wid, {"Badge": self.badge(desktop)})

    def on_bus(self, connection, _name):
        self.bus = connection
        register(connection, ROOT, self.data_info, self.on_root_call, None)
        register(connection, ROOT, self.windows_info, self.on_root_call, None)
        for wid in list(self.widgets):
            self.registrations[wid] = register(
                connection, f"/org/scottland/widget/{wid}", self.widget_info, self.on_widget_call, self.on_widget_get)
        connection.signal_subscribe(None, "com.canonical.Unity.LauncherEntry", "Update", None, None,
                                    Gio.DBusSignalFlags.NONE, self.on_launcher_entry)

    # --- attention from desktop notifications (WG15) ---

    def watch_notifications(self):
        """Watch org.freedesktop.Notifications.Notify calls on a monitoring connection of its own
        (a monitor can do nothing else). A notification counts for a window when the process that
        sent it owns exactly one window (so it's clear which window it's about); others are skipped."""
        try:
            address = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION, None)
            monitor = Gio.DBusConnection.new_for_address_sync(
                address, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT |
                Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
            monitor.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus.Monitoring",
                              "BecomeMonitor", GLib.Variant("(asu)", ([
                                  "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"], 0)),
                              None, Gio.DBusCallFlags.NONE, -1, None)
        except GLib.Error as error:
            log(f"not watching notifications (the bus doesn't allow monitoring): {error.message}")
            return
        monitor.add_filter(self.on_monitored)
        self.monitor = monitor  # keep it open

    def on_monitored(self, _connection, message, incoming):
        # Called on GDBus's worker thread: hand over to the main loop.
        if incoming and message.get_member() == "Notify" and message.get_sender():
            GLib.idle_add(self.on_notification, message.get_sender())
        return None  # a monitor's messages go nowhere else

    def on_notification(self, sender):
        try:
            pid = self.caller_pid(sender)
        except GLib.Error:
            return False
        self.refresh()
        windows = [w for w, owner in self.window_pids.items() if owner == pid]
        if len(windows) != 1:
            return False  # no window, or several: can't tell which one wants attention
        try:
            self.ipc.call("scottland/attention", {"window": int(windows[0]), "attention": True, "source": "notifications"})
        except (OSError, ConnectionError, ValueError) as error:
            log(f"couldn't mark attention: {error}")
        return False

    def run(self):
        # One service per session: the reload hook checks this before starting another.
        pid_file = os.path.join(os.path.dirname(os.path.dirname(RUNTIME)), DISPLAY + ".widget-bus.pid")
        with open(pid_file, "w") as out:
            # Its pid and a fingerprint of the code it runs: a reload replaces it once that differs.
            out.write(f"{os.getpid()}\n{fingerprint()}\n")
        Gio.bus_own_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE, self.on_bus, None,
                         lambda *_: (log("couldn't own org.scottland.Widgets (another service?)"), sys.exit(1)))
        self.watch_compositor()
        self.refresh()
        self.watch_notifications()
        GLib.MainLoop().run()


if __name__ == "__main__":
    if not os.environ.get("WAYFIRE_SOCKET"):
        sys.exit("scottland-widget-bus: run it inside a Scottland session")
    Service().run()
