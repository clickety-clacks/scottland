#!/usr/bin/env python3
"""Append the active session's temporary panel-mirror mode after user overrides."""
import os
from pathlib import Path
import re
import sys


NAME = re.compile(r"[A-Za-z0-9._-]+\Z")


def session_dir():
    configured = os.environ.get("SCOTTLAND_SESSION_DIR")
    if configured:
        return Path(configured)
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return Path(runtime) / "scottland"


display = os.environ.get("WAYLAND_DISPLAY", "")
if not NAME.fullmatch(display) or display in {".", ".."}:
    if len(sys.argv) > 1 and sys.argv[1] == "--watch-paths":
        raise SystemExit(0)
    raise SystemExit(0)

request = session_dir() / "display-mirror" / display / "request"
if len(sys.argv) > 1 and sys.argv[1] == "--watch-paths":
    print(request.parent)
    raise SystemExit(0)

try:
    lines = request.read_text(encoding="utf-8").splitlines()
except FileNotFoundError:
    raise SystemExit(0)
except OSError as error:
    print(f"98-session-output-mirror: could not read {request}: {error}", file=sys.stderr)
    raise SystemExit(1)

if (len(lines) != 2 or not all(NAME.fullmatch(name) for name in lines) or
        any(name in {".", ".."} for name in lines) or lines[0] == lines[1]):
    print(f"98-session-output-mirror: invalid mirror request in {request}", file=sys.stderr)
    raise SystemExit(1)

source, target = lines
print(f"[output:{target}]\n# Temporary session mirror of {source}\nmode = mirror {source}")
