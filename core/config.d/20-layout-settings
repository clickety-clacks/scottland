#!/bin/sh
# Append the user's saved layout settings (written by the Scottland settings app).
settings="${XDG_CONFIG_HOME:-$HOME/.config}/scottland/layout.ini"
if [ "${1:-}" = --watch-paths ]; then
  dirname "$settings"
  exit 0
fi
# Dye strength was renamed dye density (2026-10-05): saved values carry over.
[ -f "$settings" ] && sed 's/^[[:space:]]*goo_dye_strength\([[:space:]]*=\)/goo_dye_density\1/' "$settings"
exit 0
