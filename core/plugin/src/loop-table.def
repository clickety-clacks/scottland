NOTE(broker_launch_failed, "widget broker couldn't launch a widget; the launch watchdog restores its app")
NOTE(goo_readback_failed, "goo: an energy reading failed (issued at step {1}); the goo sleeps on time (GO10)")
NOTE(goo_simulation_unavailable, "goo: simulation unavailable; retaining halo")
NOTE(goo_invalid_falloff, "goo: invalid falloff, keeping last valid curve")
NOTE(goo_atlas_too_large, "goo: widget shape atlas exceeds GPU limits; retaining halo")
NOTE(goo_gl, "goo: GL context {1:0:1:missing|present}, GLES 3 {2:0:1:no|yes}, float textures and derivatives {3:0:1:no|yes}")
NOTE(goo_targets, "goo: {1:0:1:RGBA16F|packed RGBA8} simulation targets")
NOTE(goo_shader_unavailable, "goo: shader unavailable; retaining halo")
NOTE(goo_gles2_sources, "goo: too many sources for GLES 2 ({1}); retaining halo")
NOTE(goo_cache_unavailable, "goo: surface cache unavailable; using direct draw")
NOTE(goo_breath_exact, "goo: breathing uses the exact path: {1:0:3:test override|keyframes are switched off (scottland/goo_breath_keys)|the second cache layer could not be allocated|the surface cache is unavailable|unknown}")
NOTE(goo_breath_keyframes, "goo: breathing uses {1} keyframes, {2} device pixels apart (ceiling {3})")
NOTE(scale_curve_invalid, "ignoring an invalid scale_curve")
NOTE(scale_pin, "window {1} {2:0:1:follows its zone again|keeps its scale (Shift)}")
NOTE(minimize_key_edge, "minimize-key edge={1} device={3:x} time_msec={2:0:32} received_msec={2:32:32} key={4:0:16} state={4:16:1:release|press} duplicate_down={4:17:1} held_devices={4:25:8} activated={4:18:1} mode={4:19:2:expanded|collapsed|hidden} processing={4:21:4}")
NOTE(minimize_key_device_removed, "minimize-key device-removed key={1} device={2:x} received_msec={3} held_devices={4}")
NOTE(minimize_key_ignored_duplicate, "minimize-key ignored-duplicate edge={1} time_msec={2} key={3:0:32} modifiers={3:32:32} mode={4:0:2:expanded|collapsed|hidden}")
NOTE(minimize_key_no_widgets, "minimize-key no-widgets edge={1} time_msec={2}")
NOTE(minimize_key_activation, "minimize-key activation edge={1} time_msec={2} key={3:0:32} modifiers={3:32:32} mode={4:0:2:expanded|collapsed|hidden}")
NOTE(minimize_key_hold, "minimize-key hold mode={1:0:2:expanded|collapsed|hidden} shown={2:0:2:expanded|collapsed|hidden}")
NOTE(minimize_key_hold_release, "minimize-key hold-release mode={1:0:2:expanded|collapsed|hidden}")
NOTE(minimize_key_late_hold, "minimize-key late-hold mode={1:0:2:expanded|collapsed|hidden}")
NOTE(minimize_key_tap, "minimize-key tap mode={1:0:2:expanded|collapsed|hidden}")
NOTE(rail_drawn_step, "rail drawn step {2} px in {3} ms for view {1}: geometry y {4:p}")
NOTE(three_finger_hold, "three-finger hold on {1}{2:0:1:| (focused)}")
NOTE(widgetize, "widgetize window={1} reason={2:0:8:rail-drop|inertial-contact|hint-rail|load-rail-recovery|drag-preview|cancel-form-return|other} preview={2:8:1} rail={2:9:1:left|right} at={3:p} size={4:p}")
NOTE(widget_queue_failed, "couldn't queue a widget for window {1}")
NOTE(widget_launch_timeout, "no widget window appeared for window {1}; restoring it")
NOTE(touch_ignored, "touch ignored: a finger still counted down (hold,lifted {1:p})")
NOTE(touch_on_widget, "touch on widget {1} {2:0:1:(its own drags)|(a drag moves it)}")
NOTE(touch_drag_widget, "touch drag on widget {1}: moving it")
NOTE(touch_down_widget, "touch down on widget {1} at {2:p}: hit {3:0:1:its surface|its halo}, touch focus {3:1:2:none|a surface|a halo}, fingers {3:8:8}, hold,lifted {4:p}, movable {3:3:1:no|yes}, touch_drag {3:4:1:no|yes}")
NOTE(bad_regex, "bad {1:0:8:touch_scroll_wheel|touch_scroll_*|remap_apps_*} regex")
NOTE(drag_start, "drag start: window {1} {2:0:1:starts a move|continues the move} ({2:32:32} ms after the last drop, of window {3}); Esc goes to {4:p}")
NOTE(fullscreen, "full screen on an output: {1:0:1:widgets back|focus (widgets away)}")
NOTE(esc_return, "Esc: window {1} back from {2:p} to {3:p}")
NOTE(drop, "drop: window {1} (the move began at {2:p})")
NOTE(handover_adopt_failed, "reload: adopting the widget of window {1} failed; its lease was returned and its handle closed")
NOTE(handover_export_failed, "reload: preparing the handover failed; widgets unload as in an ordinary unload")
NOTE(worker_unavailable, "worker {1} unavailable: {2:0:8:eventfd|event source|thread|broken}")
