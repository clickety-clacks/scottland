#!/bin/sh
# Open the Scottland Settings (layout, goo and Window mode).
hooks="${SCOTTLAND_HOOKS:-/usr/lib/scottland}"
# The session's own copy (its helpers folder: the dev install, a test session's checkout), else
# the package's.
app=/usr/share/scottland/settings
[ -d "$hooks/settings" ] && app="$hooks/settings"
SCOTTLAND_CTL="$hooks/libexec/scottland-ctl" \
SCOTTLAND_LAYOUT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/scottland/layout.ini" \
SCOTTLAND_SOLAR_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/scottland/solar.ini" \
  exec qs -n -p "$app"
