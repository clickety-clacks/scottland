#!/bin/sh
# Reload Scottland in place: load the current plugin build and config into the running session.
# Windows stay open. Use after updating or rebuilding Scottland; a session restart is only
# needed for changes to the launcher or session hooks.
#
# The plugin is copied to a fresh file each time: a library at the same path would be reused
# from memory, so Wayfire would keep running the old code.
#
#   scottland-reload [--display wayland-N]
#
# Runs inside the session's own environment wherever it's started from (a keybinding, another
# desktop's terminal, ssh, an agent): it re-executes itself through scottland-exec, which uses
# the environment the session recorded at startup. The caller's environment is never used, so a
# shell belonging to Hyprland can't leak Hyprland's variables into Scottland's helpers.
set -eu
dev="${XDG_DATA_HOME:-$HOME/.local/share}/scottland/dev"
if [ -z "${SCOTTLAND_EXEC:-}" ]; then
  for exe in "$dev/libexec/scottland-exec" /usr/lib/scottland/libexec/scottland-exec; do
    [ -x "$exe" ] || continue
    if [ -n "$("$exe" --list)" ]; then
      exec "$exe" "$@" -- "$0"
    fi
    break
  done
  # Sessions started before scottland-exec existed recorded no environment: only a caller
  # inside the session (the keybinding) has the right one.
  echo "scottland-reload: this session predates scottland-exec; using the caller's environment" >&2
fi
runtime="${SCOTTLAND_SESSION_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/scottland}"
hooks="${SCOTTLAND_HOOKS:-/usr/lib/scottland}"
[ -n "${WAYFIRE_SOCKET:-}" ] || { echo "scottland-reload: no running Scottland session found" >&2; exit 1; }

# Keep services and later activations on this session's environment after a reload. The hook
# retains another desktop's environment when that desktop owns the shared user manager.
/bin/sh "$hooks/autostart.d/05-import-environment"

source_plugin=/usr/lib/wayfire/libscottland.so
[ -e "$dev/plugins/libscottland.so" ] && source_plugin="$dev/plugins/libscottland.so"

mkdir -p "$runtime/plugins"
fresh="$runtime/plugins/libscottland-$(date +%s%N).so"
cp -L "$source_plugin" "$fresh"
previous=$(cat "$runtime/plugins/current" 2>/dev/null || true)
echo "$fresh" >"$runtime/plugins/current"

# Rewrite the config (new settings take their saved values; the plugin list names the fresh
# copy), register any new settings, then swap the plugin. The plugin list is also set over IPC:
# values set over IPC (e.g. by the settings app) take precedence over the file.
"$hooks/libexec/scottland-build-config" >/dev/null
# Widgets stay through a reload: the outgoing plugin sees this mark and hands them over.
reloading="$runtime/${WAYLAND_DISPLAY:-wayland}.reloading"
touch "$reloading"
trap 'rm -f "$reloading"' EXIT
python3 - "$WAYFIRE_SOCKET" "$fresh" "$runtime/wayfire.ini" <<'PY'
import json, re, socket, struct, sys, time
sock = socket.socket(socket.AF_UNIX); sock.connect(sys.argv[1])
def call(method, data=None):
    body = json.dumps({"method": method, "data": data or {}}).encode()
    sock.sendall(struct.pack("<I", len(body)) + body)
    size = struct.unpack("<I", sock.recv(4))[0]; reply = b""
    while len(reply) < size: reply += sock.recv(size - len(reply))
    return json.loads(reply)
call("wayfire/reload-config-metadata")
# The plugin list comes from the rebuilt config, so a reload also adds and removes plugins.
config = open(sys.argv[3]).read()
match = re.search(r"(?ms)^plugins\s*=\s*((?:[^\n]*\\\n)*[^\n]*)", config)
plugins = match.group(1).replace("\\\n", " ").split() if match else \
    call("wayfire/get-config-option", {"option": "core/plugins"})["value"].split()
plugins = [sys.argv[2] if p == "scottland" or "/libscottland-" in p else p for p in plugins]
reply = call("wayfire/set-config-options", {"core/plugins": " ".join(plugins)})
if reply.get("error"): sys.exit(f"scottland-reload: {reply['error']}")
time.sleep(1)
PY
rm -f "$reloading"

# Old copies are no longer loaded.
for old in "$runtime"/plugins/libscottland-*.so; do
  [ "$old" = "$fresh" ] || rm -f "$old"
done
[ -n "$previous" ] && rm -f "$previous"
# Integrations restart their own session helpers (reload.d/*, e.g. the adapter's Lua host).
for hook in "$hooks"/reload.d/*; do
  [ -f "$hook" ] && [ -x "$hook" ] && "$hook"
done

command -v notify-send >/dev/null && notify-send -a Scottland "Scottland reloaded" "Plugin and config reloaded in place." || true
echo "reloaded from $source_plugin"
