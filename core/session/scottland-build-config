#!/bin/sh
# Assemble the Wayfire config a Scottland session runs: the base config followed by fragments
# printed by integration generators in config.d/ (e.g. shortcuts imported from another desktop).
# Prints the path of the assembled file. With --watch-paths, prints the paths its inputs come from.
# With --output FILE, writes FILE instead of the session's config (for test sessions), naming the
# plugin plainly rather than the running session's reload copy. A test session sets
# SCOTTLAND_CONFIG_OUTPUT (its own config file) and SCOTTLAND_CONFIG_EDIT (a sed script with its
# edits), so rebuilds started inside it write its config, never the machine's live one.
hooks=${SCOTTLAND_HOOKS:-/usr/lib/scottland}
base="${XDG_CONFIG_HOME:-$HOME/.config}/scottland/scottland.ini"
[ -f "$base" ] || base=/usr/share/scottland/scottland.ini

if [ "${1:-}" = --watch-paths ]; then
  echo "$base"
  for generator in "$hooks"/config.d/*; do
    [ -f "$generator" ] && [ -x "$generator" ] && "$generator" --watch-paths
  done
  exit 0
fi

dir="${SCOTTLAND_SESSION_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/scottland}"
out="$dir/wayfire.ini"
test_output=
if [ -n "${SCOTTLAND_CONFIG_OUTPUT:-}" ]; then
  out=$SCOTTLAND_CONFIG_OUTPUT
  test_output=1
fi
if [ "${1:-}" = --output ] && [ -n "${2:-}" ]; then
  out=$2
  test_output=1
fi
mkdir -p "$dir"
# One build at a time: the config watcher and scottland-reload can both rebuild at once (e.g. right
# after an install), and an interleaved pair once left the session's config empty, which Wayfire
# loaded as all defaults. Each build has its own temporary file, and an empty one never lands.
exec 9>"$dir/build-config.lock"
flock 9
new=$(mktemp "$out.XXXXXX")
trap 'rm -f "$new"' EXIT
failed=
{
  # All supported bases (including the user's own) keep their density after the rename.
  sed 's/^[[:space:]]*goo_dye_strength\([[:space:]]*=\)/goo_dye_density\1/' "$base"
  for generator in "$hooks"/config.d/*; do
    { [ -f "$generator" ] && [ -x "$generator" ]; } || continue
    printf '\n# ---- generated by %s\n' "$(basename "$generator")"
    if ! "$generator" "$base"; then
      printf '# (generator failed)\n'
      failed="$failed$(basename "$generator") "
    fi
  done
} >"$new"

[ -n "${SCOTTLAND_CONFIG_EDIT:-}" ] && sed -i -f "$SCOTTLAND_CONFIG_EDIT" "$new"

# Scale auto becomes each output's number here, before Wayfire reads it (scottland_output_scale.py).
if grep -Eq '^[[:space:]]*scale[[:space:]]*=[[:space:]]*auto[[:space:]]*(#|$)' "$new"; then
  python3 "$hooks/libexec/scottland_output_scale.py" "$new" ||
    echo 'scottland-build-config: scale auto not worked out; Wayfire keeps its default scale' >&2
fi

# After scottland-reload, load the plugin from the fresh copy it made (see scottland-reload).
current_plugin=$(cat "$dir/plugins/current" 2>/dev/null || true)
if [ -z "$test_output" ] && [ -n "$current_plugin" ] && [ -f "$current_plugin" ]; then
  sed -i "s#^  scottland \\\\\$#  $current_plugin \\\\#" "$new"
fi
if [ ! -s "$new" ]; then
  echo "scottland-build-config: the assembled config is empty; keeping $out" >&2
  exit 1
fi
# A generator that fails (e.g. a generator whose source no longer parses) must not cost the session
# the settings it generated before: keep the last config and fail. With no config yet (session
# start), use what was built without it, and still fail.
if [ -n "$failed" ] && [ -s "$out" ]; then
  echo "scottland-build-config: ${failed% } failed; keeping the previous $out" >&2
  exit 1
fi
# Write in place rather than rename: Wayfire watches this file and reloads it on change.
cat "$new" >"$out"
echo "$out"
if [ -n "$failed" ]; then
  echo "scottland-build-config: ${failed% } failed; started without its settings" >&2
  exit 1
fi
