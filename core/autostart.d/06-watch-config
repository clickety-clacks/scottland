#!/bin/sh
# Rebuild the session's config whenever one of its sources changes (the base config, or files a
# config.d generator reads). Wayfire notices the rewritten file and reloads it.
command -v inotifywait >/dev/null || exit 0
build="${SCOTTLAND_HOOKS:-/usr/lib/scottland}/libexec/scottland-build-config"
log="${XDG_STATE_HOME:-$HOME/.local/state}/scottland/watch-config.log"
session="${SCOTTLAND_SESSION_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/scottland}"
signature=${HYPRLAND_INSTANCE_SIGNATURE:-}
case "$signature" in
  *[!A-Za-z0-9_-]*|'') signature= ;;
esac
pause_file=
[ -n "$signature" ] && pause_file="$session/config-watch/$signature/autoreload-paused"
monitor_dir=
monitor_fifo=
monitor_pid=
poll_pid=
monitor_paths=
all_watch_paths=
last_logged_watch_state=
mkdir -p "$(dirname "$log")"
echo "$(date '+%F %T') watching (pid $$)" >>"$log"
record_watch_state() {
  state_mode=$1
  state_present=0
  state_missing=0
  state_mirror_dir=not-tracked
  # Keep paths private and summarize only the watcher mode and whether the mirror request
  # directory is among the paths that exist or are waiting to appear.
  for state_path in $all_watch_paths; do
    if [ -e "$state_path" ]; then
      state_present=$((state_present + 1))
    else
      state_missing=$((state_missing + 1))
    fi
    case "$state_path" in
      */display-mirror/*)
        if [ -d "$state_path" ]; then
          state_mirror_dir=present
        else
          state_mirror_dir=missing
        fi
        ;;
    esac
  done
  state_summary="$state_mode:$state_present:$state_missing:$state_mirror_dir"
  if [ "$state_summary" != "$last_logged_watch_state" ]; then
    echo "$(date '+%F %T') watch state: mode=$state_mode present=$state_present missing=$state_missing mirror-request-dir=$state_mirror_dir" >>"$log"
    last_logged_watch_state=$state_summary
  fi
}
stop_monitor() {
  if [ -n "$monitor_pid" ]; then
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
    monitor_pid=
  fi
  if [ -n "$poll_pid" ]; then
    kill "$poll_pid" 2>/dev/null || true
    wait "$poll_pid" 2>/dev/null || true
    poll_pid=
  fi
  exec 3<&- 2>/dev/null || true
  if [ -n "$monitor_dir" ]; then
    rm -rf -- "$monitor_dir"
  fi
  monitor_dir=
  monitor_fifo=
  monitor_paths=
}
start_monitor() {
  [ -n "$watch_paths" ] || return 1
  runtime=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
  monitor_dir=$(mktemp -d "$runtime/scottland-watch-config.XXXXXX") || return 1
  monitor_fifo=$monitor_dir/events
  if ! mkfifo "$monitor_fifo"; then
    rm -rf -- "$monitor_dir"
    monitor_dir=
    monitor_fifo=
    return 1
  fi
  # Keep inotifywait active while the parent rebuilds, so events during that rebuild are queued.
  # shellcheck disable=SC2086
  # Recursive monitor mode observes new directories internally; omit create from emitted events so
  # a new file's CREATE and CLOSE_WRITE do not cause two config rebuilds.
  inotifywait -q -r -m -e close_write -e moved_to -e delete -e delete_self -e move_self \
    --timefmt '%F %T' --format 'persistent %T %e %f' $watch_paths >"$monitor_fifo" 2>>"$log" &
  monitor_pid=$!
  monitor_paths=$watch_paths
  if ! exec 3<"$monitor_fifo"; then
    stop_monitor
    return 1
  fi
  # Keep watching the paths that exist while checking periodically for missing paths to appear.
  # The timer shares the event FIFO, so rebuilds never leave an event-listening gap.
  (
    poll_sleep=
    stop_poller() {
      if [ -n "$poll_sleep" ]; then
        kill "$poll_sleep" 2>/dev/null || true
        wait "$poll_sleep" 2>/dev/null || true
      fi
      exit 0
    }
    trap 'stop_poller' TERM INT HUP
    while :; do
      sleep 2 &
      poll_sleep=$!
      wait "$poll_sleep" || exit
      poll_sleep=
      printf 'poll\n' >"$monitor_fifo" || exit
    done
  ) &
  poll_pid=$!
  record_watch_state persistent
  return 0
}
refresh_watch_paths() {
  paths=$("$build" --watch-paths)
  all_watch_paths=$paths
  watch_paths=
  missing_paths=
  # The builder's path list has always used shell word splitting at the inotifywait boundary.
  # shellcheck disable=SC2086
  for path in $paths; do
    if [ -e "$path" ]; then
      watch_paths="$watch_paths $path"
    else
      missing_paths="$missing_paths $path"
    fi
  done
}
trap 'stop_monitor; echo "$(date "+%F %T") watcher stopped by signal" >>"$log"; exit 0' TERM INT HUP
while :; do
  refresh_watch_paths
  status=0
  event_description=
  if [ -n "$monitor_pid" ] && {
    [ "$monitor_paths" != "$watch_paths" ] || ! kill -0 "$monitor_pid" 2>/dev/null;
  }; then
    if [ "$monitor_paths" != "$watch_paths" ]; then
      event_description='watched input set changed'
    else
      echo "$(date '+%F %T') persistent config monitor exited; restarting" >>"$log"
    fi
    stop_monitor
  fi
  if [ -n "$watch_paths" ] && [ -z "$monitor_pid" ]; then
    if ! start_monitor; then
      echo "$(date '+%F %T') could not start the persistent config monitor; will retry after rebuilding" >>"$log"
    fi
  fi
  if [ -n "$monitor_pid" ]; then
    if [ -n "$event_description" ]; then
      :  # A changed watch-path set already requires a config rebuild.
    elif IFS= read -r event <&3; then
      if [ "$event" = poll ]; then
        path_appeared=0
        # shellcheck disable=SC2086
        for path in $missing_paths; do
          [ -e "$path" ] && path_appeared=1
        done
        if [ "$path_appeared" -ne 1 ]; then
          continue
        fi
        refresh_watch_paths
        if [ "$monitor_paths" != "$watch_paths" ]; then
          stop_monitor
          if [ -n "$watch_paths" ] && ! start_monitor; then
            echo "$(date '+%F %T') could not extend the config monitor after a watched path appeared" >>"$log"
          fi
        fi
        event_description='watched input appeared'
      else
        event_description=$event
        echo "$event" >>"$log"
        case "$event" in
          *DELETE_SELF*|*MOVE_SELF*)
            # Replacing a watched file invalidates its inode watch even when the path is unchanged.
            refresh_watch_paths
            stop_monitor
            if [ -n "$watch_paths" ] && ! start_monitor; then
              echo "$(date '+%F %T') could not restart the config monitor after a watched path moved" >>"$log"
            fi
            ;;
        esac
        if [ -n "$monitor_pid" ]; then
          old_monitor_paths=$monitor_paths
          refresh_watch_paths
          if [ "$old_monitor_paths" != "$watch_paths" ]; then
            stop_monitor
            if [ -n "$watch_paths" ] && ! start_monitor; then
              echo "$(date '+%F %T') could not restart the config monitor after a watched input changed" >>"$log"
            fi
          fi
        fi
      fi
    else
      wait "$monitor_pid"
      status=$?
      monitor_pid=
      stop_monitor
      [ "$status" -ne 0 ] || status=1
    fi
  else
    if [ -z "$watch_paths" ]; then
      record_watch_state waiting
      sleep 2
      refresh_watch_paths
      [ -n "$watch_paths" ] || continue
      if ! start_monitor; then
        echo "$(date '+%F %T') could not start the persistent config monitor after a watched path appeared" >>"$log"
      fi
      event_description='watched input appeared'
    else
      # Preserve config generation if the persistent monitor could not be created.
      # shellcheck disable=SC2086
      record_watch_state one-shot
      inotifywait -q -r -t 2 -e close_write -e moved_to -e create -e delete -e delete_self -e move_self --timefmt '%F %T' --format 'one-shot %T %e %f' --outfile "$log" $watch_paths 2>>"$log"
      status=$?
      if [ "$status" -eq 2 ]; then
        path_appeared=0
        # shellcheck disable=SC2086
        for path in $missing_paths; do
          [ -e "$path" ] && path_appeared=1
        done
        [ "$path_appeared" -eq 1 ] || continue
        event_description='watched input appeared'
      elif [ "$status" -eq 0 ]; then
        event_description='inotify event'
      fi
    fi
  fi
  if [ "$status" -ne 0 ]; then
    echo "$(date '+%F %T') inotifywait exited $status; retrying" >>"$log"
    sleep 2
    continue
  fi
  if [ -z "$monitor_pid" ]; then
    refresh_watch_paths
    if [ -z "$missing_paths" ] && ! start_monitor; then
      echo "$(date '+%F %T') could not start the persistent config monitor; will retry after rebuilding" >>"$log"
    fi
  fi
  if [ -z "$event_description" ]; then
    event_description='inotify event'
  fi
  if [ -n "$event_description" ]; then
    echo "$(date '+%F %T') config change observed ($event_description); rebuilding" >>"$log"
  else
    echo "$(date '+%F %T') config change observed; rebuilding" >>"$log"
  fi
  sleep 0.3  # let editors finish writing
  if [ -n "$pause_file" ] && [ -e "$pause_file" ]; then
    if [ -n "$event_description" ]; then
      echo "$(date '+%F %T') config change consumed while automatic reload is paused ($event_description)" >>"$log"
    else
      echo "$(date '+%F %T') config change consumed while automatic reload is paused" >>"$log"
    fi
    continue
  fi
  if "$build" >/dev/null 2>>"$log"; then
    echo "$(date '+%F %T') config rebuild succeeded after ($event_description)" >>"$log"
  else
    build_status=$?
    echo "$(date '+%F %T') config rebuild failed with status $build_status after ($event_description); the session keeps its previous config" >>"$log"
  fi
done
