#!/bin/sh
# Make Scottland's agent skills available to the user's coding-agent harnesses, the way other desktops
# link their own: a symlink in each harness's skills folder, for harnesses that are installed.
# Every skill in the skills folder is linked: Scottland's own, and any an installed integration
# put there beside it, so an integration's skill is linked only while that integration is
# installed. Links to a skill no longer provided (an integration removed, or the other of dev mode
# and the package) are removed; nothing else in the skills folders is touched.
src="${SCOTTLAND_HOOKS:-/usr/lib/scottland}/agents/skills"
[ -d "$src" ] || src=/usr/share/scottland/agents/skills
[ -d "$src" ] || exit 0
for harness in "$HOME/.claude" "$HOME/.codex" "$HOME/.agents" "$HOME/.pi/agent" "$HOME/.hermes" "$HOME"/.hermes/profiles/*; do
  [ -d "$harness" ] || continue
  mkdir -p "$harness/skills"
  for link in "$harness/skills"/*; do
    [ -L "$link" ] || continue
    target=$(readlink "$link")
    name=$(basename "$link")
    case $target in
      "${SCOTTLAND_HOOKS:-/usr/lib/scottland}/agents/skills/$name" | /usr/lib/scottland/agents/skills/"$name" | \
      /usr/share/scottland/agents/skills/"$name" | \
      "${XDG_DATA_HOME:-$HOME/.local/share}/scottland/dev/agents/skills/$name")
        [ -f "$src/$name/SKILL.md" ] || rm -f "$link" ;;
    esac
  done
  for skill in "$src"/*/; do
    [ -f "$skill/SKILL.md" ] || continue
    name=$(basename "$skill")
    ln -sfn "${skill%/}" "$harness/skills/$name"
  done
done
