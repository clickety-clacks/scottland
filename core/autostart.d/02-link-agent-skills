#!/bin/sh
# Make Scottland's agent skill available to the user's coding-agent harnesses, the way Omarchy
# links its own: a symlink in each harness's skills folder, for harnesses that are installed.
src="${SCOTTLAND_HOOKS:-/usr/lib/scottland}/agents/skills"
[ -d "$src" ] || src=/usr/share/scottland/agents/skills
[ -d "$src" ] || exit 0
for harness in "$HOME/.claude" "$HOME/.codex" "$HOME/.agents" "$HOME/.pi/agent" "$HOME/.hermes" "$HOME"/.hermes/profiles/*; do
  [ -d "$harness" ] || continue
  mkdir -p "$harness/skills"
  for skill in "$src"/*/; do
    [ -f "$skill/SKILL.md" ] || continue
    name=$(basename "$skill")
    target=${skill%/}
    link=$harness/skills/$name
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
      continue
    fi
    if [ -e "$link" ] || [ -L "$link" ]; then
      printf 'Scottland: keeping existing agent skill %s\n' "$link" >&2
      continue
    fi
    # -T treats a link to a directory as the destination itself. Without -f,
    # another login hook cannot make this command replace a user's skill.
    if ln -sT -- "$target" "$link" 2>/dev/null; then
      continue
    fi
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
      continue
    fi
    if [ -e "$link" ] || [ -L "$link" ]; then
      printf 'Scottland: keeping existing agent skill %s\n' "$link" >&2
      continue
    fi
    printf 'Scottland: could not link agent skill %s\n' "$link" >&2
    exit 1
  done
done
