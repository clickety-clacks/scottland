#!/bin/sh
# Give user services (systemd, D-Bus activation) this session's display. When another desktop
# runs alongside, keep its environment; after a relog, the manager can still point at Scottland
# even while the previous Scottland login session remains listed.
me=${XDG_SESSION_ID:-}
others=0
for id in $(loginctl list-sessions --no-legend | awk -v u="$(id -un)" '$3 == u {print $1}'); do
  [ "$id" = "$me" ] && continue
  type=$(loginctl show-session "$id" -p Type --value)
  state=$(loginctl show-session "$id" -p State --value)
  case $type in wayland|x11) [ "$state" != closing ] && others=$((others + 1)) ;; esac
done
if [ "$others" -gt 0 ]; then
  manager_environment=$(systemctl --user show-environment)
  manager_desktop=$(printf '%s\n' "$manager_environment" |
    sed -n 's/^XDG_SESSION_DESKTOP=//p')
  manager_current_desktop=$(printf '%s\n' "$manager_environment" |
    sed -n 's/^XDG_CURRENT_DESKTOP=//p')
  # XDG_SESSION_DESKTOP can be stale when bare Hyprland takes over the manager.
  [ -n "${XDG_SESSION_DESKTOP:-}" ] &&
    [ "$manager_desktop" = "$XDG_SESSION_DESKTOP" ] &&
    [ -n "${XDG_CURRENT_DESKTOP:-}" ] &&
    [ "$manager_current_desktop" = "$XDG_CURRENT_DESKTOP" ] || exit 0
fi

start_session_watch() {
  # A failed environment refresh must not leave the session without its normal stop watcher.
  if [ -n "${SCOTTLAND_SESSION_PID:-}" ]; then
    systemctl --user start "scottland-session-watch@$SCOTTLAND_SESSION_PID.service"
  else
    systemctl --user start scottland-session.target
  fi
}

# Only login startup may restart portals that were already running before the first working
# import. An in-place reload imports the current values but leaves every already-running service
# alone, as required by the reload ruling.
restart_preimport_portals=0
case "${1:-}" in
  --login) restart_preimport_portals=1; shift ;;
  '') ;;
  *)
    echo "scottland: unsupported session environment import mode" >&2
    start_session_watch
    exit 1
    ;;
esac
if [ "$#" -ne 0 ]; then
  echo "scottland: unexpected arguments to session environment importer" >&2
  start_session_watch
  exit 1
fi

portal_units=
if [ "$restart_preimport_portals" -eq 1 ]; then
  # The user manager persists across Scottland logins. A portal already started here can still
  # hold the previous session's environment, so remember only pre-import portals that are running
  # or transitioning. Failed portal units are deliberately left alone: restarting one cannot
  # recover it and is not part of the session environment handoff.
  portal_units=$(systemctl --user list-units --all --type=service \
    --no-legend 'xdg-desktop-portal*.service') || {
    echo "scottland: could not inspect portal services before importing the session environment" >&2
    start_session_watch
    exit 1
  }
  portal_units=$(printf '%s\n' "$portal_units" |
    awk '{
      unit = $1
      state = $3
      if ($1 == "●") {
        unit = $2
        state = $4
      }
      if (state == "active" || state == "activating" || state == "deactivating") print unit
    }')
fi

# Integrations add variable names through SCOTTLAND_IMPORT_ENV (see session-env.d). Some adapters
# repeat a core name such as XCURSOR_SIZE. systemd rejects the entire batch when a name repeats, so
# pass each configured, currently-set variable once. The names are validated before eval so the
# shell can distinguish an unset variable from one set to an empty value without importing values
# into a new environment or requiring an indirect-expansion extension.
import_candidates="WAYLAND_DISPLAY DISPLAY XAUTHORITY WAYFIRE_SOCKET XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP XCURSOR_SIZE ${SCOTTLAND_IMPORT_ENV:-}"
seen_import_names=' '
import_names=
set -f
for name in $import_candidates; do
  case "$name" in
    ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) continue ;;
  esac
  case "$seen_import_names" in *" $name "*) continue ;; esac
  eval "is_set=\${$name+x}"
  [ "$is_set" = x ] || continue
  seen_import_names="${seen_import_names}${name} "
  import_names="${import_names}${name} "
done
set -- $import_names
if [ "$#" -eq 0 ]; then
  echo "scottland: no configured session environment variables are set; not importing" >&2
  start_session_watch
  exit 1
fi

# Update systemd directly, then D-Bus activation as well. A rejected systemd batch is logged and
# reported to the autostart coordinator; there is no retry because the rejection must remain
# visible to the session log.
systemctl --user import-environment "$@" || {
  echo "scottland: systemd user manager rejected the live session environment" >&2
  start_session_watch
  exit 1
}
dbus-update-activation-environment "$@" || {
  echo "scottland: D-Bus activation rejected the live session environment" >&2
  start_session_watch
  exit 1
}

# Restart only portal services that predated the successful import. Other user services keep the
# reload ruling: they retain their startup environment until restarted normally.
for portal in $portal_units; do
  systemctl --user restart "$portal" || {
    echo "scottland: could not restart portal service $portal after importing the session environment" >&2
    start_session_watch
    exit 1
  }
done

# Start the user's graphical-session services with Scottland. The watcher stops them again when
# this session's launcher goes away, however the session ends.
start_session_watch
