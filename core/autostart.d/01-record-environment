#!/bin/sh
# Record this session's environment (what Wayfire gives its children: WAYLAND_DISPLAY,
# WAYFIRE_SOCKET, SCOTTLAND_HOOKS, integration variables...) so scottland-exec can run commands
# in this session from anywhere, with exactly this environment instead of the caller's.
runtime_base=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
runtime="${SCOTTLAND_SESSION_DIR:-$runtime_base/scottland}"
file="$runtime/${WAYLAND_DISPLAY:-wayland}.env"
umask 077
if [ -n "${SCOTTLAND_HEADLESS_OWNER:-}" ]; then
    case $SCOTTLAND_HEADLESS_OWNER in *[!0-9a-f-]*|'') exit 73 ;; esac
    [ "${#SCOTTLAND_HEADLESS_OWNER}" -eq 36 ] || exit 73
    owner_dir=${SCOTTLAND_HEADLESS_OWNER_DIR:-}
    [ -n "$owner_dir" ] && [ -d "$owner_dir" ] && [ ! -L "$owner_dir" ] || exit 73
    [ -d "$runtime_base" ] && [ ! -L "$runtime_base" ] || exit 73
    [ ! -L "$runtime" ] || exit 73
    mkdir -p "$runtime"
    [ -d "$runtime" ] && [ ! -L "$runtime" ] || exit 73
    temporary="$file.$SCOTTLAND_HEADLESS_OWNER.tmp"
    # Reserve the final name without replacing a stale session record. A unique temporary
    # name plus a hard link makes publication atomic and fails if another session owns it.
    if ! (set -C; env -0 >"$temporary"); then
        echo "headless session record already exists: $file" >&2
        exit 73
    fi
    if ! ln "$temporary" "$file"; then
        rm -f "$temporary"
        echo "headless session record already exists: $file" >&2
        exit 73
    fi
    rm -f "$temporary"
else
    mkdir -p "$runtime"
    env -0 >"$file.tmp" && mv "$file.tmp" "$file"
fi
